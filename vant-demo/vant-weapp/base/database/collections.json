{
  "collections": [
    {
      "name": "users",
      "description": "用户基本信息集合",
      "indexes": [
        {
          "keys": { "openid": 1 },
          "options": { "unique": true }
        },
        {
          "keys": { "role": 1 }
        }
      ]
    },
    {
      "name": "experts",
      "description": "专家信息集合",
      "indexes": [
        {
          "keys": { "name": 1 }
        },
        {
          "keys": { "department": 1 }
        }
      ]
    },
    {
      "name": "schedules",
      "description": "会议议程集合",
      "indexes": [
        {
          "keys": { "start_time": 1 }
        },
        {
          "keys": { "speaker_id": 1 }
        },
        {
          "keys": { "category": 1 }
        },
        {
          "keys": { "is_featured": 1 }
        }
      ]
    },
    {
      "name": "departments",
      "description": "义诊科室集合",
      "indexes": [
        {
          "keys": { "name": 1 }
        },
        {
          "keys": { "is_active": 1 }
        }
      ]
    },
    {
      "name": "appointments",
      "description": "义诊预约集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "department_id": 1 }
        },
        {
          "keys": { "appointment_date": 1 }
        },
        {
          "keys": { "status": 1 }
        },
        {
          "keys": { "queue_number": 1 }
        }
      ]
    },
    {
      "name": "queues",
      "description": "排队状态集合",
      "indexes": [
        {
          "keys": { "appointment_id": 1 }
        },
        {
          "keys": { "department_id": 1, "queue_date": 1 }
        },
        {
          "keys": { "queue_number": 1 }
        },
        {
          "keys": { "status": 1 }
        }
      ]
    },
    {
      "name": "messages",
      "description": "消息通知集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "type": 1 }
        },
        {
          "keys": { "created_at": -1 }
        },
        {
          "keys": { "is_read": 1 }
        }
      ]
    },
    {
      "name": "favorites",
      "description": "用户收藏集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "item_id": 1, "item_type": 1 }
        },
        {
          "keys": { "user_id": 1, "item_id": 1, "item_type": 1 },
          "options": { "unique": true }
        }
      ]
    },
    {
      "name": "system_configs",
      "description": "系统配置集合",
      "indexes": [
        {
          "keys": { "config_key": 1 },
          "options": { "unique": true }
        }
      ]
    },
    {
      "name": "resources",
      "description": "文件资源集合",
      "indexes": [
        {
          "keys": { "category": 1 }
        },
        {
          "keys": { "file_type": 1 }
        },
        {
          "keys": { "is_public": 1 }
        }
      ]
    }
  ]
}