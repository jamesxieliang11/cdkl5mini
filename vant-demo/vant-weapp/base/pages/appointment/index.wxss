.appointment-container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.van-notice-bar {
  margin: 20rpx 40rpx;
  border-radius: 12rpx;
}

.my-appointment {
  margin: 30rpx 0;
}

.appointment-group {
  margin: 0 40rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.appointment-status {
  display: flex;
  align-items: center;
}

.appointment-actions {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: #f8f9fa;
}

.departments-section {
  margin: 30rpx 0;
}

.departments-group {
  margin: 0 40rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.department-item {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin: 10rpx;
}

.department-content {
  padding: 30rpx 20rpx;
  text-align: center;
}

.department-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin: 16rpx 0 12rpx;
}

.department-info {
  font-size: 24rpx;
  color: #646566;
}

.doctor-info {
  margin-bottom: 8rpx;
}

.time-info {
  margin-bottom: 12rpx;
}

.queue-info {
  display: flex;
  justify-content: center;
}

.notice-section,
.emergency-section,
.location-section {
  margin: 30rpx 0;
}

.notice-content {
  padding: 0 40rpx;
  background: white;
  margin: 0 40rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.notice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.notice-item .van-icon {
  margin-right: 12rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.emergency-group,
.location-group {
  margin: 0 40rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 科室特色样式 */
.department-item[data-department*="神经内科"] {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}

.department-item[data-department*="脑电图"] {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}

.department-item[data-department*="康复"] {
  background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
}

.department-item[data-department*="遗传"] {
  background: linear-gradient(135deg, #fff3e0 0%, #ffcc02 100%);
}

/* 分割线样式 */
.van-divider {
  margin: 40rpx 0 20rpx;
  font-size: 28rpx;
  color: #646566;
}

/* 单元格样式调整 */
.van-cell__title {
  font-weight: 500;
}

.van-cell__value {
  color: #323233;
}

.van-cell__label {
  color: #969799;
  font-size: 24rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .appointment-group,
  .departments-group,
  .emergency-group,
  .location-group {
    margin: 0 30rpx;
  }
  
  .notice-content {
    margin: 0 30rpx;
    padding: 25rpx;
  }
  
  .appointment-actions {
    padding: 25rpx;
    gap: 15rpx;
  }
  
  .department-content {
    padding: 25rpx 15rpx;
  }
}