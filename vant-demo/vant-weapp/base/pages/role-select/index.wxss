.role-select-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.role-list {
  margin-bottom: 60rpx;
}

.role-list .van-cell {
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.role-list .van-cell__title {
  font-size: 32rpx;
  font-weight: 600;
}

.role-list .van-cell__label {
  font-size: 24rpx;
  color: #969799;
  margin-top: 8rpx;
}

.footer {
  text-align: center;
}

.tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}