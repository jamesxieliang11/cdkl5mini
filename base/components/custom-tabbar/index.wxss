.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 130rpx; /* 适老化：增加导航栏高度 */
  background: #ffffff;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  border-top: 1rpx solid #eee;
  z-index: 9999;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  flex: 1;
  position: relative;
  padding-bottom: 20rpx;
  min-height: 110rpx; /* 适老化：增加最小高度，扩大点击区域 */
}

.center-item {
  position: relative;
  z-index: 10;
}

.tabbar-icon {
  width: 60rpx; /* 适老化：图标放大 */
  height: 60rpx;
  margin-bottom: 8rpx;
}

.center-button {
  width: 130rpx; /* 适老化：中央按钮放大 */
  height: 130rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8rpx 24rpx rgba(99, 102, 241, 0.4),
    0 4rpx 12rpx rgba(99, 102, 241, 0.3),
    0 0 0 6rpx rgba(255, 255, 255, 1);
  margin-bottom: 12rpx;
  border: 4rpx solid #ffffff;
}

.center-icon {
  width: 60rpx;
  height: 60rpx;
  filter: brightness(0) invert(1);
}

.center-icon-text {
  font-size: 68rpx; /* 适老化：中央图标放大 */
  color: #ffffff;
  font-weight: bold;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-text {
  font-size: 26rpx; /* 适老化：文字放大 */
  color: #999;
  line-height: 1;
}

.center-text {
  margin-top: 12rpx;
  font-size: 26rpx; /* 适老化：文字放大 */
}

.tabbar-text.active {
  color: #4338ca; /* 适老化：活跃态颜色加深，增强对比度 */
  font-weight: 600;
}

.center-item .tabbar-text.active {
  color: #4338ca; /* 适老化：活跃态颜色加深 */
}