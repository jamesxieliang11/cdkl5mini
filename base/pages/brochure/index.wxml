<!-- 自定义导航栏 -->
<view class="status-bar"></view>
<view class="nav-bar">
  <view class="nav-back" bindtap="goBack">
    <van-icon name="arrow-left" size="20" color="#333" />
  </view>
  <view class="nav-title">CDKL5 宣教手册</view>
  <view class="nav-right" wx:if="{{pages.length > 0}}" bindtap="downloadPDF">
    <van-icon name="down" size="18" color="#34BFA3" />
  </view>
  <view class="nav-placeholder" wx:else></view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading}}" class="center-container">
  <van-loading size="24px" type="spinner" color="#34BFA3">正在加载手册...</van-loading>
</view>

<!-- 转换中 -->
<view wx:elif="{{converting}}" class="center-container">
  <view class="converting-card">
    <van-loading size="24px" type="spinner" color="#34BFA3" />
    <text class="converting-title">首次打开，正在生成预览...</text>
    <text class="converting-hint">PDF 转换为图片中，仅需等待一次</text>
  </view>
</view>

<!-- 错误/兜底 -->
<view wx:elif="{{errorMsg}}" class="center-container">
  <view class="fallback-card">
    <view class="fallback-icon">📖</view>
    <view class="fallback-title">CDKL5 宣教手册</view>

    <view wx:if="{{errorMsg === 'convert_failed'}}">
      <view class="fallback-desc">预览生成失败，可能是首次加载超时</view>
      <van-button
        type="primary" round block
        color="#34BFA3"
        custom-style="margin-top: 32rpx;"
        bindtap="retryConvert"
      >重试生成预览</van-button>
      <van-button
        type="default" round block
        custom-style="margin-top: 16rpx;"
        bindtap="openPDFDirect"
      >直接打开 PDF</van-button>
    </view>

    <view wx:else>
      <view class="fallback-desc">加载失败，请检查网络后重试</view>
      <van-button
        type="primary" round block
        color="#34BFA3"
        custom-style="margin-top: 32rpx;"
        bindtap="openPDFDirect"
      >打开 PDF 手册</van-button>
    </view>
  </view>
</view>

<!-- 图片预览模式 -->
<view wx:else class="viewer-container">
  <scroll-view scroll-y class="pages-scroll" enhanced show-scrollbar="{{false}}">
    <view
      class="page-item"
      wx:for="{{pages}}"
      wx:key="pageNum"
      data-index="{{index}}"
      bindtap="previewPage"
    >
      <image
        class="page-image"
        src="{{item.url}}"
        mode="widthFix"
        lazy-load
        data-index="{{index}}"
        bindload="onPageImageLoad"
        show-menu-by-longpress
      />
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 页码 -->
  <view class="page-indicator">
    <text>{{currentPage}} / {{totalPages}}</text>
  </view>

  <!-- 底部栏 -->
  <view class="bottom-toolbar">
    <view class="toolbar-btn" bindtap="downloadPDF">
      <van-icon name="down" size="20" color="#666" />
      <text>下载PDF</text>
    </view>
    <view class="toolbar-divider"></view>
    <view class="toolbar-hint">
      <van-icon name="enlarge" size="16" color="#999" />
      <text>点击图片可放大查看</text>
    </view>
  </view>
</view>
