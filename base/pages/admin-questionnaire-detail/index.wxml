<!-- 工具函数模块 -->
<wxs src="./utils.wxs" module="utils" />

<!-- 问卷详情列表页 -->
<view class="page-header">
  <view class="header-row">
    <van-icon name="arrow-left" size="20" color="#fff" bindtap="onBack" />
    <text class="header-title">问卷数据详情</text>
    <view style="width: 40rpx;"></view>
  </view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading}}" class="loading-container">
  <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
</view>

<view class="stats-container" wx:if="{{!loading}}">

  <!-- ========== 统计摘要 ========== -->
  <view class="section-card" wx:if="{{stats}}">
    <view class="section-header">
      <van-icon name="chart-trending-o" size="18" color="#34BFA3" />
      <text class="section-title">统计摘要</text>
    </view>
    <view class="overview-grid">
      <view class="overview-item">
        <text class="overview-value primary">{{stats.totalUsers || 0}}</text>
        <text class="overview-label">总用户</text>
      </view>
      <view class="overview-item">
        <text class="overview-value success">{{stats.submittedCount || 0}}</text>
        <text class="overview-label">已提交</text>
      </view>
      <view class="overview-item">
        <text class="overview-value warning">{{stats.completionRate || 0}}%</text>
        <text class="overview-label">完成率</text>
      </view>
    </view>
    <!-- 完成进度条 -->
    <view class="rate-bar">
      <text class="rate-label">完成率</text>
      <view class="progress-wrapper">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.completionRate || 0}}%"></view>
        </view>
        <text class="rate-value">{{stats.completionRate || 0}}%</text>
      </view>
    </view>
  </view>

  <!-- ========== 性别分布 ========== -->
  <view class="section-card" wx:if="{{stats.genderDistribution}}">
    <view class="section-header">
      <text class="section-title">👫 性别分布</text>
    </view>
    <view class="bar-list">
      <view class="bar-item" wx:if="{{stats.genderDistribution.male !== undefined}}">
        <view class="bar-label">男</view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{stats.submittedCount > 0 ? stats.genderDistribution.male / stats.submittedCount * 100 : 0}}%; background: linear-gradient(90deg, #1989fa, #1565c0);"></view>
        </view>
        <view class="bar-count">{{stats.genderDistribution.male || 0}}人 ({{utils.percent(stats.genderDistribution.male, stats.submittedCount)}}%)</view>
      </view>
      <view class="bar-item" wx:if="{{stats.genderDistribution.female !== undefined}}">
        <view class="bar-label">女</view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{stats.submittedCount > 0 ? stats.genderDistribution.female / stats.submittedCount * 100 : 0}}%; background: linear-gradient(90deg, #ee0a24, #c41d7f);"></view>
        </view>
        <view class="bar-count">{{stats.genderDistribution.female || 0}}人 ({{utils.percent(stats.genderDistribution.female, stats.submittedCount)}}%)</view>
      </view>
      <view class="bar-item" wx:if="{{stats.genderDistribution.unknown !== undefined}}">
        <view class="bar-label">未知</view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{stats.submittedCount > 0 ? stats.genderDistribution.unknown / stats.submittedCount * 100 : 0}}%; background: #999;"></view>
        </view>
        <view class="bar-count">{{stats.genderDistribution.unknown || 0}}人</view>
      </view>
    </view>
  </view>

  <!-- ========== 地区分布 TOP10 ========== -->
  <view class="section-card" wx:if="{{stats.regionTop10.length > 0}}">
    <view class="section-header">
      <text class="section-title">🌍 地区分布 TOP10</text>
    </view>
    <view class="ranking-list">
      <view class="ranking-item" wx:for="{{stats.regionTop10}}" wx:key="region" wx:if="{{index < 10}}">
        <view class="ranking-left">
          <view class="ranking-index">{{index + 1}}</view>
          <view class="ranking-name">{{item.region || '未知'}}</view>
        </view>
        <view class="ranking-right">
          <view class="mini-bar-wrapper">
            <view class="mini-bar" style="width: {{stats.regionTop10[0].count > 0 ? item.count / stats.regionTop10[0].count * 100 : 0}}%;"></view>
          </view>
          <view class="ranking-count">{{item.count}}人</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 诊断年龄分布 ========== -->
  <view class="section-card" wx:if="{{stats.diagnosisAgeDistribution}}">
    <view class="section-header">
      <text class="section-title">🎂 诊断年龄分布</text>
    </view>
    <view class="bar-list">
      <view class="bar-item" wx:for="{{stats.diagnosisAgeDistribution}}" wx:for-index="key" wx:for-item="val" wx:key="key">
        <view class="bar-label">{{key}}</view>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{stats.submittedCount > 0 ? val / stats.submittedCount * 100 : 0}}%; background: linear-gradient(90deg, #34BFA3, #2da88e);"></view>
        </view>
        <view class="bar-count">{{val}}人</view>
      </view>
    </view>
  </view>

  <!-- ========== 癫痫控制状态分布 ========== -->
  <view class="section-card" wx:if="{{stats.seizureControlDistribution}}">
    <view class="section-header">
      <text class="section-title">⚡ 癫痫控制状态</text>
    </view>
    <view class="bar-list">
      <view class="bar-item" wx:for="{{stats.seizureControlDistribution}}" wx:for-index="key" wx:for-item="val" wx:key="key">
        <view class="bar-label">{{key}}</view>
        <view class="bar-track">
          <view class="bar-fill seizure-control-bar" style="width: {{stats.submittedCount > 0 ? val / stats.submittedCount * 100 : 0}}%;"></view>
        </view>
        <view class="bar-count">{{val}}人 ({{utils.percent(val, stats.submittedCount)}}%)</view>
      </view>
    </view>
  </view>

  <!-- ========== 已提交问卷列表 ========== -->
  <view class="section-card">
    <view class="section-header">
      <van-icon name="friends-o" size="18" color="#9C27B0" />
      <text class="section-title">已提交问卷列表</text>
      <van-tag type="primary" size="medium">{{questionnaires.length}}份</van-tag>
    </view>

    <view wx:if="{{questionnaires.length === 0}}" class="empty-hint">暂无问卷数据</view>

    <view wx:else class="detail-list">
      <view class="detail-item" wx:for="{{questionnaires}}" wx:key="index">
        <view class="detail-header">
          <text class="detail-name">{{item.child_name || item.childName || '未填写'}}</text>
          <view class="detail-header-tags">
            <van-tag wx:if="{{item.openid}}" type="success" size="small">已绑定</van-tag>
            <van-tag wx:else type="warning" size="small" bindtap="onOpenBind" data-id="{{item._id}}" data-name="{{item.child_name}}">未绑定 · 点击绑定</van-tag>
          </view>
        </view>
        <view class="detail-body">
          <view class="detail-info">
            <text class="detail-info-item" wx:if="{{item.region}}">📍 {{item.region}}</text>
            <text class="detail-info-item" wx:if="{{item.diagnosis_age || item.diagnosisAge}}">🎂 诊断年龄: {{item.diagnosis_age || item.diagnosisAge || '未知'}}</text>
          </view>
          <view class="detail-info" wx:if="{{item.seizure_control || item.seizureControl || item.child_gender}}">
            <text class="detail-info-item" wx:if="{{item.child_gender}}">👤 {{item.child_gender}}</text>
            <text class="detail-info-item" wx:if="{{item.seizure_control || item.seizureControl}}">⚡ {{item.seizure_control || item.seizureControl}}</text>
          </view>
          <view class="detail-info" wx:if="{{item.parent_contact}}">
            <text class="detail-info-item">📱 {{item.parent_contact}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

</view>

<!-- ==================== 管理员绑定弹窗 ==================== -->
<van-dialog
  use-slot
  show="{{showBindDialog}}"
  title="绑定用户 - {{bindTargetName}}"
  show-cancel-button
  confirm-button-text="确认绑定"
  cancel-button-text="取消"
  confirm-button-color="#34BFA3"
  bind:confirm="onConfirmBind"
  bind:cancel="onCloseBind"
  bind:close="onCloseBind"
>
  <view class="bind-dialog-content">
    <view class="bind-dialog-hint">请输入要绑定的用户 openid（可在用户管理中查看）</view>
    <van-field
      value="{{bindOpenid}}"
      label="openid"
      placeholder="必填"
      required
      bind:input="onBindOpenidInput"
    />
    <van-field
      value="{{bindUserId}}"
      label="userId"
      placeholder="选填"
      bind:input="onBindUserIdInput"
    />
  </view>
</van-dialog>
