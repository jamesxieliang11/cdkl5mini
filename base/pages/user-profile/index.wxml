<!-- 自定义导航栏 -->
<van-nav-bar
  title="我的"
  custom-class="custom-nav-bar"
/>

<!--用户信息完善页面-->
<view class="container">
  <view class="header">
    <text class="title">{{isEdit ? '编辑' : '完善'}}用户信息</text>
    <text class="subtitle">请填写宝宝和家长的基本信息</text>
  </view>

  <!-- ==================== 我的宝宝管理（仅本地和正式环境显示） ==================== -->
  <view class="section baby-section" wx:if="{{isProd}}">
    <view class="section-title">
      <van-icon name="like-o" color="#34BFA3" />
      <text>我的宝宝</text>
      <text class="section-subtitle">（问卷认领绑定）</text>
    </view>

    <!-- 已绑定的宝宝列表 -->
    <view class="baby-list" wx:if="{{boundList.length > 0}}">
      <view class="baby-card" wx:for="{{boundList}}" wx:key="_id">
        <view class="baby-card-main" data-id="{{item._id}}" bindtap="onViewQuestionnaire">
          <view class="baby-card-name">
            👶 {{item.child_name}}
            <van-tag type="success" size="mini" wx:if="{{item.child_gender}}">{{item.child_gender}}</van-tag>
          </view>
          <view class="baby-card-info">出生日期：{{item.birth_date || '未记录'}}</view>
          <view class="baby-card-info">地区：{{item.region || '未记录'}}</view>
          <view class="baby-card-tip">点击查看/编辑问卷 →</view>
        </view>
        <view class="baby-card-unbind" data-id="{{item._id}}" data-name="{{item.child_name}}" catchtap="onUnbindChild">
          <van-icon name="close" size="16" color="#ee0a24" />
          <text class="unbind-text">解绑</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="baby-empty" wx:if="{{!boundLoading && boundList.length === 0}}">
      <van-icon name="search" size="48" color="#ddd" />
      <text class="baby-empty-text">暂未绑定宝宝问卷</text>
      <text class="baby-empty-hint">如果您之前已填写过问卷，可以通过手机号认领</text>
    </view>

    <!-- 加载中 -->
    <view class="baby-loading" wx:if="{{boundLoading}}">
      <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
    </view>

    <!-- 操作按钮 -->
    <view class="baby-actions">
      <van-button
        type="primary"
        color="#34BFA3"
        size="small"
        plain
        icon="plus"
        bindtap="onShowClaimPanel"
      >认领宝宝问卷</van-button>
      <van-button
        type="default"
        size="small"
        icon="edit"
        bindtap="goToQuestionnaire"
      >填写新问卷</van-button>
    </view>
  </view>

  <!-- ==================== 认领弹窗 ==================== -->
  <van-popup show="{{showClaimPanel}}" position="bottom" round closeable bind:close="onCloseClaimPanel" custom-style="max-height: 75vh; padding-bottom: env(safe-area-inset-bottom);">
    <view class="claim-popup">
      <view class="claim-popup-title">🔗 认领宝宝问卷</view>
      <view class="claim-popup-hint">输入登记时的手机号查找并认领</view>

      <view class="claim-search-row">
        <van-field
          value="{{claimPhone}}"
          placeholder="请输入手机号"
          type="tel"
          bind:input="onClaimPhoneInput"
          custom-style="flex: 1;"
        />
        <van-button
          type="primary"
          size="small"
          color="#34BFA3"
          loading="{{claimSearching}}"
          disabled="{{!claimPhone || claimPhone.length < 6}}"
          bindtap="onSearchByPhone"
          custom-style="margin-left: 16rpx;"
        >搜索</van-button>
      </view>

      <!-- 搜索结果 -->
      <view class="claim-result-list" wx:if="{{claimResults.length > 0}}">
        <view class="claim-result-tip">找到 {{claimResults.length}} 条记录，请确认您的宝宝：</view>
        <view
          class="claim-result-card {{claimSelectedId === item._id ? 'claim-result-card-selected' : ''}}"
          wx:for="{{claimResults}}"
          wx:key="_id"
          data-id="{{item._id}}"
          data-name="{{item.child_name}}"
          data-birth="{{item.birth_date}}"
          bindtap="onSelectClaimCard"
        >
          <view class="claim-result-name">👶 {{item.child_name}}</view>
          <view class="claim-result-info">出生：{{item.birth_date || '未记录'}} · {{item.child_gender || '未记录'}} · {{item.region || '未记录'}}</view>
          <view class="claim-result-info">微信群昵称：{{item.wechat_group_nickname || '未记录'}}</view>
          <van-icon wx:if="{{claimSelectedId === item._id}}" name="checked" color="#34BFA3" size="24" class="claim-check-icon" />
        </view>

        <van-button
          type="primary"
          color="#34BFA3"
          block
          loading="{{claimBinding}}"
          disabled="{{!claimSelectedId}}"
          custom-style="margin-top: 24rpx;"
          bindtap="onConfirmClaim"
        >确认认领</van-button>
      </view>

      <!-- 无结果 -->
      <view class="claim-empty-result" wx:if="{{claimSearched && claimResults.length === 0}}">
        <van-icon name="search" size="48" color="#ccc" />
        <text class="claim-empty-text">未找到匹配的记录</text>
        <text class="claim-empty-hint">可能手机号有误，或信息尚未录入</text>
      </view>
    </view>
  </van-popup>

  <form bindsubmit="submitForm">
    <!-- 宝宝信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="user-o" />
        <text>宝宝信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.babyName}}"
          label="宝宝姓名"
          placeholder="请输入宝宝姓名"
          required
          bind:input="onBabyNameInput"
        />
        
        <picker
          mode="date"
          value="{{patientInfo.babyBirthday}}"
          end="{{currentDate}}"
          bind:change="onBabyBirthdayChange"
        >
          <van-cell
            title="宝宝生日"
            value="{{patientInfo.babyBirthday || '请选择宝宝生日'}}"
            is-link
            required
          />
        </picker>
        
        <van-field
          value="{{patientInfo.weight}}"
          label="体重(kg)"
          placeholder="请输入宝宝体重"
          type="digit"
          bind:input="onWeightInput"
        />
      </van-cell-group>
    </view>

    <!-- 家长信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="friends-o" />
        <text>家长信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.parentName}}"
          label="家长姓名"
          placeholder="请输入家长姓名"
          required
          bind:input="onParentNameInput"
        />
        
        <van-field
          wx:if="{{isProd}}"
          value="{{patientInfo.parentPhone}}"
          label="联系电话"
          placeholder="请输入手机号码"
          type="number"
          required
          bind:input="onParentPhoneInput"
        />
        
        <picker
          range="{{relationshipOptions}}"
          value="{{relationshipIndex}}"
          bind:change="onRelationshipChange"
        >
          <van-cell
            title="与宝宝关系"
            value="{{patientInfo.relationship}}"
            is-link
          />
        </picker>
      </van-cell-group>
    </view>

    <!-- 医疗信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="medical-o" />
        <text>医疗信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.medicalHistory}}"
          label="病史描述"
          type="textarea"
          placeholder="请简要描述宝宝的病史、症状等（选填）"
          autosize
          bind:change="onMedicalHistoryInput"
        />
        
        <van-field
          value="{{patientInfo.notes}}"
          label="备注信息"
          type="textarea"
          placeholder="其他需要说明的信息（选填）"
          autosize
          bind:change="onNotesInput"
        />
      </van-cell-group>
    </view>

    <!-- 病历文件 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="description" />
        <text>病历文件</text>
        <text class="section-subtitle">（选填，支持PDF、Word、图片格式）</text>
      </view>
      
      <view class="file-upload">
        <van-button
          type="default"
          size="small"
          icon="plus"
          bind:click="uploadMedicalFile"
        >
          上传病历
        </van-button>
      </view>
      
      <view class="file-list" wx:if="{{medicalFiles.length > 0}}">
        <view 
          class="file-item" 
          wx:for="{{medicalFiles}}" 
          wx:key="fileID"
        >
          <view class="file-info" bind:tap="previewFile" data-fileid="{{item.fileID}}" data-filename="{{item.name}}">
            <van-icon name="description" class="file-icon" />
            <view class="file-details">
              <text class="file-name">{{item.name}}</text>
              <text class="file-size">{{item.formattedSize}}</text>
            </view>
          </view>
          <van-icon 
            name="delete" 
            class="delete-icon" 
            bind:tap="deleteFile" 
            data-index="{{index}}"
          />
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <van-button
        type="primary"
        size="large"
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:click="submitForm"
      >
        {{loading ? '保存中...' : '保存信息'}}
      </van-button>

      <van-button
        wx:if="{{!isEdit}}"
        type="default"
        size="large"
        bind:click="skipProfile"
        class="skip-btn"
      >
        暂时跳过
      </van-button>
    </view>
  </form>

  <!-- 我的数据 -->
  <view class="stats-card" wx:if="{{statsLoaded}}">
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value">{{statsTotalDays}}</text>
        <text class="stats-label">记录天数</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">{{statsStreak}}</text>
        <text class="stats-label">连续打卡</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">{{statsTotalRecords}}</text>
        <text class="stats-label">总记录</text>
      </view>
    </view>
    <view class="stats-achievements" wx:if="{{statsAchievements.length > 0}}">
      <view class="achievement-tag" wx:for="{{statsAchievements}}" wx:key="key">
        <text>{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
    <view class="stats-share-btn">
      <van-button size="small" plain color="#34BFA3" icon="share-o" bindtap="onShareStats">分享我的数据</van-button>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="section-title">
      <van-icon name="apps-o" />
      <text>功能入口</text>
    </view>
    <view class="menu-card" bindtap="goToReports">
      <view class="ds-icon-wrap" style="background:linear-gradient(135deg,#9C27B0,#BA68C8)">
        <van-icon name="bar-chart-o" size="24px" color="#fff" />
      </view>
      <view class="menu-info">
        <text class="menu-name">我的报告</text>
        <text class="menu-desc">查看记录统计与趋势</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view class="menu-card" bindtap="goToFeedback">
      <view class="ds-icon-wrap" style="background:linear-gradient(135deg,#FF9800,#FFB74D)">
        <van-icon name="smile-comment-o" size="24px" color="#fff" />
      </view>
      <view class="menu-info">
        <text class="menu-name">反馈意见</text>
        <text class="menu-desc">帮助我们改进产品</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view wx:if="{{isAdmin}}" class="menu-card" bindtap="goToAdmin">
      <view class="ds-icon-wrap" style="background:linear-gradient(135deg,#FF5722,#FF8A65)">
        <van-icon name="setting-o" size="24px" color="#fff" />
      </view>
      <view class="menu-info">
        <text class="menu-name">管理面板</text>
        <text class="menu-desc">数据统计与系统配置</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>
</view>

<!-- 统计海报 -->
<share-poster
  wx:if="{{showStatsPoster}}"
  type="stats"
  post-data="{{statsPosterData}}"
  bind:close="onStatsPosterClose"
  bind:saved="onStatsPosterSaved"
/>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />