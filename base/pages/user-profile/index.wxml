<!-- 自定义导航栏 -->
<van-nav-bar
  title="{{isEdit ? '编辑用户信息' : '完善用户信息'}}"
  left-arrow
  bind:click-left="onBack"
  custom-class="custom-nav-bar"
/>

<!--用户信息完善页面-->
<view class="container">
  <view class="header">
    <text class="title">{{isEdit ? '编辑' : '完善'}}用户信息</text>
    <text class="subtitle">请填写宝宝和家长的基本信息</text>
  </view>

  <form bindsubmit="submitForm">
    <!-- 宝宝信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="user-o" />
        <text>宝宝信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.babyName}}"
          label="宝宝姓名"
          placeholder="请输入宝宝姓名"
          required
          bind:change="onBabyNameInput"
        />
        
        <picker
          mode="date"
          value="{{patientInfo.babyBirthday}}"
          end="{{currentDate}}"
          bind:change="onBabyBirthdayChange"
        >
          <van-cell
            title="宝宝生日"
            value="{{patientInfo.babyBirthday || '请选择宝宝生日'}}"
            is-link
            required
          />
        </picker>
      </van-cell-group>
    </view>

    <!-- 家长信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="friends-o" />
        <text>家长信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.parentName}}"
          label="家长姓名"
          placeholder="请输入家长姓名"
          required
          bind:change="onParentNameInput"
        />
        
        <van-field
          value="{{patientInfo.parentPhone}}"
          label="联系电话"
          placeholder="请输入手机号码"
          type="number"
          required
          bind:change="onParentPhoneInput"
        />
        
        <picker
          range="{{relationshipOptions}}"
          value="{{relationshipIndex}}"
          bind:change="onRelationshipChange"
        >
          <van-cell
            title="与宝宝关系"
            value="{{patientInfo.relationship}}"
            is-link
          />
        </picker>
      </van-cell-group>
    </view>

    <!-- 医疗信息 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="medical-o" />
        <text>医疗信息</text>
      </view>
      
      <van-cell-group>
        <van-field
          value="{{patientInfo.medicalHistory}}"
          label="病史描述"
          type="textarea"
          placeholder="请简要描述宝宝的病史、症状等（选填）"
          autosize
          bind:change="onMedicalHistoryInput"
        />
        
        <van-field
          value="{{patientInfo.notes}}"
          label="备注信息"
          type="textarea"
          placeholder="其他需要说明的信息（选填）"
          autosize
          bind:change="onNotesInput"
        />
      </van-cell-group>
    </view>

    <!-- 病历文件 -->
    <view class="section">
      <view class="section-title">
        <van-icon name="description" />
        <text>病历文件</text>
        <text class="section-subtitle">（选填，支持PDF、Word、图片格式）</text>
      </view>
      
      <view class="file-upload">
        <van-button
          type="default"
          size="small"
          icon="plus"
          bind:click="uploadMedicalFile"
        >
          上传病历
        </van-button>
      </view>
      
      <view class="file-list" wx:if="{{medicalFiles.length > 0}}">
        <view 
          class="file-item" 
          wx:for="{{medicalFiles}}" 
          wx:key="fileID"
        >
          <view class="file-info" bind:tap="previewFile" data-fileid="{{item.fileID}}" data-filename="{{item.name}}">
            <van-icon name="description" class="file-icon" />
            <view class="file-details">
              <text class="file-name">{{item.name}}</text>
              <text class="file-size">{{item.formattedSize}}</text>
            </view>
          </view>
          <van-icon 
            name="delete" 
            class="delete-icon" 
            bind:tap="deleteFile" 
            data-index="{{index}}"
          />
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <van-button
        type="primary"
        size="large"
        loading="{{loading}}"
        disabled="{{loading}}"
        bind:click="submitForm"
      >
        {{loading ? '保存中...' : '保存信息'}}
      </van-button>
      
      <van-button
        wx:if="{{!isEdit}}"
        type="default"
        size="large"
        bind:click="skipProfile"
        class="skip-btn"
      >
        暂时跳过
      </van-button>
    </view>
  </form>
</view>