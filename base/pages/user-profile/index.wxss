/* 用户信息完善页面样式 — 适老化优化 */
.container {
  padding: 24rpx;
  padding-bottom: 200rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 0;
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  color: white;
}

.title {
  font-size: var(--font-h1);
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: var(--font-body);
  opacity: 0.9;
}

/* 统计卡片 */
.stats-card {
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  margin: -20rpx 0 32rpx;
  padding: 32rpx;
  position: relative;
  z-index: 2;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stats-label {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
}

.stats-achievements {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.achievement-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: var(--color-primary-light);
  border-radius: var(--radius-pill);
  font-size: var(--font-small);
  color: var(--color-primary);
}

.stats-share-btn {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

/* 分组区块 — 适老化：增加间距 */
.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}

.section-title .van-icon {
  margin-right: 10rpx;
  color: #1989fa;
}

/* 分组标题文字 — 适老化放大 */
.section-title text {
  font-size: 34rpx;
  font-weight: bold;
  color: #323233;
}

/* 分组副标题 — 适老化放大 */
.section-subtitle {
  font-size: 26rpx;
  color: #969799;
  margin-left: auto;
}

.van-cell-group {
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.file-upload {
  padding: 20rpx;
  text-align: center;
}

.file-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.file-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.file-item:last-child {
  border-bottom: none;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.file-icon {
  margin-right: 20rpx;
  color: #1989fa;
  font-size: 40rpx;
}

.file-details {
  flex: 1;
}

/* 文件名 — 适老化放大 */
.file-name {
  display: block;
  font-size: 30rpx;
  color: #323233;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.file-size {
  font-size: 26rpx;
  color: #969799;
}

.delete-icon {
  color: #ee0a24;
  font-size: 36rpx;
  padding: 10rpx;
}

/* ==================== 我的宝宝管理 ==================== */
.baby-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.baby-list {
  margin-top: 16rpx;
}

.baby-card {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #eee;
}

.baby-card-main {
  flex: 1;
  min-width: 0;
}

.baby-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.baby-card-info {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.baby-card-tip {
  font-size: 22rpx;
  color: #34BFA3;
  margin-top: 8rpx;
}

.baby-card-unbind {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.unbind-text {
  font-size: 20rpx;
  color: #ee0a24;
  margin-top: 4rpx;
}

.baby-empty {
  text-align: center;
  padding: 32rpx 0;
}

.baby-empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.baby-empty-hint {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.baby-loading {
  text-align: center;
  padding: 32rpx 0;
}

.baby-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ==================== 认领弹窗 ==================== */
.claim-popup {
  padding: 32rpx;
}

.claim-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 8rpx;
}

.claim-popup-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.claim-search-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.claim-result-list {
  max-height: 45vh;
  overflow-y: auto;
}

.claim-result-tip {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.claim-result-card {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  position: relative;
  transition: border-color 0.2s;
}

.claim-result-card-selected {
  border-color: #34BFA3;
  background: #e8f8f3;
}

.claim-result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.claim-result-info {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.claim-check-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

.claim-empty-result {
  text-align: center;
  padding: 48rpx 0;
}

.claim-empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.claim-empty-hint {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* ==================== 功能入口 ==================== */
.menu-section {
  margin-top: 48rpx;
  margin-bottom: 48rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
  padding: 28rpx var(--spacing-card);
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
}

.menu-card:active {
  background: #fafafa;
  transform: scale(0.98);
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-name {
  font-size: var(--font-h3);
  font-weight: 600;
  color: var(--color-text);
}

.menu-desc {
  font-size: var(--font-caption);
  color: var(--color-text-tertiary);
}

/* ==================== 操作按钮区域 ==================== */
/* 操作按钮区域 — 适老化：增大按钮高度和字号 */
.actions {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.actions .van-button {
  margin-bottom: 24rpx;
  border-radius: 50rpx;
  height: 96rpx;
  line-height: 96rpx;
  --button-large-height: 96rpx !important;
  --button-default-font-size: 34rpx !important;
}

.skip-btn {
  color: #969799 !important;
  border-color: #ebedf0 !important;
}

/* 表单样式优化 — 适老化：标签 30rpx，输入值 32rpx */
.van-field__label {
  color: #646566 !important;
  font-weight: 500 !important;
  font-size: 30rpx !important;
}

.van-field__control {
  color: #323233 !important;
  font-size: 32rpx !important;
}

.van-cell {
  padding: 28rpx 32rpx !important;
}

.van-cell__title {
  color: #646566 !important;
  font-weight: 500 !important;
  font-size: 30rpx !important;
}

.van-cell__value {
  color: #323233 !important;
  font-size: 32rpx !important;
}

/* 必填项标识 */
.van-field[required] .van-field__label::after {
  content: '*';
  color: #ee0a24;
  margin-left: 4rpx;
}

.van-cell[required] .van-cell__title::after {
  content: '*';
  color: #ee0a24;
  margin-left: 4rpx;
}