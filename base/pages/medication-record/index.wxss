.medication-record-container {
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  padding: 60rpx 40rpx 60rpx;
  color: white;
  text-align: center;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 0;
}

.header-subtitle {
  font-size: 30rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 40rpx 0;
}

.form-group {
  margin-bottom: 40rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 药物列表 */
.medication-list {
  padding: 24rpx;
}

.medication-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #e9ecef;
}

.medication-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.medication-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1976d2;
}

.dosage-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.add-medication-btn {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #64b5f6 0%, #42a5f5 100%);
  color: white;
  border: none;
}

/* 提交按钮 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 2rpx solid #f0f0f0;
  z-index: 100;
}

/* 适老化 - 提交按钮放大 */
.submit-container .van-button {
  border-radius: 50rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  border: none;
  font-size: 36rpx;
  font-weight: 600;
}

/* 适老化 - Vant 组件字号放大 */
.van-cell-group__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 32rpx 16rpx;
}

.van-field__label {
  font-size: 30rpx !important;
  font-weight: 500;
  color: #444 !important;
}

.van-field__input {
  font-size: 32rpx !important;
}

.van-field__textarea {
  font-size: 32rpx !important;
  min-height: 160rpx !important;
}

.van-field--textarea .van-field__input {
  min-height: 160rpx;
}

/* 适老化 - 选择器/Picker 点击区域放大 */
.van-cell {
  min-height: 88rpx !important;
  line-height: 1.5 !important;
}

.van-cell__title {
  font-size: 30rpx !important;
}

.van-cell__value {
  font-size: 30rpx !important;
}

/* 快捷选择样式 */
.quick-select-cell {
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  border-radius: 12rpx;
  margin: 16rpx 0;
  border: 2rpx solid #1976d2;
}

.quick-select-cell .van-cell__title {
  color: #1976d2;
  font-weight: 600;
}

.quick-select-cell .van-cell__label {
  color: #666;
  font-size: 24rpx;
}

.quick-select-cell .van-icon {
  color: #1976d2;
}

/* 药物选择器样式增强 */
.van-action-sheet__header {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  color: white;
}

.van-action-sheet__description {
  color: #666;
  font-size: 24rpx;
  padding: 16rpx 32rpx;
  background: #f8f9fa;
}

/* 单位选择器修复 */
.van-field--clickable {
  cursor: pointer;
}

.van-field--clickable .van-field__input {
  pointer-events: none;
}

/* 副作用标签样式 */
.side-effects-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 0;
}

.side-effect-tag {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 50rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
  cursor: pointer;
  user-select: none;
}

.side-effect-tag:active {
  transform: scale(0.95);
}

.side-effect-tag.selected {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  color: white;
  border-color: #1976d2;
  font-weight: 500;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .form-container {
    padding: 30rpx 30rpx 0;
  }
  
  .medication-item {
    padding: 20rpx;
  }
  
  .header-title {
    font-size: 40rpx;
  }
  
  .side-effect-tag {
    font-size: 26rpx;
    padding: 12rpx 22rpx;
  }
}