.home-container {
  background-color: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

.role-header {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  padding: 30rpx 40rpx;
  color: white;
}

.role-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.change-role {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: underline;
}

.section-title {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.section-title text {
  margin-left: 12rpx;
}

.emergency-cell {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
  margin: 20rpx 40rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.grid-item {
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin: 10rpx;
}

.schedule-group,
.focus-group,
.task-group {
  margin: 30rpx 40rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.patient-section,
.researcher-section,
.staff-section {
  margin-bottom: 40rpx;
}

/* 病友家庭样式 */
.patient-section .van-grid-item {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
}

/* 科研人员样式 */
.researcher-section .van-grid-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}

/* 工作人员样式 */
.staff-section .van-grid-item {
  background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
}

.van-notice-bar {
  margin: 20rpx 40rpx;
  border-radius: 12rpx;
}

.van-divider {
  margin: 40rpx 0 20rpx;
}

/* 状态标签样式 */
.van-cell__value {
  font-size: 24rpx;
}

/* 高优先级任务样式 */
.van-cell[data-priority="high"] {
  background-color: #fff7f0;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .role-header {
    padding: 25rpx 30rpx;
  }
  
  .section-title {
    padding: 25rpx 30rpx 15rpx;
    font-size: 30rpx;
  }
  
  .schedule-group,
  .focus-group,
  .task-group {
    margin: 25rpx 30rpx 0;
  }
}