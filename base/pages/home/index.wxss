.home-container {
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: 140rpx;
}

/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

/* 角色头部优化 */
.role-header {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  padding: 40rpx 40rpx 50rpx;
  color: white;
  position: relative;
  overflow: hidden;
}

.role-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  animation: float 6s ease-in-out infinite;
}

.role-header::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  animation: float 8s ease-in-out infinite reverse;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(180deg); }
}

.role-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 2;
}

.change-role {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  transition: all 0.3s ease;
}

.change-role:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

/* 分区标题优化 */
.section-title {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  position: relative;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 72rpx;
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #1989fa, #64b5f6);
  border-radius: 2rpx;
}

.section-title text {
  margin-left: 16rpx;
}

/* 紧急联系按钮优化 */
.emergency-cell {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  color: white;
  margin: 20rpx 40rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.3);
  position: relative;
  transition: all 0.3s ease;
}

.emergency-cell::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s;
}

.emergency-cell:active::before {
  left: 100%;
}

.emergency-cell:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.4);
}

/* 功能网格优化 */
.grid-item {
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.grid-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1989fa, #64b5f6, #42a5f5);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.grid-item:active {
  transform: translateY(-8rpx) scale(1.02);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

.grid-item:active::before {
  opacity: 1;
}

/* 病友家庭样式优化 */
.patient-section .van-grid-item {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  position: relative;
}

.patient-section .van-grid-item::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #2196f3, #1976d2);
  border-radius: 50%;
  opacity: 0.1;
}

/* 科研人员样式优化 */
.researcher-section .van-grid-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  position: relative;
}

.researcher-section .van-grid-item::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #9c27b0, #7b1fa2);
  border-radius: 50%;
  opacity: 0.1;
}

/* 工作人员样式优化 */
.staff-section .van-grid-item {
  background: linear-gradient(135deg, #e8f5e8 0%, #c8e6c9 100%);
  position: relative;
}

.staff-section .van-grid-item::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #4caf50, #388e3c);
  border-radius: 50%;
  opacity: 0.1;
}

/* 卡片组优化 */
.schedule-group,
.focus-group,
.task-group {
  margin: 30rpx 40rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  background: white;
  position: relative;
}

.schedule-group::before,
.focus-group::before,
.task-group::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1989fa, #64b5f6);
}

/* 通知栏优化 */
.van-notice-bar {
  margin: 24rpx 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(237, 106, 12, 0.2);
  border: 2rpx solid rgba(237, 106, 12, 0.1);
}

/* 分区间距优化 */
.patient-section,
.researcher-section,
.staff-section {
  margin-bottom: 50rpx;
}

/* 状态标签样式优化 */
.van-cell__value {
  font-size: 26rpx;
  font-weight: 500;
}

/* 高优先级任务样式优化 */
.van-cell[data-priority="high"] {
  background: linear-gradient(135deg, #fff7f0 0%, #ffe8d6 100%);
  border-left: 6rpx solid #ff9800;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .role-header {
    padding: 35rpx 30rpx 45rpx;
  }
  
  .section-title {
    padding: 35rpx 30rpx 20rpx;
    font-size: 32rpx;
  }
  
  .schedule-group,
  .focus-group,
  .task-group {
    margin: 25rpx 30rpx 0;
  }
  
  .van-notice-bar {
    margin: 20rpx 30rpx;
  }
}

/* 加载动画 */
@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.patient-section,
.researcher-section,
.staff-section {
  animation: slideInUp 0.6s ease-out;
}