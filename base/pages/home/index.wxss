/* 状态栏 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #34BFA3 0%, #2ecc71 100%);
}

/* 顶部标题 */
.header {
  background: linear-gradient(135deg, #34BFA3 0%, #2ecc71 100%);
  padding: 20rpx 40rpx 40rpx;
  color: white;
}

.app-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 主容器 */
.home-container {
  background: #f5f6fa;
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* 今日概览卡片 */
.overview-card {
  margin: -20rpx 30rpx 0;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  padding: 36rpx 0;
  position: relative;
  z-index: 2;
}

.overview-row {
  display: flex;
  align-items: center;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.overview-value.has-data {
  color: #34BFA3;
}

.overview-value.warning {
  color: #EE6363;
}

.overview-value.safe {
  color: #34BFA3;
}

.overview-label {
  font-size: 24rpx;
  color: #999;
}

.overview-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 连续打卡徽章 */
.streak-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 30rpx 0;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 152, 0, 0.15);
}

.streak-icon-wrap {
  font-size: 32rpx;
}

.streak-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #e65100;
}

.streak-total {
  font-size: 24rpx;
  color: #FF9800;
}

/* 快速记录 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 30rpx 0;
}

.quick-action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.quick-action-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.quick-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 区块标签 */
.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 30rpx 16rpx;
}

/* 待办提醒 */
.reminders-section {
  margin-top: 10rpx;
}

.reminder-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 30rpx 16rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.reminder-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reminder-card.monthly {
  border-left: 6rpx solid #FF9800;
}

.reminder-card.questionnaire {
  border-left: 6rpx solid #34BFA3;
}

.reminder-text {
  flex: 1;
  font-size: 28rpx;
  color: #555;
}

/* AI 助手区 */
.ai-section {
  margin-top: 10rpx;
}

.ai-grid {
  display: flex;
  gap: 16rpx;
  margin: 0 30rpx;
  flex-wrap: wrap;
}

.ai-card {
  flex: 1;
  min-width: calc(25% - 16rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 28rpx 0 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.ai-card:active {
  transform: scale(0.95);
}

.ai-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-icon {
  font-size: 36rpx;
}

.ai-name {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
}

/* 工具入口 & 更多功能 */
.tools-section,
.more-section {
  margin-top: 10rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 30rpx 16rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tool-card:active {
  background: #fafafa;
  transform: scale(0.98);
}

.tool-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tool-desc {
  font-size: 24rpx;
  color: #999;
}
