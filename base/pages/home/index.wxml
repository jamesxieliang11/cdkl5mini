<!-- 状态栏区域 -->
<view class="status-bar"></view>

<!-- 顶部标题 -->
<view class="header">
  <view class="app-title">希舞之家</view>
  <view class="header-subtitle">{{currentDate}}</view>
</view>

<view class="home-container">

  <!-- 今日概览卡片 -->
  <view class="overview-card">
    <view class="overview-row">
      <view class="overview-item" bindtap="goToMyRecords">
        <view class="overview-value {{todayMedCount > 0 ? 'has-data' : ''}}">{{todayMedCount}}</view>
        <view class="overview-label">今日用药(条)</view>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item" bindtap="goToMyRecords">
        <view class="overview-value {{weekSeizureCount > 0 ? 'warning' : 'safe'}}">{{weekSeizureCount}}</view>
        <view class="overview-label">近7日发作</view>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item" bindtap="goToMonthlyReport">
        <view class="overview-value {{showMonthlyReminder ? 'warning' : 'safe'}}">{{showMonthlyReminder ? '待提交' : '已提交'}}</view>
        <view class="overview-label">月度汇报</view>
      </view>
    </view>
  </view>

  <!-- 连续打卡 -->
  <view wx:if="{{streak > 0}}" class="streak-badge" bindtap="goToMyRecords">
    <view class="streak-icon-wrap">🔥</view>
    <text class="streak-text">已连续记录 {{streak}} 天</text>
    <text class="streak-total">累计 {{totalDays}} 天</text>
  </view>

  <!-- 快速记录 -->
  <view class="quick-actions">
    <view class="quick-action-btn" bindtap="addMedicationRecord">
      <view class="quick-icon-wrap" style="background:linear-gradient(135deg,#FF9800,#FFB74D)">
        <van-icon name="notes-o" size="24px" color="#fff" />
      </view>
      <text>记用药</text>
    </view>
    <view class="quick-action-btn" bindtap="addSeizureRecord">
      <view class="quick-icon-wrap" style="background:linear-gradient(135deg,#ee4d4d,#ff7675)">
        <van-icon name="warning-o" size="24px" color="#fff" />
      </view>
      <text>记发作</text>
    </view>
    <view class="quick-action-btn" bindtap="addOtherRecord">
      <view class="quick-icon-wrap" style="background:linear-gradient(135deg,#1989fa,#36a3ff)">
        <van-icon name="edit" size="24px" color="#fff" />
      </view>
      <text>记其他</text>
    </view>
  </view>

  <!-- 待办提醒 -->
  <view wx:if="{{showMonthlyReminder || (featuresEnabled && showQuestionnaireReminder)}}" class="reminders-section">
    <view class="section-label">待办事项</view>

    <view class="reminder-card monthly" wx:if="{{showMonthlyReminder}}" bindtap="goToMonthlyReport">
      <view class="reminder-icon-wrap" style="background:rgba(255,152,0,0.12)">
        <van-icon name="todo-list-o" size="20px" color="#FF9800" />
      </view>
      <text class="reminder-text">本月汇报尚未提交</text>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>

    <view class="reminder-card questionnaire" wx:if="{{featuresEnabled && showQuestionnaireReminder}}" bindtap="goToQuestionnaire">
      <view class="reminder-icon-wrap" style="background:rgba(52,191,163,0.12)">
        <van-icon name="edit" size="20px" color="#34BFA3" />
      </view>
      <text class="reminder-text">家庭基础信息问卷尚未填写</text>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>

  <!-- AI 智能助手 (gated) -->
  <view wx:if="{{featuresEnabled}}" class="ai-section">
    <view class="section-label">AI 智能助手</view>
    <view class="ai-grid">
      <view class="ai-card" bindtap="goToAI" data-scene="gene_report">
        <view class="ai-icon-wrap" style="background:linear-gradient(135deg,#667eea,#764ba2)">
          <text class="ai-icon">🧬</text>
        </view>
        <text class="ai-name">基因解读</text>
      </view>
      <view class="ai-card" bindtap="goToAI" data-scene="medical_record">
        <view class="ai-icon-wrap" style="background:linear-gradient(135deg,#f093fb,#f5576c)">
          <text class="ai-icon">📋</text>
        </view>
        <text class="ai-name">生成病历</text>
      </view>
      <view class="ai-card" bindtap="goToAI" data-scene="drug_adjustment">
        <view class="ai-icon-wrap" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
          <text class="ai-icon">💊</text>
        </view>
        <text class="ai-name">调药参考</text>
      </view>
      <view class="ai-card" bindtap="goToAI" data-scene="knowledge_qa">
        <view class="ai-icon-wrap" style="background:linear-gradient(135deg,#43e97b,#38f9d7)">
          <text class="ai-icon">💡</text>
        </view>
        <text class="ai-name">知识问答</text>
      </view>
    </view>
  </view>

  <!-- 工具入口 (gated) -->
  <view wx:if="{{featuresEnabled}}" class="tools-section">
    <view class="section-label">工具与资源</view>
    <view class="tool-card" bindtap="goToQuestionnaire">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#34BFA3,#2dd4a8)">
        <van-icon name="orders-o" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">家庭问卷</text>
        <text class="tool-desc">完善宝宝基础信息</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view class="tool-card" bindtap="goToBrochure">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#1989fa,#36a3ff)">
        <van-icon name="bookmark-o" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">希舞手册</text>
        <text class="tool-desc">CDKL5 疾病知识科普</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view class="tool-card" bindtap="goToImportRecords">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#667eea,#764ba2)">
        <van-icon name="description" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">导入记录</text>
        <text class="tool-desc">从 Excel 文件批量导入历史记录</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="more-section">
    <view class="section-label">更多</view>
    <view class="tool-card" bindtap="goToReports">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#9C27B0,#BA68C8)">
        <van-icon name="bar-chart-o" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">我的报告</text>
        <text class="tool-desc">查看记录统计与趋势</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view class="tool-card" bindtap="goToFeedback">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#FF9800,#FFB74D)">
        <van-icon name="smile-comment-o" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">反馈意见</text>
        <text class="tool-desc">帮助我们改进产品</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
    <view wx:if="{{isAdmin}}" class="tool-card" bindtap="goToAdmin">
      <view class="tool-icon-wrap" style="background:linear-gradient(135deg,#FF5722,#FF8A65)">
        <van-icon name="setting-o" size="24px" color="#fff" />
      </view>
      <view class="tool-info">
        <text class="tool-name">管理面板</text>
        <text class="tool-desc">数据统计与系统配置</text>
      </view>
      <van-icon name="arrow" size="14px" color="#ccc" />
    </view>
  </view>

</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />
