/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: var(--gradient-primary);
}

/* 管理员面板样式 */
.container {
  padding: 0 32rpx 200rpx;
  background-color: var(--color-bg);
  min-height: 100vh;
}

.header {
  text-align: center;
  padding: 40rpx 0 60rpx;
  background: var(--gradient-primary);
  margin: 0 -32rpx 40rpx;
  color: white;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.action-bar {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.db-section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-title .van-icon {
  margin-right: 16rpx;
}

.section-title > view {
  display: flex;
  align-items: center;
}

/* 权限标识 */
.admin-role-bar {
  text-align: center;
  padding: 20rpx 0;
}

/* 用户管理 */
.user-list {
  padding: 0 32rpx;
}

.user-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  flex-wrap: wrap;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.user-baby {
  font-size: 24rpx;
  color: #999;
}

.user-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ========== 看板卡片区 ========== */
.section-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.section-card-footer {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.loading-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 48rpx 0;
}

.empty-text {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* 全局概览 4宫格 */
.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.overview-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.overview-number {
  font-size: 44rpx;
  font-weight: bold;
  color: #34BFA3;
}

.overview-label {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 统计行 */
.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.stat-row-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.stat-row-detail {
  font-size: 26rpx;
  color: #666;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #34BFA3, #2da88e);
  border-radius: 12rpx;
  transition: width 0.3s;
  min-width: 4rpx;
}

/* 性别分布 */
.gender-row {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.gender-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  gap: 8rpx;
}

.gender-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: inline-block;
}

.gender-dot.male {
  background: #1989fa;
}

.gender-dot.female {
  background: #ee0a24;
}

.gender-dot.unknown {
  background: #999;
}

/* 地区列表 */
.region-list {
  margin-top: 8rpx;
}

.region-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.region-item:last-child {
  border-bottom: none;
}

.region-rank {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #34BFA3;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.region-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.region-count {
  font-size: 26rpx;
  color: #666;
}

/* CSS 柱状条 */
.bar-chart {
  margin-top: 8rpx;
}

.bar-chart-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 32rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 16rpx;
  transition: width 0.3s;
  min-width: 4rpx;
}

.bar-fill-green {
  background: linear-gradient(90deg, #34BFA3, #2da88e);
}

.bar-fill-red {
  background: linear-gradient(90deg, #ee0a24, #c41d7f);
}

.bar-fill-blue {
  background: linear-gradient(90deg, #1989fa, #1565c0);
}

.bar-fill-orange {
  background: linear-gradient(90deg, #ff976a, #ee6723);
}

.bar-value {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex-shrink: 0;
}

/* 月度概览 */
.monthly-overview {
  padding: 0;
}

/* 详情按钮容器 */
.detail-btn-wrapper {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  text-align: center;
}

/* 功能开关管理 */
.config-switch-list {
  margin-top: 8rpx;
}

.config-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.config-switch-info {
  flex: 1;
  margin-right: 24rpx;
}

.config-switch-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.config-switch-desc {
  font-size: 22rpx;
  color: #999;
}

/* 社区话题管理 */
.topic-form {
  margin-bottom: 16rpx;
}

.topic-form-row {
  margin-bottom: 12rpx;
}

.topic-input {
  background: #f7f8fa !important;
  border-radius: 12rpx !important;
}

.topic-manage-list {
  margin-top: 16rpx;
}

.topic-manage-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.topic-manage-item:last-child {
  border-bottom: none;
}

.topic-manage-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.topic-manage-icon {
  font-size: 36rpx;
}

.topic-manage-info {
  display: flex;
  flex-direction: column;
}

.topic-manage-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.topic-manage-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}