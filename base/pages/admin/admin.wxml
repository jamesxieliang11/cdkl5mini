<!-- 状态栏区域 -->
<view class="status-bar"></view>

<!--管理员面板-->
<view class="container">
  <view class="header">
    <text class="title">管理员面板</text>
    <text class="subtitle">管理与统计</text>
  </view>

  <!-- 权限标识 -->
  <view class="admin-role-bar">
    <van-tag wx:if="{{isSuperAdmin}}" type="danger" size="large">超级管理员</van-tag>
    <van-tag wx:elif="{{isAdmin}}" type="primary" size="large">管理员</van-tag>
    <van-tag wx:else type="default" size="large">普通用户（无管理权限）</van-tag>
  </view>

  <!-- ========== 全局概览 ========== -->
  <view class="section-card" wx:if="{{isAdmin}}">
    <view class="section-card-title">📊 全局概览</view>
    <view wx:if="{{overviewLoading}}" class="loading-placeholder">
      <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
    </view>
    <view wx:else class="overview-grid">
      <view class="overview-item">
        <view class="overview-number">{{overviewData.totalUsers}}</view>
        <view class="overview-label">注册用户</view>
      </view>
      <view class="overview-item">
        <view class="overview-number">{{overviewData.activeUsers}}</view>
        <view class="overview-label">活跃用户</view>
      </view>
      <view class="overview-item">
        <view class="overview-number">{{questionnaireStats.completionRate}}%</view>
        <view class="overview-label">问卷完成率</view>
      </view>
      <view class="overview-item">
        <view class="overview-number">{{overviewData.recordCounts.total}}</view>
        <view class="overview-label">记录总量</view>
      </view>
    </view>

    <!-- 查看数据趋势入口 -->
    <view class="detail-btn-wrapper">
      <van-button plain type="primary" size="small" bind:tap="goToOverviewDetail" custom-style="border-color: #34BFA3; color: #34BFA3;">
        📊 查看数据趋势
      </van-button>
    </view>
  </view>

  <!-- ========== 问卷数据分析 ========== -->
  <view class="section-card" wx:if="{{isAdmin}}">
    <view class="section-card-title">📋 问卷数据分析</view>
    <view wx:if="{{questionnaireLoading}}" class="loading-placeholder">
      <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
    </view>
    <view wx:else>
      <!-- 完成进度条 -->
      <view class="stat-row">
        <view class="stat-row-label">完成进度</view>
        <view class="stat-row-detail">{{questionnaireStats.submittedCount}} / {{questionnaireStats.totalUsers}} 人</view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{questionnaireStats.completionRate}}%;"></view>
      </view>

      <!-- 性别分布 -->
      <view class="stat-row" style="margin-top: 24rpx;">
        <view class="stat-row-label">性别分布</view>
      </view>
      <view class="gender-row">
        <view class="gender-item" wx:if="{{questionnaireStats.genderDistribution.male !== undefined}}">
          <text class="gender-dot male"></text>
          <text>男 {{questionnaireStats.genderDistribution.male || 0}}人</text>
        </view>
        <view class="gender-item" wx:if="{{questionnaireStats.genderDistribution.female !== undefined}}">
          <text class="gender-dot female"></text>
          <text>女 {{questionnaireStats.genderDistribution.female || 0}}人</text>
        </view>
        <view class="gender-item" wx:if="{{questionnaireStats.genderDistribution.unknown !== undefined}}">
          <text class="gender-dot unknown"></text>
          <text>未知 {{questionnaireStats.genderDistribution.unknown || 0}}人</text>
        </view>
      </view>

      <!-- 地区 TOP5 -->
      <view class="stat-row" style="margin-top: 24rpx;">
        <view class="stat-row-label">地区 TOP5</view>
      </view>
      <view class="region-list">
        <view class="region-item" wx:for="{{questionnaireStats.regionTop10}}" wx:key="region" wx:if="{{index < 5}}">
          <view class="region-rank">{{index + 1}}</view>
          <view class="region-name">{{item.region || '未知'}}</view>
          <view class="region-count">{{item.count}}人</view>
        </view>
        <view wx:if="{{!questionnaireStats.regionTop10 || questionnaireStats.regionTop10.length === 0}}" class="empty-text">暂无数据</view>
      </view>

      <!-- 癫痫控制状态分布 -->
      <view class="stat-row" style="margin-top: 24rpx;">
        <view class="stat-row-label">癫痫控制状态</view>
      </view>
      <view class="bar-chart">
        <view class="bar-chart-item" wx:for="{{questionnaireStats.seizureControlDistribution}}" wx:for-index="key" wx:for-item="val" wx:key="key">
          <view class="bar-label">{{key}}</view>
          <view class="bar-track">
            <view class="bar-fill bar-fill-green" style="width: {{questionnaireStats.submittedCount > 0 ? val / questionnaireStats.submittedCount * 100 : 0}}%;"></view>
          </view>
          <view class="bar-value">{{val}}</view>
        </view>
      </view>
    </view>

    <!-- 查看问卷详情入口 -->
    <view class="detail-btn-wrapper">
      <van-button plain type="primary" size="small" bind:tap="goToQuestionnaireDetail" custom-style="border-color: #34BFA3; color: #34BFA3;">
        📋 查看问卷详情列表
      </van-button>
    </view>
  </view>

  <!-- ========== 月度汇报概览 ========== -->
  <view class="section-card" wx:if="{{isAdmin}}">
    <view class="section-card-title">📅 月度汇报概览</view>
    <view wx:if="{{monthlyStatsLoading}}" class="loading-placeholder">
      <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
    </view>
    <view wx:elif="{{currentMonthStats}}" class="monthly-overview">
      <!-- 当月提交进度 -->
      <view class="stat-row">
        <view class="stat-row-label">当月提交</view>
        <view class="stat-row-detail">{{currentMonthStats.overview.totalSubmitted || 0}} / {{currentMonthStats.overview.totalUsers || 0}} 人</view>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{currentMonthStats.overview.totalUsers > 0 ? currentMonthStats.overview.totalSubmitted / currentMonthStats.overview.totalUsers * 100 : 0}}%;"></view>
      </view>

      <!-- 记录量统计 -->
      <view class="stat-row" style="margin-top: 24rpx;">
        <view class="stat-row-label">记录量统计</view>
      </view>
      <view class="bar-chart">
        <view class="bar-chart-item">
          <view class="bar-label">发作</view>
          <view class="bar-track">
            <view class="bar-fill bar-fill-red" style="width: {{overviewData.recordCounts.total > 0 ? overviewData.recordCounts.seizure / overviewData.recordCounts.total * 100 : 0}}%;"></view>
          </view>
          <view class="bar-value">{{overviewData.recordCounts.seizure}}</view>
        </view>
        <view class="bar-chart-item">
          <view class="bar-label">用药</view>
          <view class="bar-track">
            <view class="bar-fill bar-fill-blue" style="width: {{overviewData.recordCounts.total > 0 ? overviewData.recordCounts.medication / overviewData.recordCounts.total * 100 : 0}}%;"></view>
          </view>
          <view class="bar-value">{{overviewData.recordCounts.medication}}</view>
        </view>
        <view class="bar-chart-item">
          <view class="bar-label">其他</view>
          <view class="bar-track">
            <view class="bar-fill bar-fill-orange" style="width: {{overviewData.recordCounts.total > 0 ? overviewData.recordCounts.other / overviewData.recordCounts.total * 100 : 0}}%;"></view>
          </view>
          <view class="bar-value">{{overviewData.recordCounts.other}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-text" style="padding: 32rpx;">暂无当月统计数据</view>

    <!-- 跳转详细统计 -->
    <view class="section-card-footer">
      <van-button 
        type="info" 
        size="small" 
        bind:click="goToMonthlyStats"
        icon="chart-trending-o"
        block
        plain
      >
        查看详细月度统计
      </van-button>
    </view>
  </view>

  <!-- ========== 社区话题管理 ========== -->
  <view class="section-card" wx:if="{{isAdmin}}">
    <view class="section-card-title">💬 社区话题管理</view>

    <!-- 新建话题表单 -->
    <view class="topic-form">
      <view class="topic-form-row">
        <van-field
          value="{{newTopicTitle}}"
          placeholder="话题标题"
          bind:change="onTopicTitleInput"
          border="{{false}}"
          custom-class="topic-input"
        />
      </view>
      <view class="topic-form-row">
        <van-field
          value="{{newTopicDesc}}"
          placeholder="话题描述（选填）"
          bind:change="onTopicDescInput"
          border="{{false}}"
          custom-class="topic-input"
        />
      </view>
      <view class="topic-form-row" style="display: flex; align-items: center; gap: 16rpx;">
        <van-field
          value="{{newTopicIcon}}"
          placeholder="图标 emoji"
          bind:change="onTopicIconInput"
          border="{{false}}"
          custom-class="topic-input"
          style="flex: 1;"
        />
        <van-button
          type="primary"
          size="small"
          round
          color="#34BFA3"
          disabled="{{!newTopicTitle}}"
          loading="{{topicSubmitting}}"
          bind:click="submitNewTopic"
        >
          发布话题
        </van-button>
      </view>
    </view>

    <!-- 已有话题列表 -->
    <view class="topic-manage-list" wx:if="{{communityTopics.length > 0}}">
      <view class="stat-row" style="margin-top: 24rpx;">
        <view class="stat-row-label">已有话题 ({{communityTopics.length}})</view>
      </view>
      <view class="topic-manage-item" wx:for="{{communityTopics}}" wx:key="_id">
        <view class="topic-manage-left">
          <text class="topic-manage-icon">{{item.icon || '💬'}}</text>
          <view class="topic-manage-info">
            <text class="topic-manage-name">{{item.title}}</text>
            <text class="topic-manage-count">{{item.post_count || 0}} 帖子</text>
          </view>
        </view>
        <van-tag wx:if="{{item.is_hot}}" type="danger" size="small">热门</van-tag>
      </view>
    </view>
    <view wx:elif="{{!topicListLoading}}" class="empty-text" style="padding: 24rpx;">暂无话题</view>
  </view>

  <!-- 用户管理（仅超管可见） -->
  <view class="db-section" wx:if="{{isSuperAdmin}}">
    <view class="section-title" bindtap="toggleUserManagement">
      <view>
        <van-icon name="friends-o" />
        <text style="margin-left: 12rpx;">用户管理</text>
      </view>
      <van-icon name="{{showUserManagement ? 'arrow-up' : 'arrow-down'}}" />
    </view>

    <view wx:if="{{showUserManagement}}">
      <view wx:if="{{loadingUsers}}" style="text-align: center; padding: 32rpx;">
        <text style="color: #999;">加载中...</text>
      </view>

      <view wx:elif="{{userList.length === 0}}" style="text-align: center; padding: 32rpx;">
        <text style="color: #999;">暂无用户</text>
      </view>

      <view wx:else class="user-list">
        <view class="user-item" wx:for="{{userList}}" wx:key="userId">
          <view class="user-info">
            <text class="user-name">{{item.nickName}}</text>
            <text class="user-baby" wx:if="{{item.babyName}}">（{{item.babyName}}）</text>
            <van-tag wx:if="{{item.adminRole === 'superadmin'}}" type="danger" size="small">超管</van-tag>
            <van-tag wx:elif="{{item.adminRole === 'admin'}}" type="primary" size="small">管理员</van-tag>
          </view>
          <view class="user-actions" wx:if="{{item.adminRole !== 'superadmin'}}">
            <van-button
              size="mini"
              type="{{item.adminRole === 'admin' ? 'warning' : 'info'}}"
              bind:click="toggleAdminRole"
              data-userid="{{item.userId}}"
              data-role="{{item.adminRole}}"
              data-name="{{item.nickName}}"
            >
              {{item.adminRole === 'admin' ? '取消管理员' : '设为管理员'}}
            </van-button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />
