<!-- 状态栏区域 -->
<view class="status-bar"></view>

<!--管理员面板-->
<view class="container">
  <view class="header">
    <text class="title">管理员面板</text>
    <text class="subtitle">管理与统计</text>
  </view>

  <!-- 权限标识 -->
  <view class="admin-role-bar">
    <van-tag wx:if="{{isSuperAdmin}}" type="danger" size="large">超级管理员</van-tag>
    <van-tag wx:elif="{{isAdmin}}" type="primary" size="large">管理员</van-tag>
    <van-tag wx:else type="default" size="large">普通用户（无管理权限）</van-tag>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-bar">
    <van-button 
      wx:if="{{isAdmin}}"
      type="info" 
      size="small" 
      bind:click="goToMonthlyStats"
      icon="chart-trending-o"
    >
      月度统计
    </van-button>
  </view>

  <!-- 用户管理（仅超管可见） -->
  <view class="db-section" wx:if="{{isSuperAdmin}}">
    <view class="section-title" bindtap="toggleUserManagement">
      <van-icon name="friends-o" />
      <text>用户管理</text>
      <van-icon name="{{showUserManagement ? 'arrow-up' : 'arrow-down'}}" />
    </view>

    <view wx:if="{{showUserManagement}}">
      <view wx:if="{{loadingUsers}}" style="text-align: center; padding: 32rpx;">
        <text style="color: #999;">加载中...</text>
      </view>

      <view wx:elif="{{userList.length === 0}}" style="text-align: center; padding: 32rpx;">
        <text style="color: #999;">暂无用户</text>
      </view>

      <view wx:else class="user-list">
        <view class="user-item" wx:for="{{userList}}" wx:key="userId">
          <view class="user-info">
            <text class="user-name">{{item.nickName}}</text>
            <text class="user-baby" wx:if="{{item.babyName}}">（{{item.babyName}}）</text>
            <van-tag wx:if="{{item.adminRole === 'superadmin'}}" type="danger" size="small">超管</van-tag>
            <van-tag wx:elif="{{item.adminRole === 'admin'}}" type="primary" size="small">管理员</van-tag>
          </view>
          <view class="user-actions" wx:if="{{item.adminRole !== 'superadmin'}}">
            <van-button
              size="mini"
              type="{{item.adminRole === 'admin' ? 'warning' : 'info'}}"
              bind:click="toggleAdminRole"
              data-userid="{{item.userId}}"
              data-role="{{item.adminRole}}"
              data-name="{{item.nickName}}"
            >
              {{item.adminRole === 'admin' ? '取消管理员' : '设为管理员'}}
            </van-button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />