<!-- 状态栏区域 -->
<view class="status-bar"></view>

<!--管理员面板-->
<view class="container">
  <view class="header">
    <text class="title">管理员面板</text>
    <text class="subtitle">数据库管理</text>
  </view>

  <!-- 操作按钮区域 -->
  <view class="action-bar">
    <van-button 
      type="primary" 
      size="small" 
      bind:click="refreshStatus"
      loading="{{basicDbStatus.loading || recordsDbStatus.loading}}"
    >
      刷新状态
    </van-button>
    <text class="update-time">最后更新: {{lastUpdateTime}}</text>
  </view>

  <!-- 基础数据库状态 -->
  <view class="db-section">
    <view class="section-title">
      <van-icon name="database-o" />
      <text>基础数据库</text>
      <van-tag 
        type="{{basicDbStatus.initialized ? 'success' : 'danger'}}" 
        size="medium"
      >
        {{getStatusText(basicDbStatus.initialized)}}
      </van-tag>
    </view>
    
    <view class="db-info">
      <view class="info-item">
        <text class="label">状态</text>
        <text class="value" style="color: {{getStatusColor(basicDbStatus.initialized)}}">
          {{basicDbStatus.initialized ? '已初始化' : '未初始化'}}
        </text>
      </view>
      <view class="info-item">
        <text class="label">记录数量</text>
        <text class="value">{{basicDbStatus.recordCount}}</text>
      </view>
    </view>

    <view class="actions">
      <van-button 
        type="{{basicDbStatus.initialized ? 'default' : 'primary'}}"
        size="large"
        bind:click="initBasicDatabase"
        loading="{{initializing}}"
        disabled="{{initializing}}"
      >
        {{basicDbStatus.initialized ? '重新初始化' : '初始化基础数据库'}}
      </van-button>
    </view>
  </view>

  <!-- 记录数据库状态 -->
  <view class="db-section">
    <view class="section-title">
      <van-icon name="records" />
      <text>记录数据库</text>
      <van-tag 
        type="{{recordsDbStatus.initialized ? 'success' : 'danger'}}" 
        size="medium"
      >
        {{getStatusText(recordsDbStatus.initialized)}}
      </van-tag>
    </view>
    
    <view class="db-info">
      <view class="info-item">
        <text class="label">调药记录</text>
        <text class="value">{{recordsDbStatus.medication_records}}</text>
      </view>
      <view class="info-item">
        <text class="label">发作记录</text>
        <text class="value">{{recordsDbStatus.seizure_records}}</text>
      </view>
      <view class="info-item">
        <text class="label">其他记录</text>
        <text class="value">{{recordsDbStatus.other_records}}</text>
      </view>
      <view class="info-item">
        <text class="label">统计记录</text>
        <text class="value">{{recordsDbStatus.record_statistics}}</text>
      </view>
      <view class="info-item total">
        <text class="label">总记录数</text>
        <text class="value">{{recordsDbStatus.total}}</text>
      </view>
    </view>

    <view class="actions">
      <van-button 
        type="{{recordsDbStatus.initialized ? 'default' : 'primary'}}"
        size="large"
        bind:click="initRecordsDb"
        loading="{{initializing}}"
        disabled="{{initializing}}"
      >
        {{recordsDbStatus.initialized ? '重新初始化' : '初始化记录数据库'}}
      </van-button>
    </view>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />