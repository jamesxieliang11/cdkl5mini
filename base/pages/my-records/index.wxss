/* pages/my-records/index.wxss */

.container {
  padding: 0;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 30rpx 40rpx;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  position: relative;
  overflow: hidden;
}

.page-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(180deg); }
}

.header-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.page-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  font-weight: 300;
}

/* 返回主页按钮 */
.home-btn {
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: white;
  font-size: 24rpx;
  line-height: 1;
  transition: all 0.3s ease;
  backdrop-filter: blur(10rpx);
}

.home-btn:active {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(0.95);
}

.home-icon {
  font-size: 28rpx;
}

.home-text {
  font-size: 24rpx;
  font-weight: 500;
}

/* 查询条件区域 */
.search-section {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.search-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 20rpx 20rpx 0 0;
}

.filter-item {
  margin-bottom: 40rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
}

/* 记录类型标签 */
.record-type-tabs {
  display: flex;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 8rpx;
  gap: 4rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 20rpx 12rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.tab-icon {
  font-size: 32rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 500;
}

.tab-item:not(.active) .tab-icon {
  opacity: 0.6;
}

.tab-item:not(.active) .tab-text {
  color: #666;
}

/* 时间范围选择 */
.date-range {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.date-picker {
  flex: 1;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.picker-display:active {
  border-color: #667eea;
  background: #f0f2ff;
  transform: scale(0.98);
}

.date-text {
  font-size: 28rpx;
  color: #333;
}

.picker-icon {
  font-size: 28rpx;
  opacity: 0.7;
}

.date-separator {
  font-size: 26rpx;
  color: #666;
  margin: 0 10rpx;
  font-weight: 500;
}

/* 查询按钮 */
.search-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.search-btn {
  flex: 2;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.search-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.search-btn[disabled] {
  background: #ccc;
  transform: none;
}

.reset-btn {
  flex: 1;
  background: white;
  color: #666;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.reset-btn:active {
  background: #f8f9fa;
  border-color: #667eea;
  transform: scale(0.98);
}

.btn-icon {
  font-size: 24rpx;
}

.btn-text {
  font-size: 26rpx;
}

/* 记录列表区域 */
.records-section {
  margin: 20rpx;
}

/* 统计信息 */
.records-stats {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border-left: 6rpx solid #667eea;
}

.stats-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stats-icon {
  font-size: 28rpx;
}

.stats-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 记录列表 */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.record-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.record-item:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 记录头部 */
.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.record-type-info {
  display: flex;
  align-items: center;
}

.record-type-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 25rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: white;
}

.record-type-tag.medication {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.record-type-tag.seizure {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.record-type-tag.other {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #333;
}

.tag-icon {
  font-size: 20rpx;
}

.tag-text {
  font-size: 22rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

/* 记录内容 */
.record-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.content-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.content-icon {
  font-size: 20rpx;
  opacity: 0.7;
  width: 32rpx;
  text-align: center;
}

.record-content text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

/* 调药记录样式 */
.medication-name {
  font-weight: 600;
  color: #4facfe !important;
}

.medication-dosage,
.take-time {
  color: #666 !important;
  font-size: 24rpx !important;
}

/* 发作记录样式 */
.seizure-type {
  font-weight: 600;
  color: #fa709a !important;
}

.seizure-duration {
  color: #666 !important;
  font-size: 24rpx !important;
}

/* 其他记录样式 */
.other-category {
  font-weight: 600;
  color: #20bf6b !important;
}

.other-note {
  color: #666 !important;
  font-size: 24rpx !important;
  line-height: 1.5;
}

/* 记录操作提示 */
.record-action-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.action-icon {
  font-size: 18rpx;
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6rpx); }
  60% { transform: translateY(-3rpx); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 0.3; }
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 40rpx;
}

.empty-action-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.empty-action-btn:active {
  transform: scale(0.95);
}

/* 加载更多 */
.load-more {
  margin-top: 30rpx;
  text-align: center;
}

.load-more-btn {
  background: white;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.load-more-btn:active {
  background: #f0f2ff;
  transform: scale(0.98);
}

.load-more-btn[disabled] {
  background: #f5f5f5;
  color: #ccc;
  border-color: #e0e0e0;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(4rpx);
}

.loading-content {
  background: white;
  padding: 60rpx 80rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.3);
}

.loading-icon {
  font-size: 48rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 详情弹窗样式 */
.detail-popup-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f8f9fa;
}

/* 弹窗标题区域 */
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: white;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-title-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.detail-subtitle {
  font-size: 24rpx;
  color: #999;
}

.detail-actions {
  display: flex;
  align-items: center;
}

.detail-edit-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 弹窗内容区域 */
.detail-content {
  flex: 1;
  padding: 24rpx 32rpx;
}

/* 详情分组 */
.detail-section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 信息项 */
.info-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item.vertical {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  min-width: 160rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 400;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.info-item.vertical .info-value {
  text-align: left;
}

/* 高亮样式 */
.medication-highlight {
  color: #4facfe !important;
  font-weight: 600 !important;
}

.seizure-highlight {
  color: #fa709a !important;
  font-weight: 600 !important;
}

.other-highlight {
  color: #20bf6b !important;
  font-weight: 600 !important;
}

.content-text {
  line-height: 1.6;
  background: #f8f9fa;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

/* 底部操作区 */
.detail-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
  background: white;
  border-top: 2rpx solid #f0f0f0;
}

.footer-btn {
  flex: 1;
  height: 88rpx !important;
  border-radius: 16rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
}

.cancel-btn {
  background: #f5f5f5 !important;
  color: #666 !important;
  border: 2rpx solid #e0e0e0 !important;
}

.edit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  color: white !important;
  border: none !important;
}

/* 不同记录类型的特殊样式 */
.medication-detail .detail-section:first-child .section-header {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  margin: -32rpx -32rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

.seizure-detail .detail-section:first-child .section-header {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: white;
  margin: -32rpx -32rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

.other-detail .detail-section:first-child .section-header {
  background: linear-gradient(135deg, #20bf6b 0%, #01baef 100%);
  color: white;
  margin: -32rpx -32rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

/* 详情图片样式 */
.detail-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.detail-image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.detail-image-item:active {
  transform: scale(0.95);
}

.detail-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 12rpx;
}

.detail-image-item:active .image-overlay {
  opacity: 1;
}

/* 响应式图片布局 */
@media screen and (max-width: 750rpx) {
  .detail-image-item {
    width: calc(50% - 8rpx);
  }
}

@media screen and (max-width: 500rpx) {
  .detail-image-item {
    width: 100%;
    height: 240rpx;
  }
}

.other-detail .detail-section:first-child .section-header {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
  color: #333;
  margin: -32rpx -32rpx 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 16rpx 16rpx 0 0;
  border-bottom: none;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .detail-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 20rpx;
  }
  
  .detail-actions {
    width: 100%;
    justify-content: flex-end;
  }
  
  .info-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 8rpx;
  }
  
  .info-value {
    text-align: left;
  }
}