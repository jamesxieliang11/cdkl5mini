/* pages/queue-status/index.wxss */

/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.queue-container {
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

/* 加载状态 */
.van-loading {
  margin: 200rpx auto;
  text-align: center;
}

/* 排队内容 */
.queue-content {
  padding: 30rpx 40rpx;
}

/* 排队号码卡片 */
.queue-number-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  text-align: center;
}

.queue-number-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.queue-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.queue-number {
  font-size: 80rpx;
  font-weight: 700;
  color: #1989fa;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.queue-status {
  display: flex;
  justify-content: space-around;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.status-item {
  text-align: center;
}

.status-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.status-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.current-number {
  color: #ff6b35;
}

/* 状态提示 */
.status-tips {
  margin-bottom: 30rpx;
}

.tip-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tip-card.waiting {
  border-left: 6rpx solid #1989fa;
  background: linear-gradient(135deg, #f8f9ff 0%, #e3f2fd 100%);
}

.tip-card.calling {
  border-left: 6rpx solid #ff6b35;
  background: linear-gradient(135deg, #fff8f0 0%, #ffe0cc 100%);
}

.tip-card.finished {
  border-left: 6rpx solid #07c160;
  background: linear-gradient(135deg, #f0fff4 0%, #d4edda 100%);
}

.tip-card.cancelled {
  border-left: 6rpx solid #ee0a24;
  background: linear-gradient(135deg, #fff5f5 0%, #fed7d7 100%);
}

.tip-card text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 预约信息 */
.appointment-info {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.info-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.info-content {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  max-width: 400rpx;
  text-align: right;
}

.info-actions {
  text-align: center;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.refresh-btn,
.contact-btn,
.cancel-btn {
  border-radius: 50rpx !important;
  font-weight: 600 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8rpx !important;
}

.refresh-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3) !important;
}

.contact-btn {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%) !important;
  border: none !important;
  color: white !important;
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.3) !important;
}

.cancel-btn {
  background: linear-gradient(135deg, #ee0a24 0%, #d32f2f 100%) !important;
  border: none !important;
  box-shadow: 0 8rpx 24rpx rgba(238, 10, 36, 0.3) !important;
}

/* 温馨提示 */
.notice-section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff9800;
}

.notice-content {
  padding-left: 28rpx;
}

.notice-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.notice-item:last-child {
  margin-bottom: 0;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .queue-content {
    padding: 25rpx 30rpx;
  }
  
  .queue-number-card,
  .appointment-info {
    margin: 0 -10rpx 25rpx;
    padding: 30rpx 25rpx;
  }
  
  .queue-number {
    font-size: 70rpx;
  }
  
  .status-value {
    font-size: 28rpx;
  }
}

/* 加载动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.queue-number-card,
.tip-card,
.appointment-info,
.action-buttons,
.notice-section {
  animation: fadeInUp 0.6s ease-out;
}

/* 状态指示动画 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.6;
  }
}

.tip-card.calling {
  animation: pulse 2s infinite;
}