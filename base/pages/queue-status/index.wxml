<!--pages/queue-status/index.wxml-->
<van-nav-bar
  title="排队状态"
  left-arrow
  bind:click-left="onBack"
  custom-class="custom-nav-bar"
/>

<view class="queue-container">
  <!-- 加载状态 -->
  <van-loading wx:if="{{isLoading}}" type="spinner" color="#1989fa" size="50rpx" vertical>
    加载中...
  </van-loading>

  <!-- 排队状态内容 -->
  <view wx:else class="queue-content">
    <!-- 页面标题 -->
    <view class="page-header">
      <van-icon name="clock-o" size="24" color="white" />
      <text class="page-title">排队状态</text>
    </view>

    <!-- 排队号码卡片 -->
    <view class="queue-number-card">
      <view class="queue-number-header">
        <text class="queue-label">您的排队号</text>
        <van-tag 
          type="{{queueInfo.status === 'calling' ? 'danger' : 'primary'}}"
          size="medium"
        >
          {{statusTextMap[queueInfo.status]}}
        </van-tag>
      </view>
      
      <view class="queue-number">{{queueInfo.queueNumber}}</view>
      
      <view class="queue-status">
        <view class="status-item">
          <text class="status-label">当前叫号</text>
          <text class="status-value current-number">{{queueInfo.currentNumber}}</text>
        </view>
        
        <view class="status-item">
          <text class="status-label">前面等待</text>
          <text class="status-value">{{queueInfo.waitingCount}}人</text>
        </view>
        
        <view class="status-item">
          <text class="status-label">预计等待</text>
          <text class="status-value">{{queueInfo.estimatedTime}}分钟</text>
        </view>
      </view>
    </view>

    <!-- 状态提示 -->
    <view class="status-tips">
      <view wx:if="{{queueInfo.status === 'waiting'}}" class="tip-card waiting">
        <van-icon name="clock-o" size="20" color="#1989fa" />
        <text>请耐心等待，我们会及时通知您</text>
      </view>
      
      <view wx:elif="{{queueInfo.status === 'calling'}}" class="tip-card calling">
        <van-icon name="volume-o" size="20" color="#ff6b35" />
        <text>正在叫号，请尽快前往诊室</text>
      </view>
      
      <view wx:elif="{{queueInfo.status === 'finished'}}" class="tip-card finished">
        <van-icon name="success" size="20" color="#07c160" />
        <text>就诊已完成，感谢您的配合</text>
      </view>
      
      <view wx:elif="{{queueInfo.status === 'cancelled'}}" class="tip-card cancelled">
        <van-icon name="cross" size="20" color="#ee0a24" />
        <text>排队已取消</text>
      </view>
    </view>

    <!-- 预约信息 -->
    <view class="appointment-info">
      <view class="info-header">
        <van-icon name="records" size="18" color="#666" />
        <text class="info-title">预约信息</text>
      </view>
      
      <view class="info-content">
        <view class="info-item">
          <text class="info-label">患者姓名</text>
          <text class="info-value">{{appointmentInfo.patientName || '未填写'}}</text>
        </view>
        
        <view class="info-item">
          <text class="info-label">就诊科室</text>
          <text class="info-value">{{appointmentInfo.department || '未指定'}}</text>
        </view>
        
        <view class="info-item">
          <text class="info-label">主治医生</text>
          <text class="info-value">{{appointmentInfo.doctorName || '待分配'}}</text>
        </view>
        
        <view class="info-item">
          <text class="info-label">预约时间</text>
          <text class="info-value">{{appointmentInfo.appointmentTime || '未指定'}}</text>
        </view>
      </view>
      
      <view class="info-actions">
        <van-button 
          type="info" 
          size="small"
          bind:click="viewAppointmentDetail"
        >
          查看详情
        </van-button>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <van-button 
        type="primary" 
        size="large"
        bind:click="refreshStatus"
        custom-class="refresh-btn"
      >
        <van-icon name="replay" size="16" />
        刷新状态
      </van-button>
      
      <van-button 
        type="default" 
        size="large"
        bind:click="contactHospital"
        custom-class="contact-btn"
      >
        <van-icon name="phone-o" size="16" />
        联系医院
      </van-button>
      
      <van-button 
        wx:if="{{queueInfo.status === 'waiting' || queueInfo.status === 'calling'}}"
        type="danger" 
        size="large"
        bind:click="cancelQueue"
        custom-class="cancel-btn"
      >
        <van-icon name="cross" size="16" />
        取消排队
      </van-button>
    </view>

    <!-- 温馨提示 -->
    <view class="notice-section">
      <view class="notice-header">
        <van-icon name="info-o" size="16" color="#ff9800" />
        <text class="notice-title">温馨提示</text>
      </view>
      
      <view class="notice-content">
        <view class="notice-item">• 请保持手机畅通，我们会及时通知您</view>
        <view class="notice-item">• 叫号后请在10分钟内前往诊室</view>
        <view class="notice-item">• 如需帮助，请联系现场工作人员</view>
        <view class="notice-item">• 排队时间仅供参考，实际时间可能有所差异</view>
      </view>
    </view>
  </view>
</view>