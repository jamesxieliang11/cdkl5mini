/* 家庭基础信息问卷 - 样式 */

/* ==================== 导航栏 ==================== */
.status-bar {
  height: var(--status-bar-height);
  background: #34BFA3;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #34BFA3;
  position: relative;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}

.nav-right-actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.nav-action {
  padding: 8rpx 12rpx;
  display: flex;
  align-items: center;
}

.save-draft-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

/* ==================== 进度条 ==================== */
.progress-section {
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.step-label {
  font-size: 24rpx;
  color: #34BFA3;
  font-weight: 600;
}

.step-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* ==================== 加载遮罩 ==================== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
}

/* ==================== 步骤容器 ==================== */
.step-container {
  padding: 24rpx 24rpx 200rpx;
  background: #f7f8fa;
  min-height: calc(100vh - 300rpx);
}

/* ==================== 卡片 ==================== */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* ==================== 表单元素 ==================== */
.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.form-label.required::before {
  content: '*';
  color: #ee0a24;
  margin-right: 6rpx;
  font-weight: 700;
}

/* ==================== 单选/多选 ==================== */
.radio-item {
  margin: 8rpx 16rpx 8rpx 0;
}

.checkbox-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.checkbox-item {
  margin: 6rpx 0;
  min-width: 45%;
}

/* ==================== van 组件覆盖 ==================== */
.van-cell-group {
  border-radius: 16rpx;
  overflow: hidden;
}

.van-field__label {
  color: #333 !important;
  font-weight: 500 !important;
}

.van-cell__title {
  color: #333 !important;
  font-weight: 500 !important;
}

.van-cell__value {
  color: #666 !important;
}

.van-cell[required] .van-cell__title::after {
  content: '*';
  color: #ee0a24;
  margin-left: 4rpx;
}

/* ==================== 底部按钮 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-prev {
  flex: 1;
  border-radius: 50rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 30rpx !important;
  color: #666 !important;
  border-color: #ddd !important;
}

.btn-next {
  flex: 2;
  border-radius: 50rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 30rpx !important;
  background: #34BFA3 !important;
  border-color: #34BFA3 !important;
}

.btn-submit {
  flex: 1;
  border-radius: 50rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  background: linear-gradient(135deg, #34BFA3 0%, #2dab92 100%) !important;
  border-color: #34BFA3 !important;
}

/* ==================== 上传组件 ==================== */
.van-uploader {
  padding: 12rpx 0;
}

/* ==================== 响应式调整 ==================== */
@media (max-width: 375px) {
  .step-container {
    padding: 16rpx 16rpx 200rpx;
  }

  .section-card {
    padding: 24rpx 16rpx;
  }

  .card-title {
    font-size: 30rpx;
  }

  .bottom-actions {
    padding: 16rpx 24rpx;
    padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  }
}

/* ==================== 未绑定提示 ==================== */
.no-questionnaire {
  padding: 24rpx;
}

.no-questionnaire-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.no-questionnaire-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-top: 24rpx;
}

.no-questionnaire-hint {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.6;
}

.no-questionnaire-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
