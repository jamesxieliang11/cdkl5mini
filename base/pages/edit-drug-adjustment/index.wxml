&lt;!-- 状态栏区域 --&gt;
&lt;view class=&quot;status-bar&quot;&gt;&lt;/view&gt;

&lt;view class=&quot;drug-adjustment-container&quot;&gt;
  &lt;!-- 头部信息 --&gt;
  &lt;view class=&quot;header-section&quot;&gt;
    &lt;view class=&quot;page-title&quot;&gt;调药记录&lt;/view&gt;
    &lt;view class=&quot;back-btn&quot; bindtap=&quot;goBack&quot;&gt;返回&lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 基础信息 --&gt;
  &lt;van-cell-group&gt;
    &lt;van-field
      label=&quot;记录时间&quot;
      readonly
      clickable
      value=&quot;{{formData.datetime}}&quot;
      placeholder=&quot;选择记录时间&quot;
      bind:click=&quot;showDateTimePicker&quot;
    /&gt;
    &lt;van-field
      label=&quot;体重(kg)&quot;
      type=&quot;digit&quot;
      value=&quot;{{formData.weight}}&quot;
      placeholder=&quot;请输入体重&quot;
      bind:blur=&quot;onWeightBlur&quot;
    /&gt;
  &lt;/van-cell-group&gt;

  &lt;!-- 药物列表 --&gt;
  &lt;view class=&quot;medicine-section&quot;&gt;
    &lt;view class=&quot;section-title&quot;&gt;
      &lt;text&gt;药物列表&lt;/text&gt;
      &lt;van-button size=&quot;mini&quot; type=&quot;primary&quot; bind:click=&quot;addMedicineItem&quot;&gt;添加药品&lt;/van-button&gt;
    &lt;/view&gt;
    
    &lt;view wx:for=&quot;{{formData.medicines}}&quot; wx:key=&quot;index&quot; class=&quot;medicine-item&quot;&gt;
      &lt;van-cell-group&gt;
        &lt;van-field
          label=&quot;服药时间&quot;
          readonly
          clickable
          value=&quot;{{item.takeTime}}&quot;
          placeholder=&quot;选择服药时间&quot;
          bind:click=&quot;showTakeTimePicker&quot;
          data-index=&quot;{{index}}&quot;
        /&gt;
        &lt;van-field
          label=&quot;药品名称&quot;
          value=&quot;{{item.name}}&quot;
          placeholder=&quot;请输入药品名称&quot;
          bind:input=&quot;onMedicineNameInput&quot;
          data-index=&quot;{{index}}&quot;
        /&gt;
        &lt;van-row&gt;
          &lt;van-col span=&quot;12&quot;&gt;
            &lt;van-field
              label=&quot;剂量&quot;
              type=&quot;number&quot;
              value=&quot;{{item.dosage}}&quot;
              placeholder=&quot;剂量&quot;
              bind:input=&quot;onDosageInput&quot;
              data-index=&quot;{{index}}&quot;
            /&gt;
          &lt;/van-col&gt;
          &lt;van-col span=&quot;12&quot;&gt;
            &lt;van-field
              label=&quot;单位&quot;
              value=&quot;{{item.unit}}&quot;
              placeholder=&quot;mg/ml/片&quot;
              bind:input=&quot;onUnitInput&quot;
              data-index=&quot;{{index}}&quot;
            /&gt;
          &lt;/van-col&gt;
        &lt;/van-row&gt;
      &lt;/van-cell-group&gt;
      &lt;view class=&quot;remove-btn&quot; bindtap=&quot;removeMedicine&quot; data-index=&quot;{{index}}&quot;&gt;删除&lt;/view&gt;
    &lt;/view&gt;
  &lt;/view&gt;

  &lt;!-- 副作用 --&gt;
  &lt;view class=&quot;side-effect-section&quot;&gt;
    &lt;view class=&quot;section-title&quot;&gt;副作用&lt;/view&gt;
    &lt;van-field
      type=&quot;textarea&quot;
      autosize
      rows=&quot;3&quot;
      maxlength=&quot;200&quot;
      value=&quot;{{formData.sideEffects}}&quot;
      placeholder=&quot;请描述出现的副作用（可选）&quot;
      bind:input=&quot;onSideEffectInput&quot;
    /&gt;
  &lt;/view&gt;

  &lt;!-- 提交按钮 --&gt;
  &lt;view class=&quot;submit-section&quot;&gt;
    &lt;van-button block type=&quot;primary&quot; bind:click=&quot;saveRecord&quot;&gt;保存记录&lt;/van-button&gt;
  &lt;/view&gt;
&lt;/view&gt;