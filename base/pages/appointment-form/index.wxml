<!-- 自定义导航栏 -->
<van-nav-bar
  title="义诊预约"
  left-arrow
  bind:click-left="onBack"
  custom-class="custom-nav-bar"
/>

<!--pages/appointment-form/index.wxml-->
<view class="appointment-form-container">
  <!-- 加载状态 -->
  <van-loading wx:if="{{loading}}" type="spinner" color="#1989fa" size="50rpx" vertical>
    加载中...
  </van-loading>

  <!-- 预约表单 -->
  <view wx:else class="form-content">
    <form bind:submit="submitForm">
      <!-- 患者信息 -->
      <view class="form-section">
        <view class="section-title">
          <van-icon name="user-o" size="18" color="#1989fa" />
          <text>患者信息</text>
        </view>
        
        <van-cell-group>
          <van-field
            value="{{formData.patientName}}"
            label="患者姓名"
            placeholder="请输入患者姓名"
            required
            bind:change="onPatientNameChange"
          />
          
          <van-field
            value="{{formData.patientAge}}"
            label="患者年龄"
            placeholder="请输入患者年龄"
            type="number"
            required
            bind:change="onPatientAgeChange"
          />
          
          <picker
            range="{{genderOptions}}"
            value="{{genderIndex}}"
            bind:change="onGenderChange"
          >
            <van-cell
              title="性别"
              value="{{formData.gender || '请选择性别'}}"
              is-link
              required
            />
          </picker>
        </van-cell-group>
      </view>

      <!-- 联系信息 -->
      <view class="form-section">
        <view class="section-title">
          <van-icon name="phone-o" size="18" color="#1989fa" />
          <text>联系信息</text>
        </view>
        
        <van-cell-group>
          <van-field
            value="{{formData.contactName}}"
            label="联系人姓名"
            placeholder="请输入联系人姓名"
            required
            bind:change="onContactNameChange"
          />
          
          <van-field
            value="{{formData.contactPhone}}"
            label="联系电话"
            placeholder="请输入手机号码"
            type="number"
            required
            bind:change="onContactPhoneChange"
          />
          
          <picker
            range="{{relationshipOptions}}"
            value="{{relationshipIndex}}"
            bind:change="onRelationshipChange"
          >
            <van-cell
              title="与患者关系"
              value="{{formData.relationship || '请选择关系'}}"
              is-link
              required
            />
          </picker>
        </van-cell-group>
      </view>

      <!-- 预约信息 -->
      <view class="form-section">
        <view class="section-title">
          <van-icon name="calendar-o" size="18" color="#1989fa" />
          <text>预约信息</text>
        </view>
        
        <van-cell-group>
          <picker
            range="{{departmentOptions}}"
            range-key="name"
            value="{{departmentIndex}}"
            bind:change="onDepartmentChange"
          >
            <van-cell
              title="就诊科室"
              value="{{formData.department ? formData.department.name : '请选择科室'}}"
              is-link
              required
            />
          </picker>
          
          <picker
            mode="date"
            value="{{formData.appointmentDate}}"
            start="{{minDate}}"
            end="{{maxDate}}"
            bind:change="onDateChange"
          >
            <van-cell
              title="预约日期"
              value="{{formData.appointmentDate || '请选择日期'}}"
              is-link
              required
            />
          </picker>
          
          <picker
            range="{{timeSlots}}"
            range-key="label"
            value="{{timeSlotIndex}}"
            bind:change="onTimeSlotChange"
          >
            <van-cell
              title="预约时段"
              value="{{formData.timeSlot ? formData.timeSlot.label : '请选择时段'}}"
              is-link
              required
            />
          </picker>
        </van-cell-group>
      </view>

      <!-- 症状描述 -->
      <view class="form-section">
        <view class="section-title">
          <van-icon name="description" size="18" color="#1989fa" />
          <text>症状描述</text>
        </view>
        
        <van-cell-group>
          <van-field
            value="{{formData.symptoms}}"
            label="主要症状"
            type="textarea"
            placeholder="请简要描述患者的主要症状和病史"
            autosize
            bind:change="onSymptomsChange"
          />
        </van-cell-group>
      </view>

      <!-- 提交按钮 -->
      <view class="form-actions">
        <van-button
          type="primary"
          size="large"
          loading="{{submitting}}"
          disabled="{{submitting}}"
          bind:click="submitForm"
        >
          {{submitting ? '提交中...' : '提交预约'}}
        </van-button>
      </view>
    </form>
  </view>
</view>