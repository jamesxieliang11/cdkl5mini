/* 状态栏 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

/* 自定义导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* Tab 内容区 */
.tab-content {
  padding: 24rpx;
  min-height: 60vh;
  background: #f5f5f5;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.form-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.form-row {
  margin-bottom: 16rpx;
}

.form-row-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-input {
  background: #f7f8fa !important;
  border-radius: 12rpx !important;
}

/* 列表卡片 */
.list-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.list-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

/* 话题列表项 */
.topic-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.topic-item:last-child {
  border-bottom: none;
}

.topic-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.topic-icon {
  font-size: 40rpx;
}

.topic-info {
  display: flex;
  flex-direction: column;
}

.topic-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.topic-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.topic-actions {
  flex-shrink: 0;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-item.active {
  background: #34BFA3;
  color: #fff;
}

/* 帖子列表项 */
.post-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.post-author {
  display: flex;
  align-items: center;
}

.post-nick {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

/* 操作栏 */
.post-actions-bar,
.comment-actions-bar {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  flex-wrap: wrap;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1989fa;
  background: #e8f4ff;
}

.action-btn.active {
  color: #ff976a;
  background: #fff3e8;
}

.action-btn.danger {
  color: #ee0a24;
  background: #ffeef0;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #34BFA3;
}

/* 通用 */
.loading-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}

.empty-box {
  padding: 40rpx 0;
}

.empty-text {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* 评论管理 - 帖子信息条 */
.comment-post-info {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.comment-post-label {
  font-size: 26rpx;
  color: #999;
}

.comment-post-nick {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.comment-post-id {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 8rpx;
}

/* 评论列表项 */
.comment-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.comment-nick {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-body {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.comment-reply-info {
  font-size: 22rpx;
  color: #1989fa;
  margin-bottom: 12rpx;
}
