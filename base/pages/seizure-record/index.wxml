<view class="seizure-record-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title-row">
      <van-icon name="wap-home-o" size="20" color="#34BFA3" bind:click="onBack" />
      <text class="header-title">{{isEditMode ? '编辑发作记录' : '发作记录'}}</text>
    </view>
    <view class="header-subtitle">{{isEditMode ? '修改发作记录的详细信息' : '详细记录癫痫发作情况和症状表现'}}</view>
  </view>

  <!-- 编辑模式提示 -->
  <van-notice-bar wx:if="{{isEditMode}}" 
    left-icon="info-o" 
    text="编辑模式：您正在修改现有的发作记录" 
    color="#1989fa" 
    background="#ecf5ff" 
    custom-class="edit-mode-notice" />

  <!-- 加载状态 -->
  <van-loading wx:if="{{loading}}" 
    type="spinner" 
    text-color="#969799" 
    vertical
    custom-class="loading-container">
    正在加载记录数据...
  </van-loading>

  <!-- 记录表单 -->
  <view class="form-container">
    <!-- 快捷选择历史记录 -->
    <van-cell-group wx:if="{{historyRecords.length > 0}}" title="快捷选择" custom-class="form-group">
      <van-cell 
        title="选择历史记录" 
        label="快速复制之前的发作记录（时间会更新为当前时间）"
        is-link
        bind:click="showHistoryPicker"
      />
    </van-cell-group>

    <!-- 基本信息 -->
    <van-cell-group title="基本信息" custom-class="form-group">
      <van-field
        label="记录时间"
        value="{{formData.datetime}}"
        placeholder="请选择记录时间"
        readonly
        is-link
        bind:click-input="showDateTimePicker"
      />
      <van-field
        label="发作类型"
        value="{{formData.seizureType}}"
        placeholder="请选择发作类型"
        readonly
        is-link
        bind:click-input="showSeizureTypePicker"
      />
      <van-field
        label="持续时间(min)"
        type="number"
        value="{{formData.duration}}"
        placeholder="请输入持续分钟数"
        bind:input="onDurationInput"
      />
    </van-cell-group>

    <!-- 发作详情 -->
    <van-cell-group title="发作详情" custom-class="form-group">
      <van-field
        label="诱发因素"
        value="{{formData.triggers}}"
        placeholder="睡眠不足、压力大等（可选）"
        bind:input="onTriggerInput"
      />
      <van-field
        label="症状表现"
        value="{{formData.symptoms}}"
        placeholder="请详细描述发作时的症状表现"
        type="textarea"
        autosize
        rows="4"
        maxlength="400"
        show-word-limit
        bind:input="onSymptomInput"
      />
    </van-cell-group>

    <!-- 相关图片 -->
    <van-cell-group title="相关图片" custom-class="form-group">
      <view class="image-upload-section">
        <view class="image-upload-tip">
          <text>可上传发作时的相关图片（如药物、环境等），最多{{maxImageCount}}张</text>
        </view>
        
        <!-- 图片列表 -->
        <view class="uploaded-images" wx:if="{{uploadedImages.length > 0}}">
          <view 
            class="image-item" 
            wx:for="{{uploadedImages}}" 
            wx:key="index"
            data-index="{{index}}"
            bind:tap="previewImage"
          >
            <image 
              src="{{item.tempFilePath || item.fileID}}" 
              mode="aspectFill"
              class="uploaded-image"
            />
            <view 
              class="delete-btn" 
              data-index="{{index}}"
              bind:tap="deleteImage"
              catch:tap="deleteImage"
            >
              <van-icon name="cross" size="12" color="#fff" />
            </view>
          </view>
        </view>

        <!-- 上传按钮 -->
        <view 
          class="upload-btn" 
          wx:if="{{uploadedImages.length < maxImageCount}}"
          bind:tap="uploadImages"
        >
          <van-icon name="plus" size="24" color="#999" />
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </van-cell-group>

    </view>

  <!-- 提交按钮 -->
  <view class="submit-container">
    <van-button 
      type="primary" 
      size="large" 
      bind:click="submitRecord"
      loading="{{submitting}}"
    >保存记录</van-button>
  </view>
</view>

<!-- Vant 时间选择器 -->

<!-- 日期时间选择器 -->
<van-popup show="{{showDatePicker}}" position="bottom" bind:close="onDateTimeCancel">
  <van-datetime-picker
    type="datetime"
    value="{{currentDate}}"
    bind:confirm="onDateTimeConfirm"
    bind:cancel="onDateTimeCancel"
    title="选择记录时间"
  />
</van-popup>

<!-- 发作类型选择器 -->
<van-action-sheet
  show="{{showSeizureTypePicker}}"
  actions="{{seizureTypeOptions}}"
  bind:select="onSeizureTypeSelect"
  bind:cancel="onSeizureTypeCancel"
  title="选择发作类型"
/>

<!-- 历史记录选择器 -->
<van-action-sheet
  show="{{showHistoryPicker}}"
  actions="{{historyOptions}}"
  bind:select="onHistorySelect"
  bind:cancel="onHistoryCancel"
  title="选择历史记录"
/>