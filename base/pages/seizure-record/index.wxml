<view class="seizure-record-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title-row">
      <van-icon name="wap-home-o" size="20" color="#34BFA3" bind:click="onBack" />
      <text class="header-title">发作记录</text>
    </view>
    <view class="header-subtitle">详细记录癫痫发作情况和症状表现</view>
  </view>

  <!-- 记录表单 -->
  <view class="form-container">
    <!-- 基本信息 -->
    <van-cell-group title="基本信息" custom-class="form-group">
      <van-field
        label="记录时间"
        value="{{formData.datetime}}"
        placeholder="请选择记录时间"
        readonly
        is-link
        bind:click-input="showDateTimePicker"
      />
      <van-field
        label="发作类型"
        value="{{formData.seizureType}}"
        placeholder="请选择发作类型"
        readonly
        is-link
        bind:click-input="showSeizureTypePicker"
      />
      <van-field
        label="持续时间(min)"
        type="number"
        value="{{formData.duration}}"
        placeholder="请输入持续分钟数"
        bind:input="onDurationInput"
      />
    </van-cell-group>

    <!-- 发作详情 -->
    <van-cell-group title="发作详情" custom-class="form-group">
      <van-field
        label="诱发因素"
        value="{{formData.triggers}}"
        placeholder="睡眠不足、压力大等（可选）"
        bind:input="onTriggerInput"
      />
      <van-field
        label="症状表现"
        value="{{formData.symptoms}}"
        placeholder="请详细描述发作时的症状表现"
        type="textarea"
        autosize
        rows="4"
        maxlength="400"
        show-word-limit
        bind:input="onSymptomInput"
      />
    </van-cell-group>

    <!-- 快捷选择历史记录 -->
    <van-cell-group wx:if="{{historyRecords.length > 0}}" title="快捷选择" custom-class="form-group">
      <van-cell 
        title="选择历史记录" 
        label="快速复制之前的发作记录（时间会更新为当前时间）"
        is-link
        bind:click="showHistoryPicker"
      />
    </van-cell-group>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-container">
    <van-button 
      type="primary" 
      size="large" 
      bind:click="submitRecord"
      loading="{{submitting}}"
    >保存记录</van-button>
  </view>
</view>

<!-- Vant 时间选择器 -->

<!-- 日期时间选择器 -->
<van-popup show="{{showDatePicker}}" position="bottom" bind:close="onDateTimeCancel">
  <van-datetime-picker
    type="datetime"
    value="{{currentDate}}"
    bind:confirm="onDateTimeConfirm"
    bind:cancel="onDateTimeCancel"
    title="选择记录时间"
  />
</van-popup>

<!-- 发作类型选择器 -->
<van-action-sheet
  show="{{showSeizureTypePicker}}"
  actions="{{seizureTypeOptions}}"
  bind:select="onSeizureTypeSelect"
  bind:cancel="onSeizureTypeCancel"
  title="选择发作类型"
/>

<!-- 历史记录选择器 -->
<van-action-sheet
  show="{{showHistoryPicker}}"
  actions="{{historyOptions}}"
  bind:select="onHistorySelect"
  bind:cancel="onHistoryCancel"
  title="选择历史记录"
/>