/* pages/seizure-record/index.wxss */

.seizure-record-container {
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  padding: 60rpx 40rpx 60rpx;
  color: white;
  text-align: center;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  margin: 0;
}

.header-subtitle {
  font-size: 30rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 40rpx 0;
}

.form-group {
  margin-bottom: 40rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 图片上传相关样式 */
.image-upload-section {
  padding: 28rpx 32rpx;
}

.image-upload-tip {
  margin-bottom: 20rpx;
}

.image-upload-tip text {
  font-size: 28rpx;
  color: #999;
  line-height: 1.5;
}

.uploaded-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* 适老化 - 图片缩略图放大 */
.image-item {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.3);
  z-index: 10;
}

/* 适老化 - 上传按钮放大 */
.upload-btn {
  width: 220rpx;
  height: 220rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  transition: all 0.3s ease;
}

.upload-btn:active {
  background: #f0f0f0;
  border-color: #bfbfbf;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 提交按钮 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 2rpx solid #f0f0f0;
  z-index: 100;
}

/* 适老化 - 提交按钮放大 */
.submit-container .van-button {
  border-radius: 50rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
  border: none;
  font-size: 36rpx;
  font-weight: 600;
}

/* 适老化 - Vant 组件字号放大 */
.van-cell-group__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx 32rpx 16rpx;
}

.van-field__label {
  font-size: 30rpx !important;
  font-weight: 500;
  color: #444 !important;
}

.van-field__input {
  font-size: 32rpx !important;
}

.van-field__textarea {
  font-size: 32rpx !important;
  min-height: 160rpx !important;
}

.van-field--textarea .van-field__input {
  min-height: 160rpx;
}

/* 适老化 - 选择器/Picker 点击区域放大 */
.van-cell {
  min-height: 88rpx !important;
  line-height: 1.5 !important;
}

.van-cell__title {
  font-size: 30rpx !important;
}

.van-cell__value {
  font-size: 30rpx !important;
}

/* 快捷选择区域 */
.quick-template-section {
  margin: 40rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 40rpx;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .form-container {
    padding: 30rpx 30rpx 0;
  }
  
  .header-title {
    font-size: 40rpx;
  }
  
  .submit-container {
    padding: 20rpx 30rpx;
  }

  .image-item,
  .upload-btn {
    width: 200rpx;
    height: 200rpx;
  }
  
  .uploaded-images {
    gap: 12rpx;
  }
}