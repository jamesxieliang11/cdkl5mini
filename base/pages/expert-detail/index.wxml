<view class="expert-detail-container">
  <!-- 专家头像和基本信息 -->
  <view class="expert-header">
    <view class="expert-avatar">
      <van-image
        width="120"
        height="120"
        radius="60"
        src="{{expertInfo.avatar || '/icons/default-avatar.png'}}"
        fit="cover"
      />
    </view>
    <view class="expert-basic">
      <view class="expert-name">{{expertInfo.name}}</view>
      <view class="expert-title">{{expertInfo.title}}</view>
      <view class="expert-hospital">{{expertInfo.hospital}}</view>
    </view>
  </view>

  <!-- 专业信息 -->
  <van-cell-group title="专业信息" custom-class="info-group">
    <van-cell 
      title="科室" 
      value="{{expertInfo.department}}"
      icon="manager-o"
    />
    <van-cell 
      title="职称" 
      value="{{expertInfo.position}}"
      icon="medal-o"
    />
    <van-cell 
      title="专业方向" 
      value="{{expertInfo.specialty}}"
      icon="star-o"
    />
    <van-cell 
      title="从业年限" 
      value="{{expertInfo.experience}}年"
      icon="clock-o"
    />
  </van-cell-group>

  <!-- 门诊信息 -->
  <van-cell-group title="门诊信息" custom-class="clinic-group">
    <van-cell 
      wx:for="{{expertInfo.clinicSchedule}}" 
      wx:key="day"
      title="{{item.day}}"
      label="{{item.time}}"
      value="{{item.location}}"
      icon="calendar-o"
    />
    <van-cell 
      title="预约电话" 
      value="{{expertInfo.phone}}"
      icon="phone-o"
      is-link
      bind:click="makeCall"
    />
  </van-cell-group>

  <!-- 研究方向 -->
  <view class="research-section">
    <van-divider>研究方向</van-divider>
    <view class="research-content">
      <view class="research-tags">
        <van-tag 
          wx:for="{{expertInfo.researchAreas}}" 
          wx:key="*this"
          type="primary" 
          size="medium"
          custom-class="research-tag"
        >
          {{item}}
        </van-tag>
      </view>
      <view class="research-desc">
        {{expertInfo.researchDescription}}
      </view>
    </view>
  </view>

  <!-- 学术成就 -->
  <van-cell-group title="学术成就" custom-class="achievement-group">
    <van-cell 
      wx:for="{{expertInfo.achievements}}" 
      wx:key="id"
      title="{{item.title}}"
      label="{{item.description}}"
      value="{{item.year}}"
      icon="trophy-o"
    />
  </van-cell-group>

  <!-- 相关议程 -->
  <view wx:if="{{relatedSchedules.length > 0}}" class="related-section">
    <van-divider>相关议程</van-divider>
    <van-cell-group custom-class="schedule-group">
      <van-cell 
        wx:for="{{relatedSchedules}}" 
        wx:key="id"
        title="{{item.title}}"
        label="{{item.time}} | {{item.location}}"
        icon="calendar-o"
        is-link
        bind:click="goToSchedule"
        data-id="{{item.id}}"
      />
    </van-cell-group>
  </view>

  <!-- 联系方式 -->
  <view class="contact-section">
    <van-divider>联系方式</van-divider>
    <view class="contact-buttons">
      <van-button 
        type="primary" 
        size="large" 
        icon="phone-o"
        bind:click="makeCall"
        custom-class="contact-btn"
      >
        电话咨询
      </van-button>
      <van-button 
        type="info" 
        size="large" 
        icon="chat-o"
        bind:click="sendMessage"
        custom-class="contact-btn"
      >
        在线咨询
      </van-button>
    </view>
  </view>

  <!-- 温馨提示 -->
  <view class="tips-section">
    <van-divider>温馨提示</van-divider>
    <view class="tips-content">
      <view class="tip-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>门诊时间可能因特殊情况调整，建议提前电话确认</text>
      </view>
      <view class="tip-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>初诊患者请携带相关检查报告和病历资料</text>
      </view>
      <view class="tip-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>如需预约义诊，请前往义诊预约页面</text>
      </view>
    </view>
  </view>
</view>