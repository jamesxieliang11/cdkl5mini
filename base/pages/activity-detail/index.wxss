.status-bar {
  height: var(--status-bar-height);
  background: var(--gradient-primary);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--gradient-primary);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

.locked-container,
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.page-container {
  min-height: 100vh;
  background: var(--color-bg, #f5f7fa);
  padding-bottom: 200rpx;
}

/* 头部卡片 */
.hero-card {
  background: var(--gradient-primary);
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
}

.hero-status {
  margin-bottom: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1.3;
  margin-bottom: 20rpx;
}

.hero-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 32rpx;
}

.hero-stats {
  display: flex;
  gap: 48rpx;
}

.hero-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-stat-value {
  font-size: 44rpx;
  font-weight: bold;
}

.hero-stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 内容区卡片 */
.section-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 参与者列表 */
.participants-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.participant-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.participant-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.participant-name {
  font-size: 22rpx;
  color: #666;
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部操作区 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.join-btn {
  height: 88rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.share-btn {
  background: none;
  border: none;
  color: var(--color-primary, #34BFA3);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  line-height: 2;
}

.share-btn::after {
  border: none;
}
