.status-bar {
  height: var(--status-bar-height);
  background: var(--gradient-primary);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--gradient-primary);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: #f5f5f5;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.filter-item.active {
  background: #34BFA3;
  color: #fff;
}

.loading-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-box {
  padding: 80rpx 0;
}

.feedback-list {
  padding: 0 24rpx 24rpx;
  background: #f5f5f5;
  min-height: 60vh;
}

.feedback-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.feedback-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.feedback-tags {
  display: flex;
  gap: 8rpx;
}

.feedback-time {
  font-size: 22rpx;
  color: #999;
}

.feedback-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.feedback-contact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.feedback-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.feedback-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.feedback-reply-box {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #34BFA3;
}

.reply-label {
  font-size: 24rpx;
  color: #34BFA3;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.reply-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.reply-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.feedback-actions {
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1989fa;
  background: #e8f4ff;
}

.reply-form {
  margin-top: 8rpx;
}

.reply-input {
  background: #f7f8fa !important;
  border-radius: 12rpx !important;
  margin-bottom: 16rpx;
}

.reply-form-btns {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #34BFA3;
}
