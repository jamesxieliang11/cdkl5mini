/* 管理员月度统计看板样式 */

.page-header {
  padding: 20rpx 30rpx 24rpx;
  background: var(--gradient-primary);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

/* 月份选择器 */
.month-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx;
  margin: 20rpx 30rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 加载 */
.loading-container {
  padding: 100rpx 0;
}

/* 统计容器 */
.stats-container {
  padding: 20rpx 30rpx 60rpx;
}

/* 卡片 */
.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.section-header.clickable {
  cursor: pointer;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

/* ========== 提交概览 ========== */
.overview-grid {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.overview-value.primary {
  color: #1989fa;
}

.overview-value.warning {
  color: #FF9800;
}

.overview-value.success {
  color: #07c160;
}

.overview-label {
  font-size: 22rpx;
  color: #999;
}

.rate-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 0;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}

.rate-label {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.progress-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1989fa, #07c160);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.rate-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1989fa;
  flex-shrink: 0;
}

/* ========== 排行列表 ========== */
.ranking-list {
  padding: 8rpx 0;
}

.ranking-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.ranking-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.ranking-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #666;
  font-size: 22rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ranking-item:first-child .ranking-index {
  background: #FF9800;
  color: #fff;
}

.ranking-item:nth-child(2) .ranking-index {
  background: #9E9E9E;
  color: #fff;
}

.ranking-item:nth-child(3) .ranking-index {
  background: #CD7F32;
  color: #fff;
}

.ranking-name {
  font-size: 28rpx;
  color: #333;
}

.ranking-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  margin-left: 20rpx;
}

.mini-bar-wrapper {
  flex: 1;
  height: 12rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  overflow: hidden;
}

.mini-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF9800, #FFB74D);
  border-radius: 6rpx;
  transition: width 0.5s ease;
  min-width: 4rpx;
}

.mini-bar-wrapper.green .mini-bar,
.mini-bar.green {
  background: linear-gradient(90deg, #4CAF50, #81C784);
}

.ranking-count {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 120rpx;
  text-align: right;
}

/* ========== 子区块 ========== */
.sub-section {
  padding-top: 16rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.stat-tag {
  margin: 4rpx;
}

.dosage-change-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF9800;
}

/* ========== 发作统计 ========== */
.seizure-overview {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.seizure-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.seizure-stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #EE6363;
}

.seizure-stat-label {
  font-size: 22rpx;
  color: #999;
}

.type-list {
  padding: 4rpx 0;
}

.type-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.type-name {
  font-size: 26rpx;
  color: #333;
}

.type-count {
  font-size: 26rpx;
  color: #EE6363;
  font-weight: 500;
}

/* ========== 里程碑统计 ========== */
.milestone-stats {
  padding: 4rpx 0;
}

.milestone-stat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.milestone-stat-left {
  flex-shrink: 0;
}

.milestone-stat-label {
  font-size: 26rpx;
  color: #333;
}

.milestone-stat-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  margin-left: 20rpx;
}

.milestone-stat-count {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
  min-width: 120rpx;
  text-align: right;
}

/* ========== 详细列表 ========== */
.detail-list {
  padding: 4rpx 0;
}

.detail-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.detail-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.detail-parent-name {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.detail-body {
  padding-left: 4rpx;
}

.detail-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.detail-info-item {
  font-size: 24rpx;
  color: #666;
}

.detail-meds {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.med-tag {
  margin: 2rpx;
}

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #999;
}

/* ========== 与上月对比 ========== */
.comparison-card {
  border-left: 6rpx solid #34BFA3;
}

.comparison-grid {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.comparison-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.comparison-value {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  color: #333;
}

.comparison-value.positive {
  color: #27ae60;
}

.comparison-value.negative {
  color: #e74c3c;
}

.comparison-label {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* ========== 用药柱状条 ========== */
.med-bar-list {
  padding: 8rpx 0;
}

.med-bar-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.med-bar-label {
  width: 150rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  color: #333;
}

.med-bar-track {
  flex: 1;
  height: 28rpx;
  background: #f0f0f0;
  border-radius: 14rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.med-bar-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 0.3s;
  min-width: 4rpx;
}

.med-bar-count {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
  width: 160rpx;
  text-align: right;
}

/* ========== 发作趋势颜色编码 ========== */
.trend-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.trend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #333;
}

.trend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.trend-item.trend-better {
  color: #27ae60;
}

.trend-item.trend-same {
  color: #f39c12;
}

.trend-item.trend-worse {
  color: #e74c3c;
}

/* ========== 里程碑排行榜 ========== */
.milestone-ranking {
  padding: 4rpx 0;
}

.milestone-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.milestone-rank {
  width: 48rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #34BFA3;
  text-align: center;
  flex-shrink: 0;
}

.milestone-label {
  width: 180rpx;
  font-size: 26rpx;
  flex-shrink: 0;
  color: #333;
}

.milestone-bar-track {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 12rpx;
}

.milestone-bar-fill {
  height: 100%;
  border-radius: 12rpx;
  min-width: 4rpx;
}

.milestone-count {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
  min-width: 60rpx;
  text-align: right;
}
