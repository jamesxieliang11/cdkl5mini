/* 状态栏 */
.status-bar {
  height: env(safe-area-inset-top, 44px);
  background: #fff;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.nav-back, .nav-action {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 主容器 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: calc(100vh - env(safe-area-inset-top, 44px) - 88rpx);
  background: #f5f6fa;
}

/* 免责声明横幅 */
.disclaimer-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #fff7e6;
  border-bottom: 1rpx solid #ffe4b5;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #e6a23c;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* 引导卡片 */
.guide-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.guide-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.guide-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 32rpx;
  padding: 0 16rpx;
}

/* 上传区域 */
.guide-upload {
  margin-bottom: 32rpx;
}

.upload-btn {
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #bbb;
}

/* 时间范围选择 */
.guide-time-range {
  margin-bottom: 32rpx;
  text-align: left;
}

.time-range-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  text-align: center;
}

.time-range-options {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.time-tag {
  padding: 8rpx 24rpx !important;
  border-radius: 24rpx !important;
}

.time-tag-active {
  font-weight: 600;
}

.generate-btn {
  width: 80% !important;
  margin: 0 auto;
}

/* 快捷问题 */
.quick-questions {
  text-align: left;
  margin-top: 16rpx;
}

.quick-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.quick-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #f8f9fc;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #555;
  transition: background 0.2s;
}

.quick-item:active {
  background: #eef0f5;
}

/* 消息气泡 */
.message-item {
  margin-bottom: 24rpx;
}

.message-bubble {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.user-bubble-wrap {
  justify-content: flex-end;
}

.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e3f2fd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.bubble-content {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
}

.ai-bubble {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.user-bubble {
  background: #34BFA3;
  color: #fff;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.user-bubble .message-text {
  color: #fff;
}

.message-image {
  max-width: 100%;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

/* 消息操作按钮 */
.message-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.action-btn:active {
  background: #f5f5f5;
}

/* 正在输入动画 */
.typing-indicator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #34BFA3;
  animation: typingBounce 1.4s infinite ease-in-out both;
}

.typing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 底部占位 */
.message-bottom-spacer {
  height: 20rpx;
}

/* 底部输入区 */
.input-area {
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding-bottom: env(safe-area-inset-bottom, 0);
}

.drug-warning {
  padding: 8rpx 24rpx;
  background: #fff3e0;
  text-align: center;
}

.drug-warning text {
  font-size: 22rpx;
  color: #e65100;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.input-upload-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0faf7;
  flex-shrink: 0;
}

.input-upload-btn:active {
  background: #d4f0e8;
}

.message-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}

.send-btn-active {
  background: #34BFA3;
}

.send-btn:active {
  opacity: 0.8;
}
