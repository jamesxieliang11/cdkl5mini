<view class="schedule-container">
  <!-- 搜索栏 -->
  <view class="search-section">
    <van-search
      value="{{searchKeyword}}"
      placeholder="搜索讲座、专家"
      bind:search="onSearch"
      bind:change="onSearchChange"
      show-action
      action-text="搜索"
    />
  </view>

  <!-- 日期标签页 -->
  <van-tabs active="{{activeTab}}" bind:change="onTabChange" sticky>
    <van-tab 
      wx:for="{{scheduleDays}}" 
      wx:key="date"
      title="{{item.title}}"
      name="{{item.date}}"
    >
      <!-- 搜索结果为空 -->
      <van-empty 
        wx:if="{{searchKeyword && filteredSchedules.length === 0}}"
        image="search" 
        description="未找到相关内容"
      />
      
      <!-- 议程列表 -->
      <view wx:else class="schedule-list">
        <view 
          wx:for="{{searchKeyword ? filteredSchedules : item.schedules}}" 
          wx:key="id"
          class="schedule-item"
        >
          <!-- 时间轴 -->
          <view class="timeline">
            <view class="time-dot {{item.status === 'ongoing' ? 'active' : ''}}"></view>
            <view class="time-line" wx:if="{{index < (searchKeyword ? filteredSchedules.length : item.schedules.length) - 1}}"></view>
          </view>

          <!-- 议程内容 -->
          <view class="schedule-content">
            <view class="schedule-header">
              <view class="time-info">
                <text class="time">{{item.time}}</text>
                <van-tag 
                  wx:if="{{item.status === 'ongoing'}}" 
                  type="success" 
                  size="small"
                >
                  进行中
                </van-tag>
                <van-tag 
                  wx:elif="{{item.status === 'upcoming'}}" 
                  type="primary" 
                  size="small"
                >
                  即将开始
                </van-tag>
                <van-tag 
                  wx:elif="{{item.status === 'finished'}}" 
                  type="default" 
                  size="small"
                >
                  已结束
                </van-tag>
              </view>
              
              <!-- 收藏按钮 -->
              <van-icon 
                name="{{item.isFavorite ? 'star' : 'star-o'}}" 
                size="20" 
                color="{{item.isFavorite ? '#ffd21e' : '#c8c9cc'}}"
                bind:click="toggleFavorite"
                data-id="{{item.id}}"
                class="favorite-icon"
              />
            </view>

            <view class="schedule-title" bind:tap="goToDetail" data-id="{{item.id}}">
              {{item.title}}
            </view>
            
            <view class="schedule-meta">
              <view class="speaker" bind:tap="goToExpertDetail" data-expert="{{item.speaker}}">
                <van-icon name="contact" size="14" color="#969799" />
                <text>{{item.speaker}}</text>
              </view>
              <view class="location">
                <van-icon name="location-o" size="14" color="#969799" />
                <text>{{item.location}}</text>
              </view>
            </view>

            <!-- 议程描述 -->
            <view wx:if="{{item.description}}" class="schedule-desc">
              {{item.description}}
            </view>

            <!-- 重点标记 -->
            <view wx:if="{{item.isHighlight}}" class="highlight-mark">
              <van-tag type="warning" size="small">重点关注</van-tag>
            </view>
          </view>
        </view>
      </view>
    </van-tab>
  </van-tabs>

  <!-- 我的收藏浮动按钮 -->
  <view class="floating-btn" bind:tap="showFavorites">
    <van-icon name="star" size="24" color="white" />
    <view class="btn-text">收藏</view>
    <view wx:if="{{favoriteCount > 0}}" class="badge">{{favoriteCount}}</view>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />