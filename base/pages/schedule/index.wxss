/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

.schedule-container {
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 搜索栏优化 */
.search-section {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
  padding: 30rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
}

.search-section::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #1989fa, #64b5f6);
  border-radius: 2rpx;
}

/* 议程列表优化 */
.schedule-list {
  padding: 40rpx 40rpx 40rpx;
  position: relative;
}

.schedule-item {
  display: flex;
  margin-bottom: 50rpx;
  position: relative;
  animation: slideInLeft 0.6s ease-out;
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-30rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 时间轴优化 */
.timeline {
  width: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  position: relative;
}

.time-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e0e0e0 0%, #bdbdbd 100%);
  border: 6rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  z-index: 3;
  position: relative;
  transition: all 0.3s ease;
}

.time-dot::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: white;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.time-dot.active {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.4);
  animation: pulse 2s infinite;
}

.time-dot.active::before {
  opacity: 1;
}

@keyframes pulse {
  0% { box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.4); }
  50% { box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.6), 0 0 0 10rpx rgba(25, 137, 250, 0.1); }
  100% { box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.4); }
}

.time-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(180deg, #e3f2fd 0%, #bbdefb 100%);
  margin-top: 16rpx;
  border-radius: 2rpx;
  position: relative;
}

.time-line::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 30%;
  background: linear-gradient(180deg, #1989fa 0%, transparent 100%);
  border-radius: 2rpx;
}

/* 议程内容卡片优化 */
.schedule-content {
  flex: 1;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid transparent;
}

.schedule-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #1989fa, #64b5f6, #42a5f5);
  border-radius: 24rpx 24rpx 0 0;
}

.schedule-content:active {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  border-color: rgba(25, 137, 250, 0.2);
}

/* 议程头部优化 */
.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.time-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time {
  font-size: 32rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #1989fa, #1976d2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.favorite-icon {
  padding: 16rpx;
  margin: -16rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.favorite-icon:active {
  background: rgba(25, 137, 250, 0.1);
  transform: scale(1.2);
}

/* 议程标题优化 */
.schedule-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 24rpx;
  position: relative;
}

/* 议程元信息优化 */
.schedule-meta {
  display: flex;
  gap: 40rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.speaker,
.location {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #646566;
  padding: 8rpx 16rpx;
  background: rgba(25, 137, 250, 0.05);
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.speaker {
  color: #1989fa;
  background: rgba(25, 137, 250, 0.1);
  font-weight: 600;
}

.speaker:active {
  background: rgba(25, 137, 250, 0.2);
  transform: scale(0.95);
}

/* 议程描述优化 */
.schedule-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(248, 249, 250, 0.8);
  border-radius: 16rpx;
  border-left: 4rpx solid #1989fa;
}

/* 重点标记优化 */
.highlight-mark {
  margin-top: 20rpx;
}

/* 浮动按钮优化 */
.floating-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(25, 137, 250, 0.4);
  z-index: 1000;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  animation: float 3s ease-in-out infinite;
}

.floating-btn::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
  background: linear-gradient(135deg, #1989fa, #1976d2);
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.floating-btn:active {
  transform: scale(0.9);
  box-shadow: 0 8rpx 24rpx rgba(25, 137, 250, 0.6);
}

.floating-btn:active::before {
  opacity: 0.2;
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10rpx); }
}

.btn-text {
  font-size: 22rpx;
  color: white;
  margin-top: 6rpx;
  font-weight: 600;
}

/* 徽章优化 */
.badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: linear-gradient(135deg, #ff4757, #ff3742);
  color: white;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
  border-radius: 24rpx;
  min-width: 40rpx;
  text-align: center;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.4);
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(-6rpx); }
  60% { transform: translateY(-3rpx); }
}

/* 标签页样式优化 */
.van-tabs__nav {
  background: white;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.van-tab {
  font-weight: 600;
  transition: all 0.3s ease;
}

.van-tab--active {
  color: #1989fa;
  font-weight: 700;
}

/* 搜索结果高亮优化 */
.search-highlight {
  background: linear-gradient(135deg, #fff3cd, #ffeaa7);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .schedule-list {
    padding: 30rpx 30rpx 30rpx;
  }
  
  .schedule-content {
    padding: 30rpx;
  }
  
  .floating-btn {
    right: 30rpx;
    bottom: 140rpx;
    width: 120rpx;
    height: 120rpx;
  }
  
  .schedule-meta {
    flex-direction: column;
    gap: 16rpx;
  }
  
  .search-section {
    padding: 25rpx 30rpx;
  }
}