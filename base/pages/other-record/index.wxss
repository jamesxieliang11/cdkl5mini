/* pages/other-record/index.wxss */

.other-record-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  color: white;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  margin: 0;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 30rpx;
}

.form-group {
  margin-bottom: 40rpx !important;
  border-radius: 16rpx !important;
  overflow: hidden !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08) !important;
}

/* 提交按钮 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx;
  background: white;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* Vant 组件样式覆盖 */
.van-field__label {
  color: #333 !important;
  font-weight: 500 !important;
}

.van-field__value {
  color: #666 !important;
}

.van-field--readonly .van-field__value {
  color: #999 !important;
}

.van-cell-group__title {
  color: #333 !important;
  font-weight: 600 !important;
  font-size: 32rpx !important;
  padding: 0 0 20rpx 0 !important;
}

/* 选择器弹窗样式 */
.van-popup {
  border-radius: 24rpx 24rpx 0 0 !important;
}

.van-datetime-picker__toolbar {
  border-bottom: 1rpx solid #eee !important;
}

.van-action-sheet__header {
  font-weight: 600 !important;
  color: #333 !important;
}

.van-action-sheet__item {
  font-size: 32rpx !important;
}

/* 图片上传样式 */
.image-upload-section {
  padding: 20rpx;
}

.image-upload-tips {
  margin-bottom: 20rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #666;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-actions {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

.delete-icon {
  color: #ff4444;
  font-size: 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  padding: 4rpx;
}

.image-upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #666;
}

.upload-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  color: #666;
}

.status-text {
  margin-left: 12rpx;
  font-size: 28rpx;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .page-header {
    padding: 50rpx 30rpx 30rpx;
  }
  
  .header-title {
    font-size: 44rpx;
  }
  
  .form-container {
    padding: 30rpx 20rpx;
  }
  
  .image-item,
  .image-upload-btn {
    width: 140rpx;
    height: 140rpx;
  }
}