/* pages/other-record/index.wxss */

.other-record-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 页面标题 */
.page-header {
  background: var(--gradient-primary);
  padding: 60rpx 40rpx 40rpx;
  color: white;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: var(--font-h1);
  font-weight: bold;
  margin: 0;
}

.header-subtitle {
  font-size: 30rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 30rpx;
}

.form-group {
  margin-bottom: 40rpx !important;
  border-radius: 16rpx !important;
  overflow: hidden !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08) !important;
}

/* 适老化 - 提交按钮放大 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: white;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.submit-container .van-button {
  height: 96rpx !important;
  font-size: 36rpx !important;
  font-weight: 600;
  border-radius: var(--radius-pill);
  background: var(--gradient-primary);
  border: none;
}

/* 适老化 - Vant 组件字号放大 */
.van-field__label {
  font-size: 30rpx !important;
  color: #444 !important;
  font-weight: 500 !important;
}

.van-field__value {
  color: #666 !important;
  font-size: 30rpx !important;
}

.van-field--readonly .van-field__value {
  color: #999 !important;
}

.van-cell-group__title {
  color: #333 !important;
  font-weight: 600 !important;
  font-size: 34rpx !important;
  padding: 0 0 20rpx 0 !important;
}

/* 选择器弹窗样式 */
.van-popup {
  border-radius: 24rpx 24rpx 0 0 !important;
}

.van-datetime-picker__toolbar {
  border-bottom: 1rpx solid #eee !important;
}

.van-action-sheet__header {
  font-weight: 600 !important;
  color: #333 !important;
}

.van-action-sheet__item {
  font-size: 32rpx !important;
}

.van-field__input {
  font-size: 32rpx !important;
}

.van-field__textarea {
  font-size: 32rpx !important;
  min-height: 160rpx !important;
}

/* 适老化 - 选择器/Picker 点击区域放大 */
.van-cell {
  min-height: 88rpx !important;
  line-height: 1.5 !important;
}

.van-cell__title {
  font-size: 30rpx !important;
}

.van-cell__value--alone {
  font-size: 30rpx !important;
}

/* 适老化 - 图片上传样式 */
.image-upload-section {
  padding: 28rpx;
}

.image-upload-tips {
  margin-bottom: 20rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #666;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

/* 适老化 - 图片缩略图放大 */
.image-item {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-actions {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

.delete-icon {
  color: #ff4444;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  padding: 6rpx;
}

/* 适老化 - 上传按钮放大 */
.image-upload-btn {
  width: 220rpx;
  height: 220rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #666;
}

.upload-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  color: #666;
}

.status-text {
  margin-left: 12rpx;
  font-size: 28rpx;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .page-header {
    padding: 50rpx 30rpx 30rpx;
  }
  
  .header-title {
    font-size: 44rpx;
  }
  
  .form-container {
    padding: 30rpx 20rpx;
  }
  
  .image-item,
  .image-upload-btn {
    width: 200rpx;
    height: 200rpx;
  }
}