/* pages/other-record/index.wxss */

.other-record-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  color: white;
}

.header-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  margin: 0;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 30rpx;
}

.form-group {
  margin-bottom: 40rpx !important;
  border-radius: 16rpx !important;
  overflow: hidden !important;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08) !important;
}

/* 提交按钮 */
.submit-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 40rpx;
  background: white;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* Vant 组件样式覆盖 */
.van-field__label {
  color: #333 !important;
  font-weight: 500 !important;
}

.van-field__value {
  color: #666 !important;
}

.van-field--readonly .van-field__value {
  color: #999 !important;
}

.van-cell-group__title {
  color: #333 !important;
  font-weight: 600 !important;
  font-size: 32rpx !important;
  padding: 0 0 20rpx 0 !important;
}

/* 选择器弹窗样式 */
.van-popup {
  border-radius: 24rpx 24rpx 0 0 !important;
}

.van-datetime-picker__toolbar {
  border-bottom: 1rpx solid #eee !important;
}

.van-action-sheet__header {
  font-weight: 600 !important;
  color: #333 !important;
}

.van-action-sheet__item {
  font-size: 32rpx !important;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .page-header {
    padding: 50rpx 30rpx 30rpx;
  }
  
  .header-title {
    font-size: 44rpx;
  }
  
  .form-container {
    padding: 30rpx 20rpx;
  }
}