<view class="other-record-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title-row">
      <van-icon name="arrow-left" size="20" color="#fff" bind:click="onBack" />
      <text class="header-title">{{isEditMode ? '编辑其他记录' : '其他记录'}}</text>
    </view>
    <view class="header-subtitle">{{isEditMode ? '修改其他记录的详细信息' : '记录日常观察和特殊事件'}}</view>
  </view>

  <!-- 编辑模式提示 -->
  <van-notice-bar wx:if="{{isEditMode}}" 
    left-icon="info-o" 
    text="编辑模式：您正在修改现有的其他记录" 
    color="#1989fa" 
    background="#ecf5ff" 
    custom-class="edit-mode-notice" />

  <!-- 加载状态 -->
  <van-loading wx:if="{{loading}}" 
    type="spinner" 
    text-color="#969799" 
    vertical
    custom-class="loading-container">
    正在加载记录数据...
  </van-loading>

  <!-- 记录表单 -->
  <view class="form-container">
    <!-- 快捷选择历史记录 -->
    <van-cell-group wx:if="{{historyRecords.length > 0}}" title="快捷选择" custom-class="form-group">
      <van-cell 
        title="选择历史记录" 
        label="快速复制之前的记录内容（时间会更新为当前时间）"
        is-link
        bind:click="showHistoryPicker"
      />
    </van-cell-group>

    <!-- 基本信息 -->
    <van-cell-group title="基本信息" custom-class="form-group">
      <van-field
        label="记录时间"
        value="{{formData.datetime}}"
        placeholder="请选择记录时间"
        readonly
        is-link
        bind:click-input="showDateTimePicker"
      />
      <van-field
        label="记录类别"
        value="{{formData.category}}"
        placeholder="请选择记录类别"
        readonly
        is-link
        bind:click-input="showCategoryPicker"
      />
    </van-cell-group>

    <!-- 记录详情 -->
    <van-cell-group title="记录详情" custom-class="form-group">
      <van-field
        label="记录内容"
        value="{{formData.content}}"
        placeholder="请详细记录相关内容"
        type="textarea"
        autosize
        rows="4"
        maxlength="600"
        show-word-limit
        bind:input="onContentInput"
      />
      <van-field
        label="备注信息"
        value="{{formData.remark}}"
        placeholder="补充说明（可选）"
        type="textarea"
        autosize
        rows="2"
        maxlength="100"
        show-word-limit
        bind:input="onRemarkInput"
      />
    </van-cell-group>

    <!-- 图片上传 -->
    <van-cell-group title="相关图片" custom-class="form-group">
      <view class="image-upload-section">
        <view class="image-upload-tips">
          <text class="tips-text">支持上传相关图片（最多{{maxImageCount}}张）</text>
        </view>
        
        <view class="image-list">
          <!-- 已上传的图片 -->
          <view 
            class="image-item" 
            wx:for="{{formData.images}}" 
            wx:key="fileID"
            wx:for-index="index"
          >
            <image 
              class="uploaded-image" 
              src="{{item.tempFilePath || item.fileID}}" 
              mode="aspectFill"
              bind:tap="previewImage"
              data-index="{{index}}"
            />
            <view class="image-actions">
              <van-icon 
                name="delete" 
                class="delete-icon" 
                bind:tap="deleteImage"
                data-index="{{index}}"
              />
            </view>
          </view>
          
          <!-- 上传按钮 -->
          <view 
            class="image-upload-btn" 
            wx:if="{{formData.images.length < maxImageCount}}"
            bind:tap="chooseImages"
          >
            <van-icon name="plus" class="upload-icon" />
            <text class="upload-text">添加图片</text>
          </view>
        </view>
        
        <!-- 上传状态 -->
        <view class="upload-status" wx:if="{{uploadingImages}}">
          <van-loading size="24px" />
          <text class="status-text">上传中...</text>
        </view>
      </view>
    </van-cell-group>

    </view>

  <!-- 提交按钮 -->
  <view class="submit-container">
    <van-button 
      type="primary" 
      size="large" 
      bind:click="submitRecord"
      loading="{{submitting}}"
    >保存记录</van-button>
  </view>
</view>

<!-- Vant 时间选择器 -->

<!-- 日期时间选择器 -->
<van-popup show="{{showDatePicker}}" position="bottom" bind:close="onDateTimeCancel">
  <van-datetime-picker
    type="datetime"
    value="{{currentDate}}"
    bind:confirm="onDateTimeConfirm"
    bind:cancel="onDateTimeCancel"
    title="选择记录时间"
  />
</van-popup>

<!-- 记录类别选择器 -->
<van-action-sheet
  show="{{showCategoryPicker}}"
  actions="{{categoryOptions}}"
  bind:select="onCategorySelect"
  bind:close="onCategoryCancel"
  title="选择记录类别"
/>

<!-- 历史记录选择器 -->
<van-action-sheet
  show="{{showHistoryPicker}}"
  actions="{{historyOptions}}"
  bind:select="onHistorySelect"
  bind:close="onHistoryCancel"
  title="选择历史记录"
/>

<!-- 打卡成功弹窗 -->
<checkin-success
  show="{{showCheckin}}"
  record-type="other"
  streak="{{checkinStreak}}"
  today-count="{{checkinTodayCount}}"
  total-days="{{checkinTotalDays}}"
  bind:close="onCheckinClose"
  bind:share="onCheckinShare"
/>

<!-- 打卡海报 -->
<share-poster
  wx:if="{{showCheckinPoster}}"
  type="checkin"
  post-data="{{checkinPosterData}}"
  bind:close="onCheckinPosterClose"
  bind:saved="onCheckinPosterSaved"
/>