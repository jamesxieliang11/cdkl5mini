.status-bar {
  height: var(--status-bar-height);
  background: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.locked-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.page-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 180rpx;
}

/* 活动横幅 */
.activity-scroll {
  white-space: nowrap;
  padding: 16rpx;
  background: #fff;
}

.activity-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  padding: 20rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #34BFA3 0%, #2da88e 100%);
  color: #fff;
  position: relative;
  vertical-align: top;
}

.activity-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  align-self: flex-start;
  margin-bottom: 12rpx;
}

.activity-title {
  font-size: 28rpx;
  font-weight: 600;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.activity-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 20rpx;
  opacity: 0.85;
}

.activity-card:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 话题滚动栏 */
.topic-scroll {
  white-space: nowrap;
  padding: 16rpx 16rpx;
  background: #fff;
}

.topic-tab {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

.topic-active {
  background: #333;
  color: #fff;
}

.topic-icon {
  margin-right: 4rpx;
}

/* ========== 双列瀑布流 ========== */
.waterfall {
  display: flex;
  padding: 12rpx;
  gap: 12rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 卡片 */
.feed-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

/* 置顶角标 */
.feed-pin {
  position: absolute;
  top: 0;
  left: 0;
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx 0 12rpx 0;
  z-index: 2;
}

/* 封面图 */
.feed-cover {
  width: 100%;
  display: block;
  border-radius: 16rpx 16rpx 0 0;
}

/* 内容区 */
.feed-body {
  padding: 16rpx 16rpx 8rpx;
}

.feed-topic {
  font-size: 22rpx;
  color: #34BFA3;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.feed-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 底部用户行 */
.feed-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx 14rpx;
}

.feed-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.feed-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.feed-avatar-fallback {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.feed-name {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.feed-like-count {
  font-size: 22rpx;
  color: #bbb;
}

.feed-like-count.liked {
  color: #FF6B6B;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* FAB 发帖按钮 */
.fab-button {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(52, 191, 163, 0.45);
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.92);
}
