.status-bar {
  height: var(--status-bar-height);
  background: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-back {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder {
  width: 80rpx;
}

.page-container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 话题滚动栏 */
.topic-scroll {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.topic-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s ease;
}

.topic-active {
  background: linear-gradient(135deg, #34BFA3, #2da88e);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(52, 191, 163, 0.3);
}

.topic-icon {
  margin-right: 6rpx;
}

/* 帖子列表 */
.post-list {
  padding: 20rpx 24rpx;
}

.post-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.pin-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
}

/* 用户信息 */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.post-user-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.post-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

/* 帖子内容 */
.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
  word-break: break-all;
}

/* 图片预览 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.post-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.post-image.single-image {
  width: 400rpx;
  height: 300rpx;
}

.image-more {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

/* 话题标签 */
.post-topic-tag {
  margin-bottom: 16rpx;
}

/* 底部操作栏 */
.post-footer {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-count {
  font-size: 24rpx;
  color: #999;
}

.action-count.liked {
  color: #34BFA3;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* 浮动发帖按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #34BFA3, #2da88e);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(52, 191, 163, 0.4);
  z-index: 100;
  transition: transform 0.2s ease;
}

.fab-button:active {
  transform: scale(0.9);
}
