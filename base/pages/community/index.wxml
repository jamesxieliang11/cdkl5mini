<!-- 状态栏区域 -->
<view class="status-bar"></view>
<view class="nav-bar">
  <view class="nav-title">希舞社区</view>
</view>

<!-- 功能未开放占位 -->
<view wx:if="{{locked}}" class="locked-container">
  <van-empty description="社区功能即将开放，敬请期待" image="search" />
</view>

<view class="page-container" wx:if="{{!locked}}">
  <!-- 活动横幅 -->
  <scroll-view wx:if="{{activities.length > 0}}" class="activity-scroll" scroll-x enable-flex>
    <view
      wx:for="{{activities}}"
      wx:key="_id"
      class="activity-card"
      bindtap="goToActivity"
      data-id="{{item._id}}"
    >
      <view class="activity-badge">
        <van-icon name="fire-o" size="12px" color="#fff" />
        <text>活动</text>
      </view>
      <view class="activity-title">{{item.title}}</view>
      <view class="activity-meta">
        <text class="activity-count">{{item.participant_count || 0}}人参与</text>
        <text class="activity-time">{{item.displayTime}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 话题横向滚动栏 -->
  <scroll-view class="topic-scroll" scroll-x enable-flex>
    <view
      class="topic-tab {{selectedTopicId === '' ? 'topic-active' : ''}}"
      bindtap="onTopicSelect"
      data-topic-id=""
    >全部</view>
    <view
      wx:for="{{topics}}"
      wx:key="_id"
      class="topic-tab {{selectedTopicId === item._id ? 'topic-active' : ''}}"
      bindtap="onTopicSelect"
      data-topic-id="{{item._id}}"
    >
      <text class="topic-icon">{{item.icon}}</text>
      <text>{{item.title}}</text>
    </view>
  </scroll-view>

  <!-- 双列瀑布流 -->
  <view class="waterfall" wx:if="{{posts.length > 0}}">
    <!-- 左列 -->
    <view class="waterfall-column">
      <view
        wx:for="{{leftPosts}}"
        wx:key="_id"
        class="feed-card"
        bindtap="goToDetail"
        bindlongpress="onPostLongPress"
        data-post-id="{{item._id}}"
        data-user-id="{{item.user_id}}"
        data-index="{{item._originalIndex}}"
      >
        <!-- 置顶角标 -->
        <view class="feed-pin" wx:if="{{item.is_pinned}}">置顶</view>

        <!-- 封面图 -->
        <image
          wx:if="{{item.images && item.images.length > 0}}"
          class="feed-cover"
          src="{{item.images[0].fileID}}"
          mode="widthFix"
          lazy-load
        />

        <!-- 内容区 -->
        <view class="feed-body">
          <view class="feed-topic" wx:if="{{item.topicTitle}}"># {{item.topicTitle}}</view>
          <view class="feed-text">{{item.content}}</view>
        </view>

        <!-- 底部：用户 + 点赞 -->
        <view class="feed-footer">
          <view class="feed-user">
            <image wx:if="{{!item.is_anonymous && item.avatar_url}}" class="feed-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
            <view wx:else class="feed-avatar-fallback" style="background:{{item.avatarColor}}">{{item.avatarChar}}</view>
            <text class="feed-name">{{item.displayName}}</text>
          </view>
          <view class="feed-like" catchtap="onLikePost" data-post-id="{{item._id}}" data-index="{{item._originalIndex}}">
            <van-icon name="{{item.isLiked ? 'good-job' : 'good-job-o'}}" size="14" color="{{item.isLiked ? '#FF6B6B' : '#bbb'}}" />
            <text class="feed-like-count {{item.isLiked ? 'liked' : ''}}">{{item.like_count || ''}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 右列 -->
    <view class="waterfall-column">
      <view
        wx:for="{{rightPosts}}"
        wx:key="_id"
        class="feed-card"
        bindtap="goToDetail"
        bindlongpress="onPostLongPress"
        data-post-id="{{item._id}}"
        data-user-id="{{item.user_id}}"
        data-index="{{item._originalIndex}}"
      >
        <!-- 置顶角标 -->
        <view class="feed-pin" wx:if="{{item.is_pinned}}">置顶</view>

        <!-- 封面图 -->
        <image
          wx:if="{{item.images && item.images.length > 0}}"
          class="feed-cover"
          src="{{item.images[0].fileID}}"
          mode="widthFix"
          lazy-load
        />

        <!-- 内容区 -->
        <view class="feed-body">
          <view class="feed-topic" wx:if="{{item.topicTitle}}"># {{item.topicTitle}}</view>
          <view class="feed-text">{{item.content}}</view>
        </view>

        <!-- 底部：用户 + 点赞 -->
        <view class="feed-footer">
          <view class="feed-user">
            <image wx:if="{{!item.is_anonymous && item.avatar_url}}" class="feed-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
            <view wx:else class="feed-avatar-fallback" style="background:{{item.avatarColor}}">{{item.avatarChar}}</view>
            <text class="feed-name">{{item.displayName}}</text>
          </view>
          <view class="feed-like" catchtap="onLikePost" data-post-id="{{item._id}}" data-index="{{item._originalIndex}}">
            <van-icon name="{{item.isLiked ? 'good-job' : 'good-job-o'}}" size="14" color="{{item.isLiked ? '#FF6B6B' : '#bbb'}}" />
            <text class="feed-like-count {{item.isLiked ? 'liked' : ''}}">{{item.like_count || ''}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && posts.length > 0 && !loading}}">
    <text>— 没有更多了 —</text>
  </view>

  <!-- 空状态 -->
  <van-empty wx:if="{{!loading && posts.length === 0}}" description="还没有帖子，快来发第一帖吧~" image="search" />

  <!-- 浮动发帖按钮 -->
  <view class="fab-button" bindtap="goToPost">
    <van-icon name="plus" size="22" color="#fff" />
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />
