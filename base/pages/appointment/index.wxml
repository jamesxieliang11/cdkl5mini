<!-- 状态栏区域 -->
<view class="status-bar"></view>

<view class="appointment-container">
  <!-- 重要提示 -->
  <van-notice-bar
    left-icon="info-o"
    text="义诊时间：3月15-16日 09:00-17:00，请提前预约并按时到场"
    background="#fff7cc"
    color="#ed6a0c"
  />

  <!-- 我的预约状态 -->
  <view wx:if="{{myAppointment}}" class="my-appointment">
    <van-cell-group title="我的预约" custom-class="appointment-group">
      <van-cell 
        title="{{myAppointment.department}}"
        label="预约时间：{{myAppointment.appointmentTime}}"
        value="排队号：{{myAppointment.queueNumber}}"
        icon="calendar-o"
        border="{{false}}"
      >
        <view slot="right-icon" class="appointment-status">
          <van-tag 
            type="{{myAppointment.status === 'waiting' ? 'primary' : myAppointment.status === 'calling' ? 'success' : 'default'}}"
            size="large"
          >
            {{getStatusText(myAppointment.status)}}
          </van-tag>
        </view>
      </van-cell>
      
      <view class="appointment-actions">
        <van-button 
          type="info" 
          size="small"
          bind:click="checkQueue"
        >
          查看排队
        </van-button>
        <van-button 
          type="default" 
          size="small"
          bind:click="cancelAppointment"
        >
          取消预约
        </van-button>
        <van-button 
          wx:if="{{myAppointment.status === 'waiting'}}"
          type="primary" 
          size="small"
          bind:click="contactSocialWorker"
        >
          联系社工
        </van-button>
      </view>
    </van-cell-group>
  </view>

  <!-- 义诊科室选择 -->
  <view class="departments-section">
    <van-cell-group title="选择义诊科室" custom-class="departments-group">
      <van-grid column-num="2" border="{{false}}" gutter="20">
        <van-grid-item 
          wx:for="{{departments}}" 
          wx:key="id"
          bind:click="selectDepartment"
          data-department="{{item}}"
          custom-class="department-item"
        >
          <view class="department-content">
            <van-icon name="{{item.icon}}" size="40" color="{{item.color}}" />
            <view class="department-name">{{item.name}}</view>
            <view class="department-info">
              <view class="doctor-info">{{item.doctor}}</view>
              <view class="time-info">{{item.time}}</view>
              <view class="queue-info">
                <van-tag 
                  type="{{item.queueCount > 20 ? 'danger' : item.queueCount > 10 ? 'warning' : 'success'}}"
                  size="small"
                >
                  排队{{item.queueCount}}人
                </van-tag>
              </view>
            </view>
          </view>
        </van-grid-item>
      </van-grid>
    </van-cell-group>
  </view>

  <!-- 义诊须知 -->
  <view class="notice-section">
    <van-divider>义诊须知</van-divider>
    <view class="notice-content">
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>请携带患儿身份证或户口本、既往检查报告</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>义诊时间为3月15-16日，每日09:00-17:00</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>建议提前30分钟到场，现场扫码签到</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>如需住院协调，可联系"小马甲"义工</text>
      </view>
    </view>
  </view>

  <!-- 紧急联系 -->
  <view class="emergency-section">
    <van-divider>紧急联系</van-divider>
    <van-cell-group custom-class="emergency-group">
      <van-cell 
        title="义诊咨询热线" 
        value="400-123-4567"
        icon="phone-o"
        is-link
        bind:click="callHotline"
      />
      <van-cell 
        title="小马甲义工服务" 
        value="138-0000-0000"
        icon="service-o"
        is-link
        bind:click="contactSocialWorker"
      />
      <van-cell 
        title="医院总机" 
        value="0755-83936999"
        icon="location-o"
        is-link
        bind:click="callHospital"
      />
    </van-cell-group>
  </view>

  <!-- 地址导航 -->
  <view class="location-section">
    <van-divider>义诊地址</van-divider>
    <van-cell-group custom-class="location-group">
      <van-cell 
        title="深圳市儿童医院" 
        label="广东省深圳市福田区益田路7019号"
        icon="location-o"
        is-link
        bind:click="openMap"
      />
    </van-cell-group>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />