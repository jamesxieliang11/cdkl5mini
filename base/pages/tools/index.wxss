/* pages/tools/index.wxss */

/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.tools-container {
  background: linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 页面头部 */
.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 80rpx;
  position: relative;
  overflow: hidden;
}

.header-content {
  position: relative;
  z-index: 2;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
}

.header-decoration {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 200rpx;
  height: 200rpx;
  top: -50rpx;
  right: -50rpx;
}

.circle-2 {
  width: 120rpx;
  height: 120rpx;
  top: 100rpx;
  right: 200rpx;
}

.circle-3 {
  width: 80rpx;
  height: 80rpx;
  top: 200rpx;
  right: 100rpx;
}

/* 加载状态 */
.loading-container {
  padding: 200rpx 0;
  text-align: center;
}

/* 主要内容 */
.main-content {
  padding: 0 40rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 3;
}

/* 功能卡片网格 */
.tool-cards-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.tool-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.15);
  transition: all 0.3s ease;
}

.tool-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.25);
}

.card-background {
  padding: 40rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.card-icon {
  margin-right: 24rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
}

.card-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-arrow {
  margin-left: 20rpx;
}

.card-description {
  padding: 24rpx 40rpx;
  background: white;
}

.card-description text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 区域标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-left: 12rpx;
  flex: 1;
}

.section-more {
  font-size: 26rpx;
  color: #1989fa;
  font-weight: 500;
}

/* 快速操作 */
.quick-actions {
  margin-bottom: 60rpx;
}

.quick-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-info {
  flex: 1;
}

.quick-title {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.quick-title text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-left: 8rpx;
}

.quick-status {
  margin-left: 28rpx;
}

.status-text {
  font-size: 24rpx;
  padding: 4px 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-text.pending {
  background: rgba(255, 152, 0, 0.1);
  color: #ff9800;
}

.status-text.approved {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
}

.status-text.rejected {
  background: rgba(238, 10, 36, 0.1);
  color: #ee0a24;
}

/* 专家推荐 */
.expert-section {
  margin-bottom: 60rpx;
}

.experts-scroll {
  white-space: nowrap;
}

.experts-list {
  display: flex;
  gap: 20rpx;
  padding: 0 8rpx;
}

.expert-card-mini {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 200rpx;
  transition: all 0.3s ease;
}

.expert-card-mini:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.expert-avatar-mini {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.expert-info-mini {
  text-align: center;
}

.expert-name-mini {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.expert-title-mini {
  display: block;
  font-size: 22rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.expert-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.rating-text {
  font-size: 22rpx;
  color: #ffa940;
  font-weight: 500;
}

/* 热门资料 */
.materials-section {
  margin-bottom: 60rpx;
}

.materials-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.material-card-mini {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
}

.material-card-mini:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.material-icon-mini {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffcc02 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.material-info-mini {
  flex: 1;
}

.material-title-mini {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.material-meta-mini {
  display: flex;
  gap: 20rpx;
}

.material-size,
.material-downloads {
  font-size: 22rpx;
  color: #999;
}

.material-action-mini {
  padding: 12rpx;
}

/* 服务统计 */
.stats-section {
  margin-bottom: 60rpx;
}

.stats-grid {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1989fa;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
}

/* 帮助提示 */
.help-section {
  margin-bottom: 40rpx;
}

.help-card {
  background: linear-gradient(135deg, #f8f9ff 0%, #e3f2fd 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(25, 137, 250, 0.1);
}

.help-icon {
  margin-right: 20rpx;
}

.help-content {
  flex: 1;
  margin-right: 20rpx;
}

.help-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.help-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 响应式调整 */
@media (min-width: 750rpx) {
  .tool-cards-grid {
    grid-template-columns: 1fr 1fr;
  }
  
  .stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* 动画效果 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tool-card,
.quick-card,
.expert-card-mini,
.material-card-mini,
.stats-grid,
.help-card {
  animation: fadeInUp 0.6s ease-out;
}

/* 按钮样式优化 */
.van-button--primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border: none !important;
  border-radius: 50rpx !important;
  font-weight: 600 !important;
}

.van-button--info {
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%) !important;
  border: none !important;
  border-radius: 50rpx !important;
  font-weight: 600 !important;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  display: none;
}