.status-bar {
  height: var(--status-bar-height);
  background: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-back {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-placeholder {
  width: 80rpx;
}

.page-container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 140rpx;
}

/* 帖子详情区 */
.post-detail {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.post-avatar-fallback {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.post-user-info {
  margin-left: 16rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.post-more {
  padding: 16rpx;
}

/* 话题 */
.post-topic {
  margin-bottom: 16rpx;
}

/* 帖子正文 */
.post-body {
  margin-bottom: 24rpx;
}

.post-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  word-break: break-all;
}

/* 图片展示 */
.post-images {
  margin-bottom: 24rpx;
}

.detail-image {
  width: 100%;
  max-width: 500rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  display: block;
}

.detail-image.single {
  max-width: 100%;
}

/* 数据统计 */
.post-stats {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

/* 评论区 */
.comment-section {
  background: #fff;
  padding: 30rpx;
}

.comment-header {
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 评论列表 */
.comment-list {
  /* 评论列表容器 */
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.comment-avatar-fallback {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  margin-left: 16rpx;
}

.comment-user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #ccc;
}

.comment-reply-to {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.reply-target-name {
  color: #34BFA3;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.comment-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 12rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.comment-action-count {
  font-size: 22rpx;
  color: #bbb;
}

.load-more-comments {
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #34BFA3;
}

/* 加载中 */
.loading-full {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 50vh;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  z-index: 100;
}

.input-area {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
}

.input-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

.bar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: 16rpx;
}

.bar-action {
  padding: 12rpx;
}

/* 评论输入弹窗 */
.comment-input-wrapper {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.comment-input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reply-hint {
  font-size: 24rpx;
  color: #999;
}

.comment-input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.comment-textarea {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  box-sizing: border-box;
}
