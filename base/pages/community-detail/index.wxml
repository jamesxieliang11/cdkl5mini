<!-- 状态栏区域 -->
<view class="status-bar"></view>
<view class="nav-bar">
  <view class="nav-back" bindtap="goBack">
    <van-icon name="arrow-left" size="20" color="#333" />
  </view>
  <view class="nav-title">帖子详情</view>
  <view class="nav-placeholder"></view>
</view>

<view class="page-container" wx:if="{{post}}">
  <!-- 帖子内容区 -->
  <view class="post-detail">
    <!-- 用户信息 -->
    <view class="post-header">
      <image
        wx:if="{{!post.is_anonymous && post.avatar_url}}"
        class="post-avatar"
        src="{{post.avatar_url}}"
        mode="aspectFill"
      />
      <view wx:else class="post-avatar-fallback" style="background:{{post.avatarColor}}">{{post.avatarChar}}</view>
      <view class="post-user-info">
        <text class="post-nickname">{{post.is_anonymous ? '匿名希舞宝宝' : post.nick_name}}</text>
        <text class="post-time">{{displayTime}}</text>
      </view>
      <!-- 管理员操作 -->
      <view class="post-more" wx:if="{{isOwner || isAdmin}}" catchtap="showPostActions">
        <van-icon name="ellipsis" size="20" color="#999" />
      </view>
    </view>

    <!-- 话题标签 -->
    <view class="post-topic" wx:if="{{post.topic}}">
      <van-tag plain round color="#34BFA3" size="medium"># {{post.topic.title}}</van-tag>
    </view>

    <!-- 帖子正文 -->
    <view class="post-body">
      <text class="post-text" user-select>{{post.content}}</text>
    </view>

    <!-- 图片展示 -->
    <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
      <image
        wx:for="{{post.images}}"
        wx:key="fileID"
        class="detail-image {{post.images.length === 1 ? 'single' : ''}}"
        src="{{item.fileID}}"
        mode="widthFix"
        bindtap="previewImage"
        data-current="{{item.fileID}}"
      />
    </view>

    <!-- 数据统计 -->
    <view class="post-stats">
      <text class="stat-item">{{post.view_count || 0}} 浏览</text>
      <text class="stat-item">{{post.like_count || 0}} 赞</text>
      <text class="stat-item">{{post.comment_count || 0}} 评论</text>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comment-section">
    <view class="comment-header">
      <text class="comment-title">评论 ({{post.comment_count || 0}})</text>
    </view>

    <!-- 评论列表 -->
    <view class="comment-list" wx:if="{{comments.length > 0}}">
      <view wx:for="{{comments}}" wx:key="_id" class="comment-item">
        <image wx:if="{{item.avatar_url}}" class="comment-avatar" src="{{item.avatar_url}}" mode="aspectFill" />
        <view wx:else class="comment-avatar-fallback" style="background:{{item.avatarColor}}">{{item.avatarChar}}</view>
        <view class="comment-body">
          <view class="comment-user-row">
            <text class="comment-name">{{item.nick_name}}</text>
            <text class="comment-time">{{item.displayTime}}</text>
          </view>
          <!-- 回复目标 -->
          <view class="comment-reply-to" wx:if="{{item.reply_to_name}}">
            <text>回复 </text>
            <text class="reply-target-name">{{item.reply_to_name}}</text>
          </view>
          <text class="comment-text" user-select>{{item.content}}</text>
          <view class="comment-actions">
            <view class="comment-action" catchtap="onLikeComment" data-comment-id="{{item._id}}" data-index="{{index}}">
              <van-icon name="{{item.isLiked ? 'good-job' : 'good-job-o'}}" size="14" color="{{item.isLiked ? '#34BFA3' : '#bbb'}}" />
              <text class="comment-action-count">{{item.like_count || 0}}</text>
            </view>
            <view class="comment-action" catchtap="onReplyComment" data-comment-id="{{item._id}}" data-name="{{item.nick_name}}">
              <van-icon name="comment-o" size="14" color="#bbb" />
              <text class="comment-action-count">回复</text>
            </view>
            <view class="comment-action" wx:if="{{item.user_id === currentUserId || isAdmin}}" catchtap="onDeleteComment" data-comment-id="{{item._id}}" data-index="{{index}}">
              <van-icon name="delete-o" size="14" color="#bbb" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多评论 -->
    <view class="load-more-comments" wx:if="{{hasMoreComments}}" bindtap="loadMoreComments">
      <text>加载更多评论</text>
    </view>

    <van-empty wx:if="{{comments.length === 0 && !commentLoading}}" description="暂无评论，快来说点什么吧~" image="search" />
  </view>
</view>

<!-- 加载中 -->
<view class="loading-full" wx:if="{{pageLoading}}">
  <van-loading size="24px" color="#34BFA3">加载中...</van-loading>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar" wx:if="{{post}}">
  <view class="input-area" bindtap="focusInput">
    <van-icon name="edit" size="16" color="#bbb" />
    <text class="input-placeholder">{{replyTo ? '回复 ' + replyTo.name : '写评论...'}}</text>
  </view>
  <view class="bar-actions">
    <view class="bar-action" bindtap="onLikePost">
      <van-icon name="{{post.isLiked ? 'good-job' : 'good-job-o'}}" size="22" color="{{post.isLiked ? '#34BFA3' : '#666'}}" />
    </view>
    <view class="bar-action" bindtap="onSharePost">
      <van-icon name="share-o" size="22" color="#666" />
    </view>
  </view>
</view>

<!-- 评论输入弹窗 -->
<van-popup show="{{showCommentInput}}" position="bottom" bind:close="hideCommentInput">
  <view class="comment-input-wrapper">
    <view class="comment-input-header" wx:if="{{replyTo}}">
      <text class="reply-hint">回复 {{replyTo.name}}</text>
      <view bindtap="cancelReply">
        <van-icon name="cross" size="14" color="#999" />
      </view>
    </view>
    <view class="comment-input-row">
      <textarea
        class="comment-textarea"
        placeholder="{{replyTo ? '回复 ' + replyTo.name + '...' : '写评论...'}}"
        value="{{commentContent}}"
        bindinput="onCommentInput"
        maxlength="500"
        auto-height
        focus="{{showCommentInput}}"
      />
      <van-button
        type="primary"
        size="small"
        round
        color="{{canSendComment ? '#34BFA3' : '#b5e8dc'}}"
        loading="{{commentSubmitting}}"
        bind:click="submitComment"
      >
        发送
      </van-button>
    </view>
  </view>
</van-popup>

<!-- 分享弹窗 -->
<van-action-sheet
  show="{{showShareSheet}}"
  actions="{{shareActions}}"
  cancel-text="取消"
  bind:close="hideShareSheet"
  bind:select="onShareSelect"
/>

<!-- 分享海报组件 -->
<share-poster
  wx:if="{{showPoster}}"
  post-data="{{posterData}}"
  bind:close="hidePoster"
  bind:saved="onPosterSaved"
/>
