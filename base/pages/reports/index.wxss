/* pages/reports/index.wxss — 适老化优化 */

/* AI 生成病历入口 — 适老化：更大更醒目 */
.ai-medical-record-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 30rpx;
  padding: 32rpx 32rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  border-radius: 20rpx;
  border: 2rpx solid rgba(52, 191, 163, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(52, 191, 163, 0.15);
  min-height: 96rpx;
}

.ai-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.ai-entry-icon {
  font-size: 48rpx;
}

.ai-entry-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

/* AI入口标题 — 适老化放大 */
.ai-entry-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2e7d32;
}

/* AI入口描述 — 适老化放大 */
.ai-entry-desc {
  font-size: 26rpx;
  color: #66bb6a;
}

.ai-entry-arrow {
  font-size: 48rpx;
  color: #66bb6a;
  font-weight: 300;
}

.container {
  padding: 0;
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  background: var(--gradient-primary);
  padding: 60rpx 30rpx 30rpx;
  color: white;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 页面标题 — 适老化放大 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
}

/* 返回主页按钮 */
/* 返回主页按钮 — 适老化放大 */
.home-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  padding: 16rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: white;
  font-size: 28rpx;
  line-height: 1;
  transition: all 0.3s ease;
}

.home-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.home-icon {
  font-size: 28rpx;
}

.home-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 宝宝信息卡片 */
.baby-info-card {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

/* 卡片标题 — 适老化放大 */
.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* 编辑按钮 — 适老化放大 */
.edit-btn {
  background: var(--gradient-primary);
  color: white;
  border: none;
  border-radius: var(--radius-pill);
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}

.baby-info-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
}

/* 信息标签 — 适老化放大 */
.info-label {
  font-size: 30rpx;
  color: #666;
  width: 180rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 整体概览 */
.overview-section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* 区块标题 — 适老化放大 */
.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.time-filter {
  background: white;
  border-radius: 50rpx;
  padding: 8rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 时间过滤器 — 适老化放大 */
.picker-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 概览卡片 */
.overview-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.overview-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.overview-card:active {
  transform: translateY(2rpx);
}

.card-icon {
  font-size: 48rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.overview-card.seizure .card-icon {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
}

.overview-card.medication .card-icon {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
}

.overview-card.average .card-icon {
  background: linear-gradient(135deg, #45b7d1 0%, #2980b9 100%);
}

.overview-card.other .card-icon {
  background: linear-gradient(135deg, #96ceb4 0%, #27ae60 100%);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 概览卡片数字 — 适老化：36rpx -> 48rpx */
.card-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

/* 概览卡片标签 — 适老化：24rpx -> 30rpx */
.card-label {
  font-size: 30rpx;
  color: #666;
}

/* 统计分析 */
.statistics-section {
  margin: 20rpx;
}

/* 统计类型选择 — 适老化放大 */
.stats-tabs {
  display: flex;
  background: white;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* Tab项 — 适老化：高度 72rpx，字号 30rpx */
.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 20rpx;
  font-size: 30rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.3s ease;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
}

.tab-item.active {
  background: var(--gradient-primary);
  color: white;
  font-weight: 600;
}

/* 统计内容 */
.stats-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 图表容器 */
.chart-container {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

/* 图表标题 — 适老化放大 */
.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.chart-period {
  display: flex;
  gap: 20rpx;
}

/* 图表周期选择按钮 — 适老化：放大到 100x64rpx */
.period-item {
  font-size: 28rpx;
  color: #666;
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  min-width: 100rpx;
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.period-item.active {
  background: #667eea;
  color: white;
}

/* 图表占位符 */
.chart-placeholder {
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
}

.chart-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 图表数据 */
.chart-data {
  display: flex;
  align-items: end;
  gap: 12rpx;
  height: 200rpx;
  width: 100%;
  justify-content: flex-start;
  overflow-x: auto;
  padding: 0 10rpx;
  /* 添加滚动条样式 */
  -webkit-overflow-scrolling: touch;
}

.chart-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 45rpx;
  flex-shrink: 0; /* 防止压缩 */
  height: 100%;
}

.bar {
  width: 40rpx;
  background: linear-gradient(to top, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 20rpx;
  transition: all 0.3s ease;
}

.medication-bar {
  background: linear-gradient(to top, #4ecdc4 0%, #44a08d 100%);
}

.other-bar {
  background: linear-gradient(to top, #96ceb4 0%, #27ae60 100%);
}

/* 图表底部标签 — 适老化：20rpx -> 24rpx */
.bar-label {
  font-size: 24rpx;
  color: #666;
}

.bar-value {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
}

/* 洞察容器 */
.insight-container {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 洞察标题 — 适老化放大 */
.insight-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.insight-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.insight-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.insight-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.medication-dot {
  background: #4ecdc4;
}

.other-dot {
  background: #96ceb4;
}

/* 洞察标签 — 适老化放大 */
.insight-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

.insight-value {
  font-size: 28rpx;
  color: #666;
}

/* 时间轴 */
.timeline-container {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 时间轴标题 — 适老化放大 */
.timeline-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.timeline-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 32rpx;
  width: 2rpx;
  height: calc(100% + 20rpx);
  background: #e0e0e0;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  margin-top: 8rpx;
  flex-shrink: 0;
}

.timeline-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

/* 时间轴时间 — 适老化放大 */
.timeline-time {
  font-size: 26rpx;
  color: #999;
}

.timeline-desc {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-text {
  background: white;
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
}