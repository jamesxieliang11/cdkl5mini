<!--pages/add-record/index.wxml-->
<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">📝 添加记录</text>
    <text class="page-subtitle">选择记录类型</text>
  </view>

  <!-- 记录类型选择 -->
  <view class="record-types" wx:if="{{!selectedType}}">
    <view class="type-card" bindtap="selectDrugAdjustmentType">
      <view class="type-icon">💊</view>
      <view class="type-info">
        <text class="type-title">调药记录</text>
        <text class="type-desc">记录用药调整信息</text>
      </view>
      <view class="type-arrow">→</view>
    </view>

    <view class="type-card" bindtap="selectSeizureType">
      <view class="type-icon">⚡</view>
      <view class="type-info">
        <text class="type-title">发作记录</text>
        <text class="type-desc">记录发作详细情况</text>
      </view>
      <view class="type-arrow">→</view>
    </view>

    <view class="type-card" bindtap="selectOtherType">
      <view class="type-icon">📄</view>
      <view class="type-info">
        <text class="type-title">其他记录</text>
        <text class="type-desc">记录其他相关信息</text>
      </view>
      <view class="type-arrow">→</view>
    </view>
  </view>

  <!-- 调药记录表单 -->
  <view class="form-container" wx:if="{{selectedType === 'drug_adjustment'}}">
    <view class="form-header">
      <text class="form-title">💊 调药记录</text>
      <button class="back-btn" bindtap="goBack">返回</button>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="label">记录时间 *</text>
        <input class="input" value="{{drugForm.datetime}}" bindtap="showDateTimePickerForDrug" placeholder="选择时间" />
      </view>

      <view class="form-item">
        <text class="label">体重 (kg) *</text>
        <input class="input" type="digit" value="{{drugForm.weight}}" bindinput="onWeightInput" placeholder="请输入体重" />
      </view>

      <view class="medicines-section">
        <view class="section-title">药物信息</view>
        <view class="medicine-item" wx:for="{{drugForm.medicines}}" wx:key="index">
          <view class="medicine-header">
            <text class="medicine-title">药物 {{index + 1}}</text>
            <button class="remove-btn" wx:if="{{drugForm.medicines.length > 1}}" bindtap="removeMedicine" data-index="{{index}}">删除</button>
          </view>
          
          <view class="form-item">
            <text class="label">服用时间 *</text>
            <input class="input" value="{{item.takeTime}}" bindtap="showTakeTimePicker" data-index="{{index}}" placeholder="选择服用时间" />
          </view>

          <view class="form-item">
            <text class="label">药物名称 *</text>
            <input class="input" value="{{item.name}}" bindinput="onMedicineNameInput" data-index="{{index}}" placeholder="请输入药物名称" />
          </view>

          <view class="form-row">
            <view class="form-item flex-1">
              <text class="label">剂量 *</text>
              <input class="input" type="digit" value="{{item.dosage}}" bindinput="onDosageInput" data-index="{{index}}" placeholder="剂量" />
            </view>
            <view class="form-item flex-1">
              <text class="label">单位 *</text>
              <input class="input" value="{{item.unit}}" bindinput="onUnitInput" data-index="{{index}}" placeholder="mg" />
            </view>
          </view>
        </view>

        <button class="add-medicine-btn" bindtap="addNewMedicine">+ 添加药物</button>
      </view>

      <view class="form-item">
        <text class="label">副作用</text>
        <textarea class="textarea" value="{{drugForm.sideEffects}}" bindinput="onSideEffectInput" placeholder="请描述副作用情况（可选）" />
      </view>
    </view>

    <view class="form-actions">
      <button class="save-btn" bindtap="saveRecord">保存记录</button>
    </view>
  </view>

  <!-- 发作记录表单 -->
  <view class="form-container" wx:if="{{selectedType === 'seizure'}}">
    <view class="form-header">
      <text class="form-title">⚡ 发作记录</text>
      <button class="back-btn" bindtap="goBack">返回</button>
    </view>

    <view class="template-section" wx:if="{{hasPreviousSeizures}}">
      <button class="template-btn" bindtap="useLastSeizureTemplate">使用上次记录模板</button>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="label">发作时间 *</text>
        <input class="input" value="{{seizureForm.datetime}}" bindtap="showDateTimePickerForSeizure" placeholder="选择时间" />
      </view>

      <view class="form-item">
        <text class="label">发作类型 *</text>
        <input class="input" value="{{seizureForm.type}}" bindtap="showSeizureTypePicker" placeholder="选择发作类型" />
      </view>

      <view class="form-item">
        <text class="label">持续时间 *</text>
        <input class="input" value="{{seizureForm.duration}}" bindinput="onDurationInput" placeholder="如：2分钟" />
      </view>

      <view class="form-item">
        <text class="label">诱发因素</text>
        <textarea class="textarea" value="{{seizureForm.triggers}}" bindinput="onTriggersInput" placeholder="请描述可能的诱发因素（可选）" />
      </view>

      <view class="form-item">
        <text class="label">症状描述 *</text>
        <textarea class="textarea" value="{{seizureForm.symptoms}}" bindinput="onSymptomsInput" placeholder="请详细描述发作症状" />
      </view>
    </view>

    <view class="form-actions">
      <button class="save-btn" bindtap="saveRecord">保存记录</button>
    </view>
  </view>
</view>

<!-- 自定义tabbar -->
<custom-tabbar id="tabbar" />