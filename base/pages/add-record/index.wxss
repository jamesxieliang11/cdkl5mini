/* 状态栏区域 */
.status-bar {
  height: var(--status-bar-height);
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

/* ========== 添加记录页 - 适老化样式 ========== */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
  padding-bottom: 160rpx;
}

/* 页面头部 */
.page-header {
  padding: 48rpx 40rpx 32rpx;
  background: linear-gradient(135deg, #1989fa 0%, #1976d2 100%);
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 记录类型选择卡片区域 */
.record-types {
  padding: 32rpx 30rpx;
}

.type-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx; /* 适老化：卡片间距 28rpx */
  min-height: 220rpx; /* 适老化：卡片最小高度 220rpx */
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.type-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  border-color: rgba(52, 191, 163, 0.3);
}

.type-icon {
  width: 100rpx; /* 适老化：图标区域 100rpx */
  height: 100rpx;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.type-info {
  flex: 1;
  margin-left: 28rpx;
}

.type-title {
  display: block;
  font-size: 34rpx; /* 适老化：标题 34rpx */
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.type-desc {
  display: block;
  font-size: 28rpx; /* 适老化：描述文字不低于 28rpx */
  color: #888;
  line-height: 1.5;
}

.type-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 表单容器 */
.form-container {
  padding: 0 30rpx;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.form-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.back-btn {
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 12rpx 28rpx;
  line-height: 1.5;
}

/* 表单区域 */
.form-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 30rpx; /* 适老化：标签文字 30rpx */
  color: #444;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx; /* 适老化：输入框文字 32rpx */
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 32rpx;
  color: #333;
  background: #fafafa;
  box-sizing: border-box;
}

/* 药物信息区域 */
.medicines-section {
  margin-top: 20rpx;
}

.medicines-section .section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0;
}

.medicine-item {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.medicine-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.medicine-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #555;
}

.remove-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  line-height: 1.5;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.flex-1 {
  flex: 1;
}

.add-medicine-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #34BFA3;
  background: rgba(52, 191, 163, 0.08);
  border: 2rpx dashed #34BFA3;
  border-radius: 12rpx;
  text-align: center;
  margin-top: 16rpx;
}

/* 模板按钮 */
.template-section {
  padding: 0 30rpx 16rpx;
}

.template-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  color: #1989fa;
  background: rgba(25, 137, 250, 0.08);
  border: 2rpx solid rgba(25, 137, 250, 0.3);
  border-radius: 12rpx;
  text-align: center;
}

/* 表单操作按钮 */
.form-actions {
  padding: 32rpx 30rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx; /* 适老化：保存按钮放大 */
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #34BFA3 0%, #2eaa94 100%);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(52, 191, 163, 0.3);
  text-align: center;
}