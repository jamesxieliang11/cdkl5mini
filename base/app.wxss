/* 全局样式 */

/* 统一盒模型，防止 padding 导致宽度溢出 */
view, text, image {
  box-sizing: border-box;
}

page {
  --status-bar-height: 44px;
  background-color: var(--color-bg);
  font-size: 32rpx;
  color: var(--color-text);
  line-height: 1.6;
  box-sizing: border-box;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;

  /* ===== 设计令牌 ===== */

  /* 色彩 */
  --color-primary: #34BFA3;
  --color-primary-dark: #2da88e;
  --color-primary-light: #e8f8f3;
  --color-danger: #ee4d4d;
  --color-warning: #FF9800;
  --color-success: #07c160;
  --color-text: #1a1a2e;
  --color-text-secondary: #666;
  --color-text-tertiary: #999;
  --color-border: #ebedf0;
  --color-bg: #f5f7fa;

  /* 字号 */
  --font-h1: 40rpx;
  --font-h2: 34rpx;
  --font-h3: 30rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
  --font-small: 22rpx;

  /* 间距 */
  --spacing-page: 32rpx;
  --spacing-card: 32rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-pill: 999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0,0,0,0.08);
  --shadow-xl: 0 12rpx 40rpx rgba(0,0,0,0.12);

  /* 渐变 */
  --gradient-primary: linear-gradient(135deg, #34BFA3 0%, #2da88e 100%);

  /* 适老化 - Vant 组件全局放大 */
  --button-default-height: 92rpx;
  --button-default-font-size: 32rpx;
  --button-primary-background-color: var(--color-primary);
  --button-primary-border-color: var(--color-primary);
  --field-input-text-color: var(--color-text);
  --field-label-color: #444;
  --field-font-size: 32rpx;
  --cell-font-size: 32rpx;
  --cell-line-height: 52rpx;
  --checkbox-size: 48rpx;
  --radio-size: 48rpx;
  --steps-font-size: 28rpx;
  --switch-width: 96rpx;
  --switch-height: 52rpx;
}

/* 自定义导航栏页面的通用样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 140rpx; /* 为自定义tabbar预留空间 */
}

/* 状态栏通用样式 */
.status-bar {
  height: var(--status-bar-height);
  width: 100%;
}

/* 安全区域适配 */
.safe-area-inset-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 适老化 - 全局基础样式放大 ========== */

/* 区块标题 */
.section-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 表单标签 */
.form-label {
  font-size: 30rpx;
  color: #444;
}

/* 主按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 34rpx;
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  text-align: center;
  border: none;
}

/* 次要按钮 */
.btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: var(--radius-pill);
  text-align: center;
}

/* 卡片容器 */
.card {
  padding: var(--spacing-card);
  background-color: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
}

/* 列表项间距 */
.list-item {
  padding: 24rpx 28rpx;
}

/* 元素间距辅助类 */
.gap-sm {
  margin-bottom: 20rpx;
}

.gap-md {
  margin-bottom: 24rpx;
}

/* ===== 设计系统工具类 ===== */

/* 标准卡片 */
.ds-card {
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  padding: var(--spacing-card);
}

/* 区块标题 */
.ds-section-label {
  font-size: var(--font-h2);
  font-weight: 600;
  color: var(--color-text);
  padding: 30rpx var(--spacing-page) 16rpx;
}

/* 大图标容器 (88rpx) */
.ds-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 小图标容器 (56rpx) */
.ds-icon-wrap-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 中图标容器 (64rpx) */
.ds-icon-wrap-md {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 统一页面头部 */
.ds-header {
  background: var(--gradient-primary);
  padding: 20rpx 40rpx 40rpx;
  color: #fff;
}

.ds-header-title {
  font-size: var(--font-h1);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.ds-header-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* 统一状态栏 */
.ds-status-bar {
  height: var(--status-bar-height);
  background: var(--gradient-primary);
}