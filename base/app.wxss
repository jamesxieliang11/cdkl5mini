/* 全局样式 */
page {
  --status-bar-height: 44px; /* iOS状态栏高度，Android会自动调整 */
  background-color: #f7f8fa;
}

/* 自定义导航栏页面的通用样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 140rpx; /* 为自定义tabbar预留空间 */
}

/* 状态栏通用样式 */
.status-bar {
  height: var(--status-bar-height);
  width: 100%;
}

/* 安全区域适配 */
.safe-area-inset-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}