/* 全局样式 */

/* 统一盒模型，防止 padding 导致宽度溢出 */
view, text, image {
  box-sizing: border-box;
}

page {
  --status-bar-height: 44px; /* iOS状态栏高度，Android会自动调整 */
  background-color: #f7f8fa;
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
  overflow-x: hidden; /* 防止内容水平溢出导致页面偏移 */
  width: 100%;
  max-width: 100vw;

  /* 适老化 - Vant 组件全局放大 */
  --button-default-height: 92rpx;
  --button-default-font-size: 32rpx;
  --field-input-text-color: #333;
  --field-label-color: #444;
  --field-font-size: 32rpx;
  --cell-font-size: 32rpx;
  --cell-line-height: 52rpx;
  --checkbox-size: 48rpx;
  --radio-size: 48rpx;
  --steps-font-size: 28rpx;
  --switch-width: 96rpx;
  --switch-height: 52rpx;
}

/* 自定义导航栏页面的通用样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 140rpx; /* 为自定义tabbar预留空间 */
}

/* 状态栏通用样式 */
.status-bar {
  height: var(--status-bar-height);
  width: 100%;
}

/* 安全区域适配 */
.safe-area-inset-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 适老化 - 全局基础样式放大 ========== */

/* 区块标题 */
.section-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 表单标签 */
.form-label {
  font-size: 30rpx;
  color: #444;
}

/* 主按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  font-size: 34rpx;
  background-color: #34BFA3;
  color: #fff;
  border-radius: 12rpx;
  text-align: center;
}

/* 次要按钮 */
.btn-secondary {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 12rpx;
  text-align: center;
}

/* 卡片容器 */
.card {
  padding: 28rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

/* 列表项间距 */
.list-item {
  padding: 24rpx 28rpx;
}

/* 元素间距辅助类 */
.gap-sm {
  margin-bottom: 20rpx;
}

.gap-md {
  margin-bottom: 24rpx;
}