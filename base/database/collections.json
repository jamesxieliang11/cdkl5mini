{
  "collections": [
    {
      "name": "users",
      "description": "用户基本信息集合",
      "indexes": [
        {
          "keys": { "openid": 1 },
          "options": { "unique": true }
        },
        {
          "keys": { "role": 1 }
        }
      ]
    },
    {
      "name": "favorites",
      "description": "用户收藏集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "item_id": 1, "item_type": 1 }
        },
        {
          "keys": { "user_id": 1, "item_id": 1, "item_type": 1 },
          "options": { "unique": true }
        }
      ]
    },
    {
      "name": "medication_records",
      "description": "调药记录集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "medication_name": 1 }
        },
        {
          "keys": { "record_date": -1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    },
    {
      "name": "seizure_records",
      "description": "发作记录集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "seizure_type": 1 }
        },
        {
          "keys": { "record_date": -1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    },
    {
      "name": "other_records",
      "description": "其他记录集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "record_type": 1 }
        },
        {
          "keys": { "record_date": -1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    },
    {
      "name": "record_statistics",
      "description": "记录统计集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "stat_type": 1 }
        },
        {
          "keys": { "stat_date": -1 }
        }
      ]
    },
    {
      "name": "monthly_reports",
      "description": "月度汇报记录集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "report_month": -1 }
        },
        {
          "keys": { "user_id": 1, "report_month": 1 },
          "options": { "unique": true }
        },
        {
          "keys": { "status": 1 }
        }
      ]
    },
    {
      "name": "tracked_medications",
      "description": "用户追踪药物配置集合",
      "indexes": [
        {
          "keys": { "user_id": 1 },
          "options": { "unique": true }
        }
      ]
    },
    {
      "name": "questionnaires",
      "description": "家庭基础信息问卷集合",
      "indexes": [
        {
          "keys": { "openid": 1 },
          "options": { "unique": true }
        },
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "status": 1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    },
    {
      "name": "community_posts",
      "description": "社区帖子集合",
      "indexes": [
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "topic_id": 1 }
        },
        {
          "keys": { "status": 1 }
        },
        {
          "keys": { "created_at": -1 }
        },
        {
          "keys": { "is_pinned": -1, "created_at": -1 }
        }
      ]
    },
    {
      "name": "community_comments",
      "description": "社区评论集合",
      "indexes": [
        {
          "keys": { "post_id": 1 }
        },
        {
          "keys": { "user_id": 1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    },
    {
      "name": "community_topics",
      "description": "社区话题集合",
      "indexes": [
        {
          "keys": { "status": 1 }
        },
        {
          "keys": { "sort_order": -1 }
        },
        {
          "keys": { "created_at": -1 }
        }
      ]
    }
  ]
}