<view class="container">
  <!-- 义诊信息 -->
  <view class="clinic-info">
    <view class="info-header">
      <van-icon name="hospital-o" size="24" color="#1989fa" />
      <text class="header-title">CDKL5公益义诊</text>
    </view>
    <view class="info-content">
      <view class="info-item">
        <text class="label">时间：</text>
        <text class="value">2025年1月18日 14:10-17:30</text>
      </view>
      <view class="info-item">
        <text class="label">地点：</text>
        <text class="value">深圳市儿童医院 义诊区</text>
      </view>
      <view class="info-item">
        <text class="label">费用：</text>
        <text class="value highlight">免费</text>
      </view>
    </view>
  </view>

  <!-- 科室选择 -->
  <view class="department-section">
    <view class="section-title">选择科室</view>
    <view class="department-grid">
      <view 
        class="department-card {{selectedDepartment === item.id ? 'selected' : ''}}"
        wx:for="{{departments}}" 
        wx:key="id"
        bindtap="selectDepartment"
        data-id="{{item.id}}"
      >
        <van-icon name="{{item.icon}}" size="32" color="{{selectedDepartment === item.id ? '#1989fa' : '#969799'}}" />
        <view class="dept-name">{{item.name}}</view>
        <view class="dept-doctor">{{item.doctor}}</view>
        <view class="queue-info">
          <text class="queue-count">排队：{{item.queueCount}}人</text>
          <text class="wait-time">约{{item.waitTime}}分钟</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 患儿信息 -->
  <view class="patient-form" wx:if="{{selectedDepartment}}">
    <view class="section-title">患儿信息</view>
    <van-cell-group>
      <van-field
        value="{{patientInfo.name}}"
        label="患儿姓名"
        placeholder="请输入患儿姓名"
        required
        bind:change="onNameChange"
      />
      <van-field
        value="{{patientInfo.age}}"
        label="年龄"
        placeholder="请输入年龄"
        type="number"
        required
        bind:change="onAgeChange"
      />
      <van-field
        value="{{patientInfo.gender}}"
        label="性别"
        placeholder="请选择性别"
        readonly
        is-link
        bind:click="showGenderPicker"
      />
      <van-field
        value="{{patientInfo.phone}}"
        label="联系电话"
        placeholder="请输入联系电话"
        type="number"
        required
        bind:change="onPhoneChange"
      />
      <van-field
        value="{{patientInfo.symptoms}}"
        label="主要症状"
        placeholder="请简要描述患儿症状"
        type="textarea"
        autosize
        maxlength="200"
        show-word-limit
        bind:change="onSymptomsChange"
      />
    </van-cell-group>
  </view>

  <!-- 预约须知 -->
  <view class="notice-section" wx:if="{{selectedDepartment}}">
    <view class="section-title">预约须知</view>
    <view class="notice-content">
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>请提前15分钟到达义诊现场</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>建议提前办理医保备案，便于后续治疗</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>请携带患儿既往检查资料</text>
      </view>
      <view class="notice-item">
        <van-icon name="info-o" size="16" color="#1989fa" />
        <text>如需住院可联系现场"小马甲"义工协助</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section" wx:if="{{selectedDepartment}}">
    <van-button 
      type="primary" 
      size="large" 
      bind:click="submitAppointment"
      loading="{{submitting}}"
      disabled="{{!canSubmit}}"
    >
      确认预约
    </van-button>
  </view>

  <!-- 我的预约 -->
  <view class="my-appointments" wx:if="{{appointments.length > 0}}">
    <view class="section-title">我的预约</view>
    <view class="appointment-list">
      <view class="appointment-item" wx:for="{{appointments}}" wx:key="id">
        <view class="appointment-header">
          <view class="dept-info">
            <text class="dept-name">{{item.departmentName}}</text>
            <text class="queue-number">排队号：{{item.queueNumber}}</text>
          </view>
          <view class="status-tag status-{{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="appointment-body">
          <view class="patient-name">患儿：{{item.patientName}}</view>
          <view class="appointment-time">预约时间：{{item.appointmentTime}}</view>
        </view>
        <view class="appointment-actions">
          <van-button 
            size="small" 
            type="primary" 
            bind:click="checkQueue"
            data-id="{{item.id}}"
            wx:if="{{item.status === 'waiting'}}"
          >
            查看排队
          </van-button>
          <van-button 
            size="small" 
            bind:click="cancelAppointment"
            data-id="{{item.id}}"
            wx:if="{{item.status === 'waiting'}}"
          >
            取消预约
          </van-button>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 性别选择器 -->
<van-popup show="{{showGender}}" position="bottom" bind:close="hideGenderPicker">
  <van-picker
    columns="{{genderColumns}}"
    bind:confirm="onGenderConfirm"
    bind:cancel="hideGenderPicker"
  />
</van-popup>

<van-toast id="van-toast" />
