.container {
  padding-bottom: 40rpx;
}

.clinic-info {
  background: white;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.info-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-left: 12rpx;
}

.info-content {
  padding-left: 36rpx;
}

.info-item {
  display: flex;
  margin-bottom: 12rpx;
}

.label {
  font-size: 28rpx;
  color: #969799;
  width: 100rpx;
}

.value {
  font-size: 28rpx;
  color: #323233;
  flex: 1;
}

.highlight {
  color: #07c160;
  font-weight: 600;
}

.department-section {
  margin: 40rpx 30rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 24rpx;
}

.department-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.department-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.department-card.selected {
  border-color: #1989fa;
  background: #f0f9ff;
}

.dept-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #323233;
  margin: 16rpx 0 8rpx;
}

.dept-doctor {
  font-size: 24rpx;
  color: #969799;
  margin-bottom: 16rpx;
}

.queue-info {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.queue-count {
  color: #ff976a;
}

.wait-time {
  color: #969799;
}

.patient-form {
  margin: 40rpx 30rpx 0;
}

.notice-section {
  margin: 40rpx 30rpx 0;
}

.notice-content {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.notice-item text {
  margin-left: 12rpx;
  flex: 1;
}

.submit-section {
  margin: 40rpx 30rpx;
}

.my-appointments {
  margin: 40rpx 30rpx 0;
}

.appointment-list {
  margin-top: 24rpx;
}

.appointment-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.appointment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.dept-info {
  flex: 1;
}

.dept-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  margin-bottom: 8rpx;
}

.queue-number {
  font-size: 24rpx;
  color: #1989fa;
  font-weight: 500;
}

.status-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-waiting {
  background: #fff7e6;
  color: #fa8c16;
}

.status-processing {
  background: #e6f7ff;
  color: #1890ff;
}

.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

.appointment-body {
  margin-bottom: 24rpx;
}

.patient-name {
  font-size: 28rpx;
  color: #323233;
  margin-bottom: 8rpx;
}

.appointment-time {
  font-size: 24rpx;
  color: #969799;
}

.appointment-actions {
  display: flex;
  gap: 20rpx;
}
