.container {
  padding-bottom: 40rpx;
}

.date-selector {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.current-date {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.current-date text {
  margin-left: 12rpx;
}

.schedule-timeline {
  padding: 0 30rpx;
}

.timeline-item {
  display: flex;
  margin-bottom: 40rpx;
  position: relative;
}

.timeline-time {
  width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.time-text {
  font-size: 24rpx;
  color: #969799;
  font-weight: 500;
  margin-bottom: 16rpx;
  text-align: center;
  line-height: 1.2;
}

.time-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ebedf0;
  position: relative;
}

.time-dot::after {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 60rpx;
  background: #ebedf0;
}

.timeline-item:last-child .time-dot::after {
  display: none;
}

.time-dot.completed {
  background: #07c160;
}

.time-dot.ongoing {
  background: #1989fa;
  animation: pulse 2s infinite;
}

.time-dot.upcoming {
  background: #ff976a;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(25, 137, 250, 0.7);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(25, 137, 250, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(25, 137, 250, 0);
  }
}

.timeline-content {
  flex: 1;
}

.content-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
  position: relative;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
  line-height: 1.4;
  flex: 1;
  margin-right: 20rpx;
}

.card-body {
  margin-bottom: 16rpx;
}

.speaker-info {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.speaker-name {
  font-size: 28rpx;
  color: #1989fa;
  font-weight: 500;
  margin-left: 12rpx;
}

.speaker-title {
  font-size: 24rpx;
  color: #969799;
  margin-left: 16rpx;
}

.description {
  font-size: 26rpx;
  color: #646566;
  line-height: 1.5;
}

.card-footer {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.location {
  font-size: 24rpx;
  color: #969799;
  margin-left: 8rpx;
}

.favorite-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 8rpx;
}

.bottom-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #969799;
}

.bottom-tip text {
  margin-left: 8rpx;
}

/* 弹窗样式 */
.detail-popup {
  padding: 40rpx 30rpx;
  max-height: 80vh;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  flex: 1;
}

.popup-content {
  margin-bottom: 40rpx;
}

.detail-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.label {
  font-size: 28rpx;
  color: #969799;
  width: 100rpx;
  flex-shrink: 0;
}

.value {
  font-size: 28rpx;
  color: #323233;
  flex: 1;
  line-height: 1.5;
}

.popup-actions {
  padding-top: 20rpx;
}
