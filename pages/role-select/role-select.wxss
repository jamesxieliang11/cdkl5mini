.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 80rpx;
  padding-top: 60rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.role-cards {
  margin-bottom: 60rpx;
}

.role-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.role-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.role-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  margin: 20rpx 0 16rpx;
}

.role-desc {
  font-size: 26rpx;
  color: #969799;
  margin-bottom: 24rpx;
}

.role-features {
  text-align: left;
}

.role-features text {
  display: block;
  font-size: 24rpx;
  color: #646566;
  line-height: 2;
  padding-left: 20rpx;
}

.footer {
  text-align: center;
}

.tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
