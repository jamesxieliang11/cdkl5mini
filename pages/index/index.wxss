.container {
  padding-bottom: 40rpx;
}

.quick-actions {
  margin: 20rpx 0;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.more {
  font-size: 26rpx;
  color: #1989fa;
  font-weight: normal;
}

.today-schedule {
  margin: 40rpx 0;
}

.schedule-list {
  background: white;
  border-radius: 16rpx;
  margin: 0 30rpx;
  overflow: hidden;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #ebedf0;
}

.schedule-item:last-child {
  border-bottom: none;
}

.time {
  width: 140rpx;
  font-size: 24rpx;
  color: #969799;
  font-weight: 500;
}

.content {
  flex: 1;
  margin-left: 20rpx;
}

.title {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.speaker {
  font-size: 24rpx;
  color: #969799;
}

.status {
  margin-left: 20rpx;
}

.important-tips {
  margin: 40rpx 0;
}

.tip-card {
  display: flex;
  align-items: flex-start;
  background: white;
  padding: 24rpx 30rpx;
  margin: 0 30rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 101, 102, 0.08);
}

.tip-content {
  margin-left: 20rpx;
  flex: 1;
}

.tip-title {
  font-size: 28rpx;
  color: #323233;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #646566;
  line-height: 1.5;
}

.contact-info {
  margin: 40rpx 30rpx 0;
}
